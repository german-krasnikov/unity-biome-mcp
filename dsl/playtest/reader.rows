ex "CAPTURE_FRAMES 3 INTERVAL 0.5 CAMERA \u0022Main Camera\u0022 LABEL \u0022my clip\u0022\u000aWAIT_CAPTURED \u0022my label\u0022 INCREASED\u000aSIMULATE \u0022random walk\u0022 DURATION 5\u000aTRACE_FLOW FROM /A TO /B FIELD \u0022my field\u0022" ok PT_CAPTURE_FRAMES@1:1 camera="\u0022Main Camera\u0022"@38 count="3"@16 interval="0.5"@27 label="\u0022my clip\u0022"@58 ; ok PT_WAIT_CAPTURED@2:1 label="\u0022my label\u0022"@15 mode="INCREASED"@26 ; ok PT_SIMULATE@3:1 duration="5"@33 name="\u0022random walk\u0022"@10 ; ok PT_TRACE_FLOW@4:1 field="\u0022my field\u0022"@32 from="/A"@17 to="/B"@23
ex "ASSERT_BATCH\u000aASSERT Player/Health == 100\u000aASSERT Enemy/Health > 0\u000aASSERT /My Object|C|f == 1\u000aEND\u000aASSERT_BATCH\u000a# an empty block and a comment are fine\u000aEND" ok PT_ASSERT_BATCH@1:1..5 | op="=="@22 query="Player/Health"@8 value="100"@25 | op=">"@21 query="Enemy/Health"@8 value="0"@23 | op="=="@23 query="/My Object|C|f"@8 value="1"@26 ; ok PT_ASSERT_BATCH@6:1..8
ex "ASSERT_BATCH\u000aLOG hi\u000aASSERT $x\u000aASSERT /x|C|f ==\u000aASSERT /x|C|f ~ 1\u000aEND" ok PT_ASSERT_BATCH@1:1..6 ; err PT_UNKNOWN_KEYWORD@2:1 unknown keyword LOG ; err PT_SYNTAX@3:8 ASSERT_BATCH: the line ends early ; err PT_SYNTAX@4:15 ASSERT_BATCH: the line ends early ; err PT_SYNTAX@5:17 ASSERT_BATCH: the line ends early
ex "ASSERT_BATCH extra\u000aASSERT /X|C|f == 1\u000aEND" err PT_SYNTAX@1:14 ASSERT_BATCH: unexpected \u0022extra\u0022
ex "ASSERT_BATCH\u000aASSERT /X|C|f == 1\u000aend" ok PT_ASSERT_BATCH@1:1..3 | op="=="@15 query="/X|C|f"@8 value="1"@18 ; err PT_SYNTAX@1:1 ASSERT_BATCH block is missing END ; err PT_UNKNOWN_KEYWORD@3:1 unknown keyword end
ex "SWEEP_PATH /Player DWELL 1.5\u000aSWEEP_PATH /Player DWELL 0\u000aCOMPLETE_PURCHASE /Store/Item EXPECT\u000aCOMPLETE_PURCHASE $buy_item_pipe EXPECT\u000aCOMPLETE_PURCHASE /Store/Item\u000aINVOKE_REPEAT 3 /Player PlayerController TakeDamage 10\u000aINVOKE_REPEAT 2 /Player Health TakeDamage 42 true\u000aINVOKE_REPEAT 0 $gate ClearingZoneCounter OnBoardDestroyed\u000aINVOKE_REPEAT 2 /Player \u0022My Comp\u0022 \u0022My Method\u0022" ok PT_SWEEP_PATH@1:1 dwell="1.5"@26 path="/Player"@12 ; ok PT_SWEEP_PATH@2:1 dwell="0"@26 path="/Player"@12 ; ok PT_COMPLETE_PURCHASE@3:1 path="/Store/Item"@19 +EXPECT ; ok PT_COMPLETE_PURCHASE@4:1 path="$buy_item_pipe"@19 +EXPECT ; ok PT_COMPLETE_PURCHASE@5:1 path="/Store/Item"@19 ; ok PT_INVOKE_REPEAT@6:1 args="10"@53 component="PlayerController"@25 count="3"@15 method="TakeDamage"@42 path="/Player"@17 ; ok PT_INVOKE_REPEAT@7:1 args="42 true"@43 component="Health"@25 count="2"@15 method="TakeDamage"@32 path="/Player"@17 ; ok PT_INVOKE_REPEAT@8:1 component="ClearingZoneCounter"@23 count="0"@15 method="OnBoardDestroyed"@43 path="$gate"@17 ; ok PT_INVOKE_REPEAT@9:1 component="\u0022My Comp\u0022"@25 count="2"@15 method="\u0022My Method\u0022"@35 path="/Player"@17
ex "SWEEP_PATH\u000aSWEEP_PATH /Player\u000aSWEEP_PATH /Player 0.4\u000aSWEEP_PATH /Player DWELL\u000aSWEEP_PATH /Player DWELL abc\u000aCOMPLETE_PURCHASE\u000aCOMPLETE_PURCHASE /x EXPECT now\u000aINVOKE_REPEAT\u000aINVOKE_REPEAT x /P C M\u000aINVOKE_REPEAT -1 /P C M\u000aINVOKE_REPEAT 3 /P C\u000aSWEEP_PATH /[My Obj]/X DWELL 1\u000aCOMPLETE_PURCHASE /[My Obj]/X EXPECT\u000aINVOKE_REPEAT 2 /[My Obj]/X C M" err PT_SYNTAX@1:1 SWEEP_PATH: the line ends early ; err PT_SYNTAX@2:12 SWEEP_PATH: the line ends early ; err PT_SYNTAX@3:20 SWEEP_PATH: unexpected \u00220.4\u0022 ; err PT_SYNTAX@4:20 SWEEP_PATH: the line ends early ; err PT_NUMBER@5:26 SWEEP_PATH: \u0022abc\u0022 is not a number (dwell) ; err PT_SYNTAX@6:1 COMPLETE_PURCHASE: the line ends early ; err PT_SYNTAX@7:29 COMPLETE_PURCHASE: unexpected \u0022now\u0022 ; err PT_SYNTAX@8:1 INVOKE_REPEAT: the line ends early ; err PT_COUNT@9:15 INVOKE_REPEAT: \u0022x\u0022 is not a uint (count) ; err PT_COUNT@10:15 INVOKE_REPEAT: \u0022-1\u0022 is not a uint (count) ; err PT_SYNTAX@11:20 INVOKE_REPEAT: the line ends early ; err PT_SYNTAX@12:12 SWEEP_PATH: \u0022/[My\u0022 is not like \u0022[^\u0022]*\u0022|(?!.*\u005c[[^\u005c]]*$)\u005cS+ (path) ; err PT_SYNTAX@13:19 COMPLETE_PURCHASE: \u0022/[My\u0022 is not like \u0022[^\u0022]*\u0022|(?!.*\u005c[[^\u005c]]*$)\u005cS+ (path) ; err PT_SYNTAX@14:17 INVOKE_REPEAT: \u0022/[My\u0022 is not like \u0022[^\u0022]*\u0022|(?!.*\u005c[[^\u005c]]*$)\u005cS+ (path)
