extra "MOVE Player TO 100,50,0\u000aMOVE /GridPlayer TO 1,2,3\u000aMOVE TO 1,2,3\u000aMOVE TO @/Ref.position\u000aMOVE Player TO @/Enemy.position + (5,0,0)\u000aMOVE Player TO @/Enemy.position - (0,0,3)\u000aMOVE Player TO $player_start\u000aMOVE Player TO (100,0,0)\u000aMOVE Player TO \u00221, 2, 3\u0022\u000aTELEPORT /obj 1,2,3\u000aTELEPORT /hero @/SpawnPoint.position\u000aTELEPORT Enemy @/Player.position + (2,0,0)\u000aTELEPORT TeleportTarget 5,0,3 x" ok PT_MOVE@1:1 path="Player"@6 to="100,50,0"@16 ; ok PT_MOVE@2:1 path="/GridPlayer"@6 to="1,2,3"@21 ; ok PT_MOVE@3:1 to="1,2,3"@9 ; ok PT_MOVE@4:1 to="@/Ref.position"@9 ; ok PT_MOVE@5:1 offset="+ (5,0,0)"@33 path="Player"@6 to="@/Enemy.position"@16 ; ok PT_MOVE@6:1 offset="- (0,0,3)"@33 path="Player"@6 to="@/Enemy.position"@16 ; ok PT_MOVE@7:1 path="Player"@6 to="$player_start"@16 ; ok PT_MOVE@8:1 path="Player"@6 to="(100,0,0)"@16 ; ok PT_MOVE@9:1 path="Player"@6 to="\u00221, 2, 3\u0022"@16 ; ok PT_TELEPORT@10:1 path="/obj"@10 to="1,2,3"@15 ; ok PT_TELEPORT@11:1 path="/hero"@10 to="@/SpawnPoint.position"@16 ; ok PT_TELEPORT@12:1 offset="+ (2,0,0)"@34 path="Enemy"@10 to="@/Player.position"@16 ; ok PT_TELEPORT@13:1 offset="x"@31 path="TeleportTarget"@10 to="5,0,3"@25
