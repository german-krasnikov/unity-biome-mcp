GENERATE reloadtier logic generate --source {dir}/decisions/reloadtier.logic --contract {dir}/decisions/reloadtier.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/reloadtier_logic.py"
GENERATE reloadtier-rows logic examples --source {dir}/decisions/reloadtier.examples --logic {dir}/decisions/reloadtier.logic --contract {dir}/decisions/reloadtier.contract --out {dir}/decisions/reloadtier.json
GENERATE syncerrors logic generate --source {dir}/decisions/syncerrors.logic --contract {dir}/decisions/syncerrors.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/syncerrors_logic.py"
GENERATE syncerrors-rows logic examples --source {dir}/decisions/syncerrors.examples --logic {dir}/decisions/syncerrors.logic --contract {dir}/decisions/syncerrors.contract --out {dir}/decisions/syncerrors.json
GENERATE sourcepatchblock logic generate --source {dir}/decisions/sourcepatchblock.logic --contract {dir}/decisions/sourcepatchblock.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/sourcepatchblock_logic.py"
GENERATE sourcepatchblock-rows logic examples --source {dir}/decisions/sourcepatchblock.examples --logic {dir}/decisions/sourcepatchblock.logic --contract {dir}/decisions/sourcepatchblock.contract --out {dir}/decisions/sourcepatchblock.json

CONTRACT contextwindow FROM data/contextwindow.data-contract
GENERATE py-contextwindow data --contract contextwindow --rows ContextWindowRule {dir}/data/contextwindow.core-data --target py --out {dir}/../server/src/unity_mcp/generated/context_window_rules.py
GENERATE cs-contextwindow data --contract contextwindow --rows ContextWindowRule {dir}/data/contextwindow.core-data --target cs --cs-namespace UnityMCP.Editor.Chat --out {dir}/../unity-plugin/Editor/Chat/CLI/Generated/ContextWindowRules.g.cs

# TCP transport capacity constants (Wave 1A-3): connection slot size and bind-retry
# budgets in ClientSlot.cs and MCPServer.cs. C#-only for now; Python side pending.
CONTRACT transport FROM data/transport.data-contract
GENERATE cs-transport data --contract transport --rows Transport {dir}/data/transport.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/TransportConstants.g.cs

# Blast-radius policy thresholds (Wave 1A-4): BLAST_HIGH/BLAST_DANGEROUS from
# middleware_types.py. Python-only for now; C# side pending.
CONTRACT blastpolicy FROM data/blastpolicy.data-contract
GENERATE py-blastpolicy data --contract blastpolicy --rows BlastPolicy {dir}/data/blastpolicy.core-data --target py --out {dir}/../server/src/unity_mcp/generated/blast_policy.py

# Middleware and metrics capacity limits (Wave 1A-5): cache/dedup sizes from
# middleware.py and metrics.py. Python-only for now; C# side pending.
CONTRACT limits FROM data/limits.data-contract
GENERATE py-limits data --contract limits --rows Limits {dir}/data/limits.core-data --target py --out {dir}/../server/src/unity_mcp/generated/limits_constants.py

# Field alias mapping (Wave 1D): the 12 short name → canonical key pairs that
# compressor.py and FieldProjector.cs hand-duplicate. One RECORD here replaces both.
CONTRACT fieldaliases FROM data/fieldaliases.data-contract
GENERATE py-fieldaliases data --contract fieldaliases --rows FieldAlias {dir}/data/fieldaliases.core-data --target py --out {dir}/../server/src/unity_mcp/generated/field_aliases.py
GENERATE cs-fieldaliases data --contract fieldaliases --rows FieldAlias {dir}/data/fieldaliases.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/FieldAliases.g.cs

# Strip-default values (Wave 1D): global default set and field-specific default pairs
# that compressor.py and DefaultStripper.cs hand-duplicate.
CONTRACT stripdefaults FROM data/stripdefaults.data-contract
GENERATE py-stripdefaults data --contract stripdefaults --rows StripDefault {dir}/data/stripdefaults-global.core-data --rows FieldSpecificDefault {dir}/data/stripdefaults-field.core-data --target py --out {dir}/../server/src/unity_mcp/generated/strip_defaults.py
GENERATE cs-stripdefaults data --contract stripdefaults --rows StripDefault {dir}/data/stripdefaults-global.core-data --rows FieldSpecificDefault {dir}/data/stripdefaults-field.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/StripDefaults.g.cs

# Chat event kind enum (Wave 3A): the 17 ChatEventKind C# enum values generated from one
# data contract instead of hand-maintained in ChatEvent.cs. 15 values map to UI factory
# names in events.biome; 2 (tool_args_complete, auto_reply) are internal protocol signals.
CONTRACT chateventkind FROM data/chateventkind.data-contract
GENERATE cs-chateventkind data --contract chateventkind --rows KindNote {dir}/data/chateventkind.core-data --target cs --cs-namespace UnityMCP.Editor.Chat --out {dir}/../unity-plugin/Editor/Chat/CLI/Generated/ChatEventKind.g.cs

# Error response format (Wave 3B): the "err: <message>" prefix that 121 C# sites return
# and Python checks with startswith("err:"). One ERR_PREFIX constant replaces bare literals.
CONTRACT errorformat FROM data/errorformat.data-contract
GENERATE py-errorformat data --contract errorformat --rows ErrorFormat {dir}/data/errorformat.core-data --target py --out {dir}/../server/src/unity_mcp/generated/error_format.py

# Sync state vocabulary (Wave 1E-3): the state strings SyncHelper.cs writes and
# sync_algorithm.py / sync.py read back. One ENUM replaces bare string literals.
CONTRACT syncstate FROM data/syncstate.data-contract
GENERATE py-syncstate data --contract syncstate --rows SyncStateOrigin {dir}/data/syncstate.core-data --target py --out {dir}/../server/src/unity_mcp/generated/sync_state.py
