# What unity-biome-mcp generates: the tool catalog (dsl/tools.biome printed through constructs/tool.construct), the decisions (dsl/decisions), the chat turn (dsl/chat) and the playtest grammar (constructs/playtest.construct).
TOOLCHAIN 51e6137ba6f0ce6db3056ddc9df1620edc4ac8a1
CONSTRUCTS constructs

GENERATE py-specs  render {dir}/tools.biome pyspec   {dir}/../server/src/unity_mcp/tools/generated/catalog_specs.py
GENERATE py-params render {dir}/tools.biome pyparams {dir}/../server/src/unity_mcp/tools/generated/catalog_params.py
GENERATE py-examples render {dir}/tools.biome pyexamples {dir}/../server/src/unity_mcp/tools/generated/catalog_examples.py
GENERATE py-tools  render {dir}/tools.biome pytools  {dir}/../server/src/unity_mcp/tools/generated/catalog_tools.py
GENERATE py-tags  render {dir}/tools.biome pytags  {dir}/../server/src/unity_mcp/tools/generated/catalog_tags.py
GENERATE py-blast render {dir}/tools.biome pyblast {dir}/../server/src/unity_mcp/tools/generated/catalog_blast.py
GENERATE cs-blast render {dir}/tools.biome csblast {dir}/../unity-plugin/Editor/Generated/ToolBlast.g.cs
GENERATE py-expect render {dir}/tools.biome pyexpect {dir}/../server/src/unity_mcp/tools/generated/catalog_expect.py
GENERATE docs-tools render {dir}/tools.biome mdtools {dir}/../docs/tools/index.md#catalog

# The wire records (dsl/protocol.biome, SV1/Q8): the text protocol lines between the Python server and the Unity plugin
# (`[head|]key=value|key=value`), printed once from dsl/protocol.biome instead of hand-written on each side.
GENERATE py-records render {dir}/protocol.biome pyrecord {dir}/../server/src/unity_mcp/tools/generated/wire_records.py
GENERATE cs-records render {dir}/protocol.biome csrecord {dir}/../unity-plugin/Editor/Generated/WireRecords.g.cs

# Agent events (dsl/events.biome, E1/Q9): the vocabulary of the AgentEvent protocol — one EVENT block per kind,
# instead of a Python list, a C# switch and a schema that silently drift (ecdd5736 lost 2 mappings for 12 weeks).
GENERATE event-kinds    render {dir}/events.biome pykinds  {dir}/../server/src/unity_mcp/agent_event_kinds.py
GENERATE event-emitters render {dir}/events.biome pyemits  {dir}/../server/src/unity_mcp/agent_event_emitters.py
GENERATE event-fields   render {dir}/events.biome pyfields {dir}/../server/src/unity_mcp/agent_event_fields.py
GENERATE event-order    render {dir}/events.biome pyorder  {dir}/../server/src/unity_mcp/agent_event_order.py
GENERATE event-excluded render {dir}/events.biome pyexcluded {dir}/../server/src/unity_mcp/agent_event_excluded.py
GENERATE event-held     render {dir}/events.biome csheld   {dir}/../unity-plugin/Editor/Chat/CLI/Generated/AgentEventParser.Held.g.cs
GENERATE event-reset    render {dir}/events.biome csreset  {dir}/../unity-plugin/Editor/Chat/CLI/Generated/AgentEventParser.Reset.g.cs
GENERATE event-map      render {dir}/events.biome csmap    {dir}/../unity-plugin/Editor/Chat/CLI/Generated/AgentEventParser.Map.g.cs

# The per-project MCP config file targets (dsl/data, T1/Q10): one typed row set instead of two hand-written,
# regex-parity-tested copies -- server/src/unity_mcp/config/merger.py's PROJECT_CONFIG_TARGETS tuple and
# unity-plugin/Editor/Wizard/ProjectConfigTargets.cs's ProjectConfigTarget[] All. Both sides are printed
# directly by `data generate --target cs` / `--target py` (no derive stand-in).
CONTRACT projectconfig FROM data/projectconfig.data-contract
GENERATE py-projectconfig data --contract projectconfig --rows ProjectConfigTarget {dir}/data/projectconfig.core-data --target py --out {dir}/../server/src/unity_mcp/config/generated/project_config_targets.py
GENERATE cs-projectconfig data --contract projectconfig --rows ProjectConfigTarget {dir}/data/projectconfig.core-data --target cs --cs-namespace UnityMCP.Editor.Wizard --out {dir}/../unity-plugin/Editor/Generated/ProjectConfigTargets.g.cs

# The per-client "is this client installed" directory (dsl/data/installdir.data-contract, ARC-0b, T1 rest
# step 2): one typed row set instead of clients.py's three _*_install_dir() functions and
# BackendDescriptor.cs's ConfigDir #if blocks.
CONTRACT installdir FROM data/installdir.data-contract
GENERATE py-installdir data --contract installdir --rows InstallDir {dir}/data/installdir.core-data --target py --out {dir}/../server/src/unity_mcp/config/generated/install_dir_rows.py
GENERATE cs-installdir data --contract installdir --rows InstallDir {dir}/data/installdir.core-data --target cs --cs-namespace UnityMCP.Editor.Wizard --out {dir}/../unity-plugin/Editor/Generated/InstallDir.g.cs

# The version-ref regex fragment (dsl/data/protocol.data-contract, T1 rest step 3): one grammar
# instead of merger.py's _TOML_VERSION_RE_FRAGMENT and ProjectConfigToml.cs's VersionPattern,
# kept in sync only by a parity guard test before this.
CONTRACT protocol FROM data/protocol.data-contract
GENERATE py-protocol data --contract protocol --rows Protocol {dir}/data/protocol.core-data --target py --out {dir}/../server/src/unity_mcp/generated/protocol.py
GENERATE cs-protocol data --contract protocol --rows Protocol {dir}/data/protocol.core-data --target cs --cs-namespace UnityMCP.Editor.Wizard --out {dir}/../unity-plugin/Editor/Generated/Protocol.g.cs

# Global persistent config defaults (dsl/data/globalconfig.data-contract, Task 0.2): one typed row
# instead of the 4 idle/orphan defaults hand-copied 2x in global_config.py and 3x in
# GlobalConfigSync.cs.
CONTRACT globalconfig FROM data/globalconfig.data-contract
GENERATE py-globalconfig data --contract globalconfig --rows GlobalConfigDefaults {dir}/data/globalconfig.core-data --target py --out {dir}/../server/src/unity_mcp/generated/global_config_defaults.py
GENERATE cs-globalconfig data --contract globalconfig --rows GlobalConfigDefaults {dir}/data/globalconfig.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/GlobalConfigDefaults.g.cs

# Bridge/heartbeat timing constants (dsl/data/timing.data-contract, Task 1.4): one typed
# row instead of 9 bare-float constants hand-duplicated across bridge.py,
# bridge_heartbeat.py, bridge_reload_state.py and phantom_cleaner.py.
CONTRACT timing FROM data/timing.data-contract
GENERATE py-timing data --contract timing --rows Timing {dir}/data/timing.core-data --target py --out {dir}/../server/src/unity_mcp/generated/timing_constants.py
GENERATE cs-timing data --contract timing --rows Timing {dir}/data/timing.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/TimingConstants.g.cs

# The MCP server's config-file key name (dsl/data/servername.data-contract, P1 #5): one constant
# instead of merger.py's SERVER_NAME and PermissionConfig.cs's SERVER_NAME, kept in sync only by a
# regex-scan-the-.cs-source parity guard test before this.
CONTRACT servername FROM data/servername.data-contract
GENERATE py-servername data --contract servername --rows ServerIdentity {dir}/data/servername.core-data --target py --out {dir}/../server/src/unity_mcp/generated/server_identity.py
GENERATE cs-servername data --contract servername --rows ServerIdentity {dir}/data/servername.core-data --target cs --cs-namespace UnityMCP.Editor --out {dir}/../unity-plugin/Editor/Generated/ServerIdentity.g.cs

# Global per-client MCP config-file path (dsl/data/clientconfigpath.data-contract, P1 #5): one typed
# row set instead of clients.py's _claude_desktop_path/_windsurf_path functions (plus inline literals)
# and AiToolCardFactory.cs's ClaudeCodePath/ClaudeDesktopPath/CursorPath/WindsurfPath.
CONTRACT clientconfigpath FROM data/clientconfigpath.data-contract
GENERATE py-clientconfigpath data --contract clientconfigpath --rows ClientConfigPath {dir}/data/clientconfigpath.core-data --target py --out {dir}/../server/src/unity_mcp/config/generated/client_config_path_rows.py
GENERATE cs-clientconfigpath data --contract clientconfigpath --rows ClientConfigPath {dir}/data/clientconfigpath.core-data --target cs --cs-namespace UnityMCP.Editor.Wizard --out {dir}/../unity-plugin/Editor/Generated/ClientConfigPath.g.cs

# The CLI backend table (dsl/data/backends.data-contract, UI-5/Q20): one typed row set instead of 23 switch arms spread
# across SessionHandoff, SessionScanner, ModelContextWindows and MCPChatWindow. The Python side has no call site yet;
# it is generated for cross-language parity, same as every other data contract here.
CONTRACT backends FROM data/backends.data-contract
GENERATE py-backends data --contract backends --rows Backend {dir}/data/backends.core-data --target py --out {dir}/../server/src/unity_mcp/generated/backends.py
GENERATE cs-backends data --contract backends --rows Backend {dir}/data/backends.core-data --target cs --cs-namespace UnityMCP.Editor.Chat --out {dir}/../unity-plugin/Editor/Generated/Backends.g.cs

# External tool verb map (dsl/data/toolverbs-external.data-contract, Wave 2C-3): one typed row set instead of
# the 15-entry hardcoded dict in ToolVerbMap.cs._externalMap. These are built-in Claude Code tools with no MCP prefix;
# catalog verbs (mcp__* tools, dsl/tools.biome VERB items) remain in ToolVerbs.g.cs.
CONTRACT toolverbs-external FROM data/toolverbs-external.data-contract
GENERATE py-toolverbs-external data --contract toolverbs-external --rows ExternalToolVerb {dir}/data/toolverbs-external.core-data --target py --out {dir}/../server/src/unity_mcp/generated/external_tool_verbs.py
GENERATE cs-toolverbs-external data --contract toolverbs-external --rows ExternalToolVerb {dir}/data/toolverbs-external.core-data --target cs --cs-namespace UnityMCP.Editor.Chat --out {dir}/../unity-plugin/Editor/Generated/ExternalToolVerbs.g.cs

# Built-in chip kind data (dsl/data/chipkinds.data-contract, Wave 2C-1): one typed row set instead of
# key/hexColor/defaultDepth/priority scattered across 16 provider files. The 18 built-in chip kinds
# registered by ChipKindRegistry.EnsureBuiltIns() are now the single source of truth.
CONTRACT chipkinds FROM data/chipkinds.data-contract
GENERATE py-chipkinds data --contract chipkinds --rows ChipKind {dir}/data/chipkinds.core-data --target py --out {dir}/../server/src/unity_mcp/generated/chip_kinds.py
GENERATE cs-chipkinds data --contract chipkinds --rows ChipKind {dir}/data/chipkinds.core-data --target cs --cs-namespace UnityMCP.Editor.Chat --out {dir}/../unity-plugin/Editor/Generated/ChipKinds.g.cs

# The test-run protocol vocabulary (dsl/data/testrun.data-contract, PT-9): one ENUM per word set instead of
# TestRunProtocol.cs's hand-written Lifecycle/RunOutcome/LeafOutcome/Health string-const classes and
# testing.py's _RUN_STATES/_TERMINAL_OUTCOMES literal sets.
CONTRACT testrun FROM data/testrun.data-contract
GENERATE py-testrun data --contract testrun --rows TerminalOutcome {dir}/data/testrun.core-data --target py --out {dir}/../server/src/unity_mcp/generated/testrun_enums.py
GENERATE cs-testrun data --contract testrun --rows TerminalOutcome {dir}/data/testrun.core-data --target cs --cs-namespace UnityMCP.Editor.TestRuns --out {dir}/../unity-plugin/Editor/TestRuns/TestRunEnums.g.cs

# The decisions (dsl/decisions, step 7.2): the rules of what is a write, whether a playtest passed, which guard stops a call and why a
# send is retried. A step pair per module: the generated Python (and C#) and the rows of the examples that pytest and dotnet run.
GENERATE mutability logic generate --source {dir}/decisions/mutability.logic --contract {dir}/decisions/mutability.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/mutability_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Mutability.g.cs AS UnityMCP.Editor.Decisions.Mutability LANG 9"
GENERATE mutability-rows logic examples --source {dir}/decisions/mutability.examples --logic {dir}/decisions/mutability.logic --contract {dir}/decisions/mutability.contract --out {dir}/decisions/mutability.json
GENERATE verdict logic generate --source {dir}/decisions/verdict.logic --contract {dir}/decisions/verdict.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/verdict_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Verdict.g.cs AS UnityMCP.Editor.Decisions.Verdict LANG 9"
GENERATE verdict-rows logic examples --source {dir}/decisions/verdict.examples --logic {dir}/decisions/verdict.logic --contract {dir}/decisions/verdict.contract --out {dir}/decisions/verdict.json
GENERATE guards logic generate --source {dir}/decisions/guards.logic --contract {dir}/decisions/guards.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/guards_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Guards.g.cs AS UnityMCP.Editor.Decisions.Guards LANG 9"
GENERATE guards-rows logic examples --source {dir}/decisions/guards.examples --logic {dir}/decisions/guards.logic --contract {dir}/decisions/guards.contract --out {dir}/decisions/guards.json
GENERATE permission logic generate --source {dir}/decisions/permission.logic --contract {dir}/decisions/permission.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/permission_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Permission.g.cs AS UnityMCP.Editor.Decisions.Permission LANG 9"
GENERATE permission-rows logic examples --source {dir}/decisions/permission.examples --logic {dir}/decisions/permission.logic --contract {dir}/decisions/permission.contract --out {dir}/decisions/permission.json
GENERATE versionorder logic generate --source {dir}/decisions/versionorder.logic --contract {dir}/decisions/versionorder.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/versionorder_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/VersionOrder.g.cs AS UnityMCP.Editor.Decisions.VersionOrder LANG 9"
GENERATE versionorder-rows logic examples --source {dir}/decisions/versionorder.examples --logic {dir}/decisions/versionorder.logic --contract {dir}/decisions/versionorder.contract --out {dir}/decisions/versionorder.json
GENERATE retry logic generate --source {dir}/decisions/retry.logic --contract {dir}/decisions/retry.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/retry_logic.py"
GENERATE retry-rows logic examples --source {dir}/decisions/retry.examples --logic {dir}/decisions/retry.logic --contract {dir}/decisions/retry.contract --out {dir}/decisions/retry.json
GENERATE busysignal logic generate --source {dir}/decisions/busysignal.logic --contract {dir}/decisions/busysignal.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/busysignal_logic.py"
GENERATE busysignal-rows logic examples --source {dir}/decisions/busysignal.examples --logic {dir}/decisions/busysignal.logic --contract {dir}/decisions/busysignal.contract --out {dir}/decisions/busysignal.json
GENERATE connstatus logic generate --source {dir}/decisions/connstatus.logic --contract {dir}/decisions/connstatus.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/connstatus_logic.py"
GENERATE connstatus-rows logic examples --source {dir}/decisions/connstatus.examples --logic {dir}/decisions/connstatus.logic --contract {dir}/decisions/connstatus.contract --out {dir}/decisions/connstatus.json
GENERATE budget logic generate --source {dir}/decisions/budget.logic --contract {dir}/decisions/budget.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/budget_logic.py"
GENERATE budget-rows logic examples --source {dir}/decisions/budget.examples --logic {dir}/decisions/budget.logic --contract {dir}/decisions/budget.contract --out {dir}/decisions/budget.json
