# What unity-biome-mcp generates: the tool catalog (dsl/tools.biome printed through constructs/tool.construct), the decisions (dsl/decisions) and the chat turn (dsl/chat).
TOOLCHAIN 224bf1022bc70fa3f1cb42775b358d1837c86c3b
CONSTRUCTS constructs

GENERATE py-specs  render {dir}/tools.biome pyspec   {dir}/../server/src/unity_mcp/tools/generated/catalog_specs.py
GENERATE py-params render {dir}/tools.biome pyparams {dir}/../server/src/unity_mcp/tools/generated/catalog_params.py
GENERATE py-tools  render {dir}/tools.biome pytools  {dir}/../server/src/unity_mcp/tools/generated/catalog_tools.py
GENERATE docs-tools render {dir}/tools.biome mdtools {dir}/../docs/tools/index.md#catalog

# The decisions (dsl/decisions, step 7.2): the rules of what is a write, whether a playtest passed, which guard stops a call and why a
# send is retried. A step pair per module: the generated Python (and C#) and the rows of the examples that pytest and dotnet run.
GENERATE mutability logic generate --source {dir}/decisions/mutability.logic --contract {dir}/decisions/mutability.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/mutability_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Mutability.g.cs AS UnityMCP.Editor.Decisions.Mutability LANG 9"
GENERATE mutability-rows logic examples --source {dir}/decisions/mutability.examples --logic {dir}/decisions/mutability.logic --contract {dir}/decisions/mutability.contract --out {dir}/decisions/mutability.json
GENERATE verdict logic generate --source {dir}/decisions/verdict.logic --contract {dir}/decisions/verdict.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/verdict_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Verdict.g.cs AS UnityMCP.Editor.Decisions.Verdict LANG 9"
GENERATE verdict-rows logic examples --source {dir}/decisions/verdict.examples --logic {dir}/decisions/verdict.logic --contract {dir}/decisions/verdict.contract --out {dir}/decisions/verdict.json
GENERATE guards logic generate --source {dir}/decisions/guards.logic --contract {dir}/decisions/guards.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/guards_logic.py" --target "cs {dir}/../unity-plugin/Editor/Generated/Guards.g.cs AS UnityMCP.Editor.Decisions.Guards LANG 9"
GENERATE guards-rows logic examples --source {dir}/decisions/guards.examples --logic {dir}/decisions/guards.logic --contract {dir}/decisions/guards.contract --out {dir}/decisions/guards.json
GENERATE retry logic generate --source {dir}/decisions/retry.logic --contract {dir}/decisions/retry.contract --target "py {dir}/../server/src/unity_mcp/decisions/generated/retry_logic.py"
GENERATE retry-rows logic examples --source {dir}/decisions/retry.examples --logic {dir}/decisions/retry.logic --contract {dir}/decisions/retry.contract --out {dir}/decisions/retry.json
GENERATE py-reads  render {dir}/tools.biome pyreads  {dir}/../server/src/unity_mcp/tools/generated/catalog_reads.py
GENERATE cs-reads  render {dir}/tools.biome csreads  {dir}/../unity-plugin/Editor/Generated/ActionReads.g.cs

# The chat turn (dsl/chat, step 7.3): the one ordered list of what ends a turn of the chat window, whichever way it ends. chat-policy prints the two guards
# (the decisions of the FEATURE), chat-turn the reducer into the CLI assembly of the chat (UnityMCP.Editor.Chat.CLI, namespace UnityMCP.Editor.Chat.Turn, C# 9)
# and the NUnit examples into the pure dotnet lane (unity-plugin/Tests~/ChatTurn/Generated, hidden from Unity by the `~`).
GENERATE chat-policy logic generate --source {dir}/chat/chatturn.logic --contract {dir}/chat/chatturn.contract --target "cs {dir}/../unity-plugin/Editor/Chat/CLI/Generated/ChatTurn/ChatTurn.Policy.cs AS UnityMCP.Editor.Chat.Turn LANG 9"
GENERATE chat-turn feature generate --feature {dir}/chat/chatturn.feature --uses elm --lang cs --flat --out {dir}/../unity-plugin/Editor/Chat/CLI/Generated/ChatTurn --tests-out {dir}/../unity-plugin/Tests~/ChatTurn/Generated --cs-namespace UnityMCP.Editor.Chat.Turn --cs-policy UnityMCP.Editor.Chat.Turn.Policy
