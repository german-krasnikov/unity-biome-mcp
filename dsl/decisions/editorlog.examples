  current-no-errors     | current | 0 | 0 | 0 -> buildFailedWedge
  all-stale-on-disk     | current | 3 | 0 | 0 -> staleCache
  one-unparsable        | current | 3 | 1 | 0 -> buildFailedWedge
  one-still-missing     | current | 3 | 0 | 1 -> buildFailedWedge
