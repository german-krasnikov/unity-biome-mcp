EXAMPLES failureCurrency
  id                            | logFailureOffset | logSuccessOffset -> expected
  no-failure-terminal           | -1  | 500 -> stale   # test_wedge_detection.py:112
  no-failure-no-success         | -1  | -1  -> stale   # test_wedge_detection.py:112
  failure-without-success       | 300 | -1  -> current # test_wedge_detection.py:104
  failure-after-success         | 900 | 500 -> current # test_wedge_detection.py:157 (G28)
  success-after-failure         | 300 | 900 -> stale   # test_wedge_detection.py:120
