  characterized-equal-offsets   | 400 | 400 -> stale
END

EXAMPLES logPick
  id                            | logHasPrimary | logHasPrev | logPrimaryCurrency | logPrevCurrency | logPrevNewer -> expected
  only-prev                     | false | true  | stale   | stale   | false -> prev
  only-primary                  | true  | false | stale   | stale   | true  -> primary
  only-prev-beats-only-primary  | false | true  | current | current | false -> prev
  primary-current               | true  | true  | current | stale   | false -> primary
  prev-current                  | true  | true  | stale   | current | false -> prev
  both-current-primary-wins     | true  | true  | current | current | true  -> primary
  neither-current-newer-prev    | true  | true  | stale   | stale   | true  -> prev
  neither-current-older-prev    | true  | true  | stale   | stale   | false -> primary
END

EXAMPLES wedgeKind
  id                    | logCurrency | wedgeCsErrors | wedgeUnparsable | wedgeStillMissing -> expected
