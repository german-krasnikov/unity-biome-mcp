# The tool catalog as a project construct (Plans/STEP_7_1_TOOL_CONSTRUCT_DESIGN.md of biome-dsl): TOOL = a tool that Unity handles,
# PYTOOL = one that only the Python server implements (direct_only), INTERNAL = a wire command that is no MCP tool (ToolSpec only).
# pyspec = ToolSpec kwargs, pyparams = schema descriptions,
# pytools = what the catalog expects of the Python side and, for a FORWARD tool, the MCP wrapper itself (runtime: tools/_catalog_runtime.py),
# mdtools = a row of the catalog table of docs/tools/index.md.
# pyreads / csreads = the READ actions of a tool, which isMutating asks (step 7.2): ACTION_READS of the Python side, ActionReads.IsRead of the C# side.
# A template indents its entries 4 columns deeper than its EACH/END lines, so that the dedent of the template leaves 4 for them.
SURFACE tools CODES TOOLS CONSTRUCTS TOOL, PYTOOL, INTERNAL

CONSTRUCT TOOL VERSION 1 IR 1 SCOPE project
  HEAD TOOL <name:match([a-z][a-z0-9_]*) UNIQUE> <category:enum(CORE|SCENE|COMPONENTS|ASSETS|UGUI|UITOOLKIT|MEDIA|VERIFY|RUNTIME|TESTS|SYSTEM)> <effect:enum(RO|RW|RW_IDEM|DEL)> <summary:string>
  ITEM GUARD <flag:enum(always|compile|play_ok)>
  ITEM WIRE <flag:enum(special|not_batch|no_undo)>
  ITEM FORWARD
  ITEM FLAG <flag:enum(core|tier1|direct_only|unity_transport)>
  ITEM RUNTIME
  ITEM TAG <tag:enum(async_full|atomic_scene|distill_skip|do_allowed|do_forbidden|meta_cmd|playtest_scenario|read_cacheable|reflect_noerror|reflect_silent|retry_safe_internal|scene_state_neutral|schema_keep_full|strip_defaults) UNIQUE>
  ITEM BLAST <blast:match([0-9]+)>
  ITEM SESSION
  ITEM TIMEOUT <seconds:match([0-9]+\.[0-9]+)>
  ITEM MAXCHARS <maxchars:match([0-9]+)>
  ITEM DOC <line:string>
  ITEM READ <action:match([a-z][a-z0-9_]*) UNIQUE>
  ITEM ARG <aname:match([A-Za-z][A-Za-z0-9_]*) UNIQUE> <atype:enum(str|ostr|int|oint|float|ofloat|bool|obool|Any)> [DEFAULT <default:match([A-Za-z0-9_.+-]+)> [<omit:enum(OMIT)>]] [DEFAULT_TEXT <dtext:string> [<omit2:enum(OMIT)>]] [<raw:enum(RAW)>] [<local:enum(LOCAL)>] [WIRE <wname:string>] [<adesc:string>]
  ITEM VERB <vtext:string>
  EXAMPLES tool.examples
  DECLARE
  ENSURE (COUNT ARG WHERE it.has_local AND it.has_wname) == 0 ELSE "ARG may not set both LOCAL and WIRE"
  ENSURE (COUNT ARG WHERE it.has_default AND it.has_dtext) == 0 ELSE "ARG may not set both DEFAULT and DEFAULT_TEXT"
  TEMPLATE pyspec HEADER "SPEC_KWARGS: dict[str, dict] = {" FOOTER "}" ESCAPE data
        '{name}': {
            'category': '{category}',
            'effect': '{effect}',
    EACH FLAG
            '{flag}': True,
    END
    IF ANY RUNTIME
            'runtime_only': True,
    END
    IF ANY SESSION
            'session': True,
    END
    EACH TIMEOUT
            'timeout_s': {seconds},
    END
    EACH MAXCHARS
            'max_chars': {maxchars},
    END
        },
  END
  TEMPLATE pyparams HEADER "PARAM_DESCRIPTIONS: dict[str, dict[str, str]] = {" FOOTER "}" ESCAPE data
        '{name}': {
    EACH ARG
            {?adesc:'{aname}': "{adesc}",}
    END
        },
  END
  TEMPLATE pytools HEADER "from .. import _catalog_runtime as rt\nfrom .._common import bind\n\nAny = rt.ANY\nostr = str | None\noint = int | None\nofloat = float | None\nobool = bool | None\n\n_send = None\n_args = None\ntools = rt.ToolSet()\n\n\ndef register(mcp, send, args):\n    bind(globals(), send, args)\n    tools.install(mcp)\n\n" ESCAPE data
    tools.expect('{name}', '{effect}', "{summary}", (
    EACH ARG
        ('{aname}', {atype}{?default:, {default}}{?dtext:, "{dtext}"}),
    END
    IF ANY SESSION
    )
    , session=True)
    ELSE
    ))
    END
    IF ANY FORWARD


    @tools.provide
    async def {name}(
    EACH ARG
        {aname}: {atype}{?default:  = {default}}{?dtext:  = "{dtext}"},
    END
    ) -> str:
        ("{summary}"
    EACH DOC
         "\n    {line}"
    END
        )
        return await _send('{name}', _args(
    EACH ARG
            {aname}=rt.w_{atype}({aname}{?omit:, {default}}{?omit2:, "{dtext}"}{?raw:, raw=True}),
    END
        ))


    END
  END
  TEMPLATE pyreads HEADER "ACTION_READS: dict[str, frozenset[str]] = {" FOOTER "}" ESCAPE data
    IF ANY READ
        '{name}': frozenset({
    EACH READ
            '{action}',
    END
        }),
    END
  END
  TEMPLATE csreads HEADER "namespace UnityMCP.Editor\n{\n    // The actions of a command that only read (the READ lines of dsl/tools.biome): what CommandRegistry.IsMutating asks. A command that is\n    // not here, or an action that is not listed (or is spelt in another case), is a write.\n    internal static class ActionReads\n    {\n        internal static bool IsRead(string cmd, string action)\n        {\n            switch (cmd)\n            {" FOOTER "                default:\n                    return false;\n            }\n        }\n    }\n}" ESCAPE data
    IF ANY READ
                    case "{name}":
                        switch (action)
                        {
    EACH READ
                            case "{action}":
    END
                                return true;
                            default:
                                return false;
                        }
    END
  END
  TEMPLATE cstools HEADER "namespace UnityMCP.Editor\n{\n    // CommandOptions for every TOOL/INTERNAL of dsl/tools.biome that this construct can state: Mutating\n    // (effect != RO), Runtime, Required/Optional (from ARG), MaxResponseChars (from MAXCHARS), and the GUARD/WIRE flags.\n    // Description, FileHandler and MutatingArgsPolicy are not data here: a caller sets one on the returned struct (a mutable\n    // struct) after Get. kind (Register/RegisterAction/RegisterAsync) is a call-site choice, not data here either.\n    internal static class ToolMeta\n    {\n        internal static CommandOptions Get(string cmd)\n        {\n            switch (cmd)\n            {" FOOTER "                default:\n                    throw new System.ArgumentException($\"ToolMeta.Get: no entry for '{cmd}'\");\n            }\n        }\n    }\n}" ESCAPE data
                    case "{name}":
                        return new CommandOptions
                        {
                            Mutating = {?effect=RO:false}{!effect=RO:true},
    IF ANY RUNTIME
                            Runtime = true,
    END
                            Required = string.Join(",", new string[] {
    EACH ARG WHERE NOT default AND NOT dtext AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
                            }),
                            Optional = string.Join(",", new string[] {
    EACH ARG WHERE default AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
    EACH ARG WHERE dtext AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
                            }),
    EACH MAXCHARS
                            MaxResponseChars = {maxchars},
    END
    EACH GUARD
    {?flag=always:                        AlwaysAllowed = true,}
    {?flag=compile:                        AllowedDuringCompile = true,}
    {?flag=play_ok:                        PlayOk = true,}
    END
    EACH WIRE
    {?flag=special:                        SpecialDispatch = true,}
    {?flag=not_batch:                        NotBatchable = true,}
    {?flag=no_undo:                        NoUndo = true,}
    END
                        };
  END
  TEMPLATE mdtools HEADER "| Tool | Plane | Category | Effect |\n|---|---|---|---|" ESCAPE md
    | `{name}` | unity | {category} | {effect} |
  END
  TEMPLATE csverbs HEADER "namespace UnityMCP.Editor.Chat\n{\n    // The human verb of a tool in the chat UI (VERB lines of dsl/tools.biome); a tool without one falls back to its name.\n    internal static class ToolVerbs\n    {\n        internal static readonly (string Tool, string Verb)[] Rows =\n        {" FOOTER "        };\n    }\n}" ESCAPE data
    EACH VERB
            ("{name}", "{vtext}"),
    END
  END
  TEMPLATE pytags HEADER "TAG_PAIRS: tuple[tuple[str, str], ...] = (" FOOTER ")" ESCAPE data
    EACH TAG
        ('{tag}', '{name}'),
    END
  END
  TEMPLATE pyblast HEADER "BLAST_RADIUS: dict[str, int] = {" FOOTER "}" ESCAPE data
    EACH BLAST
        '{name}': {blast},
    END
  END
END

CONSTRUCT PYTOOL VERSION 1 IR 1 SCOPE project
  HEAD PYTOOL <name:match([a-z][a-z0-9_]*) UNIQUE> <category:enum(CORE|SCENE|COMPONENTS|ASSETS|UGUI|UITOOLKIT|MEDIA|VERIFY|RUNTIME|TESTS|SYSTEM)> <effect:enum(RO|RW|RW_IDEM|DEL)> <summary:string>
  ITEM FLAG <flag:enum(core|tier1)>
  ITEM RUNTIME
  ITEM TAG <tag:enum(async_full|atomic_scene|distill_skip|do_allowed|do_forbidden|meta_cmd|playtest_scenario|read_cacheable|reflect_noerror|reflect_silent|retry_safe_internal|scene_state_neutral|schema_keep_full|strip_defaults) UNIQUE>
  ITEM BLAST <blast:match([0-9]+)>
  ITEM SESSION
  ITEM TIMEOUT <seconds:match([0-9]+\.[0-9]+)>
  ITEM READ <action:match([a-z][a-z0-9_]*) UNIQUE>
  ITEM ARG <aname:match([A-Za-z][A-Za-z0-9_]*) UNIQUE> <atype:enum(str|ostr|int|oint|float|ofloat|bool|obool|Any)> [DEFAULT <default:match([A-Za-z0-9_.+-]+)>] [DEFAULT_TEXT <dtext:string>] [<adesc:string>]
  ITEM VERB <vtext:string>
  EXAMPLES tool.examples
  DECLARE
  TEMPLATE pyspec ESCAPE data
        '{name}': {
            'category': '{category}',
            'effect': '{effect}',
            'direct_only': True,
    EACH FLAG
            '{flag}': True,
    END
    IF ANY RUNTIME
            'runtime_only': True,
    END
    IF ANY SESSION
            'session': True,
    END
    EACH TIMEOUT
            'timeout_s': {seconds},
    END
        },
  END
  TEMPLATE pyparams ESCAPE data
        '{name}': {
    EACH ARG
            {?adesc:'{aname}': "{adesc}",}
    END
        },
  END
  TEMPLATE pytools ESCAPE data
    tools.expect('{name}', '{effect}', "{summary}", (
    EACH ARG
        ('{aname}', {atype}{?default:, {default}}{?dtext:, "{dtext}"}),
    END
    IF ANY SESSION
    )
    , session=True)
    ELSE
    ))
    END
  END
  TEMPLATE pyreads ESCAPE data
    IF ANY READ
        '{name}': frozenset({
    EACH READ
            '{action}',
    END
        }),
    END
  END
  TEMPLATE csreads ESCAPE data
    IF ANY READ
                    case "{name}":
                        switch (action)
                        {
    EACH READ
                            case "{action}":
    END
                                return true;
                            default:
                                return false;
                        }
    END
  END
  TEMPLATE mdtools ESCAPE md
    | `{name}` | python | {category} | {effect} |
  END
  TEMPLATE csverbs ESCAPE data
    EACH VERB
            ("{name}", "{vtext}"),
    END
  END
  TEMPLATE pytags ESCAPE data
    EACH TAG
        ('{tag}', '{name}'),
    END
  END
  TEMPLATE pyblast ESCAPE data
    EACH BLAST
        '{name}': {blast},
    END
  END
END

CONSTRUCT INTERNAL VERSION 1 IR 1 SCOPE project
  HEAD INTERNAL <name:match([a-z][a-z0-9_]*) UNIQUE> <effect:enum(RO|RW)> <summary:string>
  ITEM GUARD <flag:enum(always|compile|play_ok)>
  ITEM WIRE <flag:enum(special|not_batch|no_undo)>
  ITEM FLAG <flag:enum(direct_only|unity_transport)>
  ITEM TAG <tag:enum(async_full|atomic_scene|distill_skip|do_allowed|do_forbidden|meta_cmd|playtest_scenario|read_cacheable|reflect_noerror|reflect_silent|retry_safe_internal|scene_state_neutral|schema_keep_full|strip_defaults) UNIQUE>
  ITEM BLAST <blast:match([0-9]+)>
  ITEM TIMEOUT <seconds:match([0-9]+\.[0-9]+)>
  ITEM ARG <aname:match([A-Za-z][A-Za-z0-9_]*) UNIQUE> <atype:enum(str|ostr|int|oint|float|ofloat|bool|obool|Any)> [DEFAULT <default:match([A-Za-z0-9_.+-]+)> [<omit:enum(OMIT)>]] [DEFAULT_TEXT <dtext:string> [<omit2:enum(OMIT)>]] [<raw:enum(RAW)>] [<local:enum(LOCAL)>] [WIRE <wname:string>] [<adesc:string>]
  EXAMPLES tool.examples
  DECLARE
  ENSURE (COUNT ARG WHERE it.has_local AND it.has_wname) == 0 ELSE "ARG may not set both LOCAL and WIRE"
  ENSURE (COUNT ARG WHERE it.has_default AND it.has_dtext) == 0 ELSE "ARG may not set both DEFAULT and DEFAULT_TEXT"
  TEMPLATE pyspec ESCAPE data
        '{name}': {
            'category': '_INTERNAL',
            'effect': '{effect}',
    EACH FLAG
            '{flag}': True,
    END
    EACH TIMEOUT
            'timeout_s': {seconds},
    END
        },
  END
  TEMPLATE cstools ESCAPE data
                    case "{name}":
                        return new CommandOptions
                        {
                            Mutating = {?effect=RO:false}{!effect=RO:true},
                            Required = string.Join(",", new string[] {
    EACH ARG WHERE NOT default AND NOT dtext AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
                            }),
                            Optional = string.Join(",", new string[] {
    EACH ARG WHERE default AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
    EACH ARG WHERE dtext AND NOT local
                                "{?wname:{wname}}{!wname:{aname}}",
    END
                            }),
    EACH GUARD
    {?flag=always:                        AlwaysAllowed = true,}
    {?flag=compile:                        AllowedDuringCompile = true,}
    {?flag=play_ok:                        PlayOk = true,}
    END
    EACH WIRE
    {?flag=special:                        SpecialDispatch = true,}
    {?flag=not_batch:                        NotBatchable = true,}
    {?flag=no_undo:                        NoUndo = true,}
    END
                        };
  END
  TEMPLATE pytags ESCAPE data
    EACH TAG
        ('{tag}', '{name}'),
    END
  END
  TEMPLATE pyblast ESCAPE data
    EACH BLAST
        '{name}': {blast},
    END
  END
END
