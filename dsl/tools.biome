TOOL get_component CORE RO "Component properties as key-value. For MULTIPLE objects, use inspect(paths='a,b,c') instead — 1 call vs N."
  BODY objects
  DOC "fields: comma-separated field names to keep (e.g. 'mass,position') — projects the result to save tokens; shows requested fields even at default values. Aliases: position, rotation, scale, mass, enabled, active, name."
  DOC "full=True: bypass distillation, return raw response. compress=True: strip default values before transfer."
  DOC "component: alias for type= (backward-compat with set_property naming). type= wins when both provided."
  FLAG core
  VERB "Reading component"
  ARG path str EXAMPLE "/__seam_nonexistent" "Scene path to the GameObject (e.g. /Player or /World/Enemy)"
  ARG type str DEFAULT_TEXT "" EXAMPLE "Transform" "Component type name (e.g. 'Transform', 'Rigidbody', 'MeshRenderer')"
  ARG fields ostr DEFAULT None "Comma-separated fields to return (e.g. 'mass,localPosition') — skips all others, saves tokens"
  ARG full bool DEFAULT False LOCAL "Return raw uncompressed response (bypass distillation)"
  ARG compress bool DEFAULT False "Strip fields at their default value before TCP transfer — reduces response size"
  ARG component ostr DEFAULT None LOCAL
  TAG async_full
  TAG read_cacheable
  TAG strip_defaults
  BLAST 0
END

TOOL get_components_list SCENE RO "List all components on object by instance ID."
  HANDLER register "CommandRouter.ExecGetComponentsList"
  FORWARD
  VERB "Reading components"
  ARG id int RAW EXAMPLE "999999999"
  TAG read_cacheable
END

TOOL get_console CORE RO "Recent console logs. For C# compile errors use get_compile_errors instead. keyword: case-insensitive substring filter. count_only: return N matches as string. since: only logs from last N seconds."
  HANDLER register "CommandRouter.ExecGetConsole"
  GUARD compile
  FORWARD
  FLAG core
  TIMEOUT 10.0
  MAXCHARS 20000
  VERB "Reading console"
  ARG count int DEFAULT 10 RAW "Max log entries to return (default 10)"
  ARG level ostr DEFAULT None "Filter by level: log|warning|error|exception|assert (omit = all)"
  ARG first int DEFAULT 0 OMIT RAW "Skip the first N entries (pagination offset)"
  ARG keyword ostr DEFAULT None
  ARG count_only bool DEFAULT False OMIT
  ARG since ofloat DEFAULT None RAW
END

PYTOOL get_console_since RUNTIME RO "Console entries after the watermark created by console_mark()."
  BODY console
  DOC "mark_id: string from console_mark() or bare float timestamp."
  DOC "level: optional filter ('error,exception,assert')."
  DOC "keyword: case-insensitive substring filter."
  DOC "count_only: return match count as string."
  DOC "count: max entries to return (default 500)."
  FLAG tier1
  ARG mark_id str
  ARG level ostr DEFAULT None
  ARG count int DEFAULT 500
  ARG keyword ostr DEFAULT None
  ARG count_only bool DEFAULT False
END

TOOL get_enabled_tools SYSTEM RO "List enabled tool names, comma-separated."
  HANDLER register "CommandRouter.ExecGetEnabledToolsCommand"
  GUARD always
  GUARD compile
  FORWARD
