TOOL set_parent SCENE RW_IDEM "Reparent existing GameObject. parent=null → move to scene root. world_position_stays=True (default): preserves world transform. False: stays local to new parent."
  HANDLER register "CommandRouter.ExecSetParent"
  CARD generic
  NEXT "get_hierarchy depth=1"
  FORWARD
  FLAG tier1
  VERB "Re-parenting"
  ARG path str EXAMPLE "/__seam_nonexistent" "Scene path of the GameObject to reparent"
  ARG parent ostr DEFAULT None EXAMPLE "/" "New parent scene path (omit or null = move to scene root)"
  ARG world_position_stays bool DEFAULT True OMIT "True (default) = preserve world transform; False = keep local transform relative to new parent"
  TAG atomic_scene
  TAG reflect_custom
END

PYTOOL set_properties SCENE RW "Set multiple properties on ONE object. For multiple objects, use configure_objects instead."
  BODY autobatch
  DOC "Format: component.prop=value per line or semicolon-separated."
  DOC "Example: Transform.m_LocalPosition=(1,0,0);Rigidbody.mass=5"
  ARG path str
  ARG props str
  TAG reflect_silent
END

TOOL set_property CORE RW_IDEM "Set component property (Edit Mode, SerializedObject — for Play Mode use `invoke_method` or `execute_code`)."
  CARD set
  NEXT "get_console level=Error"
  BODY objects
  DOC "find_type: component type — bulk-sets prop on all matching objects without specifying paths."
  DOC "For GO rename use rename_object(). ObjectReference: scene path (/Player), asset path (Assets/X.mat), sub-asset (Assets/X.fbx::ClipName), &ref (e.g. &1) or $hexId (legacy), #instanceID (legacy), or 'null'. dry_run=True shows what would change without applying."
  DOC "ref_component_type: when value is a plain scene path and the field expects a specific Component type (e.g. 'BoxCollider'), appends '::TypeName' to the value so C# resolves the correct component. Ignored when value already contains '::'."
  DOC "effects: mutates scene via SerializedObject, creates an undo entry. Verify with get_component after."
  FLAG core
  VERB "Editing"
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent" ROLE target "Scene path to the GameObject (e.g. /Player/Body)"
  ARG component str DEFAULT_TEXT "" EXAMPLE "Transform" "Component type (empty string = Transform)"
  ARG prop str DEFAULT_TEXT "" EXAMPLE "m_LocalPosition" ROLE prop "Property name as shown in Inspector (e.g. 'mass', 'localPosition.x')"
  ARG value Any DEFAULT None EXAMPLE "0,0,0" ROLE value "New value. ObjectReference: scene path (/Player), asset path (Assets/X.mat), sub-asset (Assets/X.fbx::ClipName), &ref (e.g. &1) or $hexId (legacy), #instanceID (legacy), or 'null'"
  ARG dry_run bool DEFAULT False "Show what would change without applying (safe preview)"
  ARG find_type ostr DEFAULT None "Component type — bulk-sets prop on ALL scene objects with this component (no path needed)"
  ARG ref_component_type ostr DEFAULT None LOCAL
  TAG atomic_scene
  TAG distill_skip
  TAG do_allowed
  TAG reflect_custom
  BLAST 1
END

TOOL set_property_delta SCENE RW "Apply delta to numeric property. delta: +5, -0.5, (+1,2,0). Returns: old → new."
  HANDLER register "CommandRouter.ExecSetPropertyDelta"
  CARD set
  FORWARD
  ARG path str EXAMPLE "/__seam_nonexistent" ROLE target
  ARG component str EXAMPLE "Transform"
  ARG prop str EXAMPLE "m_LocalPosition.x" ROLE prop
  ARG delta str EXAMPLE "1" ROLE value
  TAG atomic_scene
  TAG reflect_custom
END

TOOL set_rect UGUI RW_IDEM "Set RectTransform. anchor: stretch|center|top-left|top-right|bottom-left|bottom-right|etc. pos/size: (x,y). pos3: (x,y,z) sets anchoredPosition3D — use for WorldSpace canvases (wins over pos if both given)."
  HANDLER register "CommandRouter.ExecSetRect"
  FORWARD
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG anchor ostr DEFAULT None
  ARG pos ostr DEFAULT None
  ARG size ostr DEFAULT None
  ARG pivot ostr DEFAULT None
  ARG offset_min ostr DEFAULT None
  ARG offset_max ostr DEFAULT None
  ARG pos3 ostr DEFAULT None
  TAG atomic_scene
  TAG reflect_noerror
END

TOOL set_sibling_index SCENE RW "Set sibling index of a GameObject within its parent. index=0 moves to first child."
  HANDLER register "CommandRouter.ExecSetSiblingIndex"
  FORWARD
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG index int EXAMPLE "0"
  TAG atomic_scene
  TAG reflect_custom
END

PYTOOL setup_objects SCENE RW "Create+configure multiple objects in one call."
  BODY autobatch
  DOC "One per line: name [primitive=X] [parent=Y] [pos=(x,y,z)] [components=A,B]"
  DOC "Example: NPC1 primitive=Capsule pos=(1,0,0) components=Health"
  ARG specs str
  TAG reflect_silent
END

TOOL shader ASSETS RW "Read or write shader assets (.shader / .shadergraph). Creates or modifies shader assets. No confirmation required. Use when you need to inspect shader properties, create a new shader from a preset or raw HLSL, change a shader property/keyword, or build/edit a Shader Graph node network."
  FORWARD
  ACTION get
  ACTION create
  ACTION set
  ACTION graph_get
  ACTION graph_create
  ACTION graph_node
  ACTION graph_edge
  ACTION graph_add_property
  ACTION graph_remove_property
  ACTION graph_rename_property
  ACTION graph_get_layout
  ACTION graph_set_layout
  ACTION graph_auto_layout
  DOC "action: get (inspect path — shader name, properties, keywords) | create (new shader; preset=unlit|lit|transparent or code=HLSL string) | set (change prop+value or keyword+enabled on existing shader) | graph_get (read Shader Graph nodes/edges) | graph_create (new .shadergraph) | graph_node (add/remove/configure a node; node_type, node_id, node_action) | graph_edge (connect/disconnect slots; output_node/output_slot, input_node/input_slot, edge_action) | graph_add_property|graph_remove_property|graph_rename_property | graph_get_layout (read node positions as compact text) | graph_set_layout (apply positions from layout text; layout=[id] x,y WxH lines) | graph_auto_layout (auto-arrange nodes by data-flow; h_gap, v_gap optional)."
  DOC "For material shader assignment use `material` tool instead."
  ARG action str
  ARG path str EXAMPLE "/__seam_nonexistent" "Project asset path to a .shader or .shadergraph file"
  ARG target ostr DEFAULT None
  ARG preset ostr DEFAULT None
  ARG code ostr DEFAULT None
  ARG shader_name ostr DEFAULT None "Shader declaration name used when creating shader source"
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG keyword ostr DEFAULT None
  ARG enabled ostr DEFAULT None
  ARG node_type ostr DEFAULT None
  ARG node_id ostr DEFAULT None
  ARG node_action ostr DEFAULT None
  ARG output_node ostr DEFAULT None
  ARG output_slot oint DEFAULT None RAW
  ARG input_node ostr DEFAULT None
  ARG input_slot oint DEFAULT None RAW
  ARG edge_action ostr DEFAULT None
  ARG name ostr DEFAULT None "Action-specific Shader Graph property/node name (not a GameObject name)"
  ARG type ostr DEFAULT None "Action-specific Shader Graph property value type (not a component type)"
  ARG default_value ostr DEFAULT None
  ARG reference_name ostr DEFAULT None
  ARG new_name ostr DEFAULT None
  ARG layout ostr DEFAULT None
  ARG h_gap ofloat DEFAULT None RAW
  ARG v_gap ofloat DEFAULT None RAW
  READ get
  READ graph_get
  TAG reflect_noerror
END

PYTOOL smart_build SYSTEM RW "Build scene objects from natural language description using MCP sampling + execute_code."
  DENY
  ARG description str
  ARG ctx Any
  TAG reflect_silent
END

PYTOOL snapshot RUNTIME RO "Capture or compare object state."
  ARG path str
  ARG label str DEFAULT_TEXT "default"
  ARG compare str DEFAULT_TEXT ""
END

# P0-50: internal, direct-only, unity_transport — routed only by asset.py's
# own internal sender when Source Patch mutation is armed; never a public
# MCP tool, never batchable (see server/tests/test_source_patch_boundary.py).
INTERNAL source_patch_write RW "Writes a source patch; the internal sender of asset.py routes it when Source Patch mutation is armed."
  DENY
  FLAG direct_only
  FLAG unity_transport
  ARG path str
  ARG content str
  TAG reflect_silent
END

TOOL spatial_query SCENE RO "Spatial queries. action: nearest|in_front_of|objects_in_radius|bounds_info|raycast|spatial_map|objects_in_polygon."
  HANDLER register "CommandRouter.ExecSpatialQuery"
  BODY spatial
  DOC "nearest: find closest object (optionally filtered by component name)."
  DOC "in_front_of: position in front of object at distance."
  DOC "objects_in_radius: list all objects within radius. path is optional when center='x,y,z' is given."
  DOC "bounds_info: detailed bounds/dimensions of object."
  DOC "raycast: cast ray from path/pos to target, returns hits sorted by distance."
  DOC "spatial_map: ASCII grid map of objects in XZ plane. cell_size in meters."
  DOC "objects_in_polygon: objects whose XZ pivot is inside a polygon. Provide either"
  DOC "vertices='x1,z1;x2,z2;...' (>=3 pairs) or a previously defined region_id;"
  DOC "supplied vertices are always validated. cap=max results (default 50)."
  ARG action str
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
  ARG target ostr DEFAULT None
  ARG distance ofloat DEFAULT None
  ARG radius ofloat DEFAULT None
  ARG component ostr DEFAULT None
  ARG cell_size ofloat DEFAULT None
  ARG layer_mask ostr DEFAULT None
  ARG center ostr DEFAULT None
  ARG vertices ostr DEFAULT None
  ARG region_id ostr DEFAULT None
  ARG cap oint DEFAULT None
END

# E02: Wave E non-blocking playtest dispatch — internal wire command, no @mcp.tool()
# until E04. Same shape as source_patch_write above.
INTERNAL start_playtest RW "Starts a playtest without blocking; get_playtest_run polls it."
  GUARD play_ok
  FLAG direct_only
  FLAG unity_transport
  ARG script ostr DEFAULT None "Inline DSL script (mutually exclusive with path)"
  ARG timeout float DEFAULT 120.0 "Max seconds to wait for the playtest to finish (default 120)"
  ARG abort_on_fail bool DEFAULT False "Stop after the first failed step or automatic console failure; remaining steps, including teardown, are skipped"
  ARG defs ostr DEFAULT None "Inline VAL definitions prepended to script (alias block)"
  ARG path ostr DEFAULT None "Path to .playtest DSL file on disk (mutually exclusive with script)"
  ARG snapshot_on_failure bool DEFAULT False "Auto-capture screenshot on first ASSERT failure"
  ARG fresh bool DEFAULT False "Stop and restart Play Mode before running the script"
  ARG before_hook ostr DEFAULT None "DSL commands to run before entering Play Mode"
  ARG after_hook ostr DEFAULT None "DSL commands to run after Play Mode exits"
  ARG format str DEFAULT_TEXT "text"
  TAG playtest_scenario
  TAG reflect_silent
  TAG scene_state_neutral
END

TOOL sync_playtest_aliases_from_defs TESTS RW "Overwrite PlaytestConfig.asset aliases from a .defs text file."
  HANDLER register "CommandRouter.ExecSyncFromDefs"
  GUARD play_ok
  WIRE no_undo
  FORWARD
  DOC "defs: project-relative path to .defs file (default: Assets/PlaytestDefs/farm_core.defs)."
  DOC "asset: asset path to PlaytestConfig (default: Assets/Configs/PlaytestConfig.asset)."
  DOC "Invalidates AliasExpander cache after sync. Not allowed in Play Mode."
  ARG defs str DEFAULT_TEXT "Assets/PlaytestDefs/farm_core.defs"
  ARG asset str DEFAULT_TEXT "Assets/Configs/PlaytestConfig.asset"
  TAG reflect_noerror
END

PYTOOL sync_unity SYSTEM RW "Refresh Unity and await its matching compile cycle within one timeout."
  DENY
  FLAG tier1
  ARG resolve bool DEFAULT False
  ARG bump bool DEFAULT False
  ARG timeout float DEFAULT 120.0
  TAG reflect_silent
END

TOOL test_step TESTS RW "[Play Mode] Move character, snapshot state before/after, check console."
  HANDLER register_async "CommandRouter.AsyncTestStep"
  BODY runtime
  DOC "checks_before/after: comma-separated 'path|component|field' triplets."
  DOC "Returns structured BEFORE/MOVE/AFTER/CONSOLE report."
  GUARD play_ok
  FLAG direct_only
  FLAG unity_transport
  RUNTIME
  ARG path str
  ARG position str
  ARG checks_before str DEFAULT_TEXT ""
  ARG checks_after str DEFAULT_TEXT ""
  ARG wait_after float DEFAULT 0.5
  ARG timeout float DEFAULT 15.0
  TAG reflect_silent
END

TOOL timeline MEDIA RW "Unity Timeline (PlayableDirector / TimelineAsset). Use for multi-track cinematic sequences mixing animation, audio, activation, and custom tracks — not for per-object keyframes (use `animation` for that)."
  FORWARD
  ACTION get
  ACTION create
  ACTION edit
  ACTION add_track
  ACTION remove_track
  ACTION add_clip
  ACTION remove_clip
  ACTION set_binding
  ACTION set_timing
  ACTION mute
  ACTION unmute
  ACTION lock
  ACTION unlock
  ACTION rename_track
  ACTION reorder_track
  ACTION duplicate_clip
  ACTION add_marker
  ACTION remove_marker
  ACTION set_track_offset
  ACTION set_duration
  ACTION add_sub_track
  ACTION set_clip_in
  ACTION get_bindings
  ACTION preview
  DOC "action: get | create | edit | add_track (Animation|Audio|Activation|Signal|Control|Group) | remove_track | add_clip | remove_clip | set_binding | set_timing | mute | unmute | lock | unlock | rename_track | reorder_track | duplicate_clip | add_marker | remove_marker | set_track_offset | set_duration | add_sub_track | set_clip_in | get_bindings | preview."
  DOC "track=track name. index=target position for reorder_track. offset=time shift for duplicate_clip. value=offset mode (auto|transform|scene) for set_track_offset."
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG action str
  ARG track ostr DEFAULT None
  ARG track_type ostr DEFAULT None
  ARG clip ostr DEFAULT None
  ARG binding ostr DEFAULT None
  ARG start ofloat DEFAULT None RAW
  ARG duration ofloat DEFAULT None RAW
  ARG blend_in ofloat DEFAULT None RAW
  ARG blend_out ofloat DEFAULT None RAW
  ARG asset_path ostr DEFAULT None
  ARG director_path ostr DEFAULT None
  ARG tracks ostr DEFAULT None
  ARG time ofloat DEFAULT None RAW
  ARG name ostr DEFAULT None "Action-specific Timeline track, clip, or marker name"
  ARG clip_in ofloat DEFAULT None RAW
  ARG index oint DEFAULT None RAW
  ARG offset ofloat DEFAULT None RAW
  ARG value ostr DEFAULT None "Action-specific Timeline value; set_track_offset accepts auto|transform|scene"
  READ get
  READ get_bindings
  TAG reflect_noerror
  TAG schema_keep_full
END

TOOL transfer_object SCENE RW "Move or copy a GameObject to another loaded scene. action: move|copy."
  HANDLER register "CommandRouter.ExecTransferObject"
  FORWARD
  DOC "target_scene: destination scene name. Omit = same scene (copy = duplicate)."
  DOC "parent: target parent path in destination scene."
  DOC "world_position_stays: preserve world transform (default True)."
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG action str EXAMPLE "move"
  ARG target_scene ostr DEFAULT None
  ARG parent ostr DEFAULT None
  ARG world_position_stays bool DEFAULT True OMIT
  EXPECT token "Moved|→"
END

PYTOOL ui_intent UGUI RW "Convert NL intent to Unity UI hierarchy. Templates bypass Haiku."
  BODY ui_intent_tool
  DOC "template: hud|menu|dialog|grid. dry_run=True skips execution."
  FLAG tier1
  ARG intent str
  ARG parent ostr DEFAULT None
  ARG template ostr DEFAULT None
  ARG dry_run bool DEFAULT False
  TAG reflect_silent
END

TOOL uitk_element UITOOLKIT RW "Mutate or query a VisualElement in a UIDocument or PanelRenderer host"
  HANDLER register "CommandRouter.ExecUitkElement"
  TIMEOUT 15.0
  ACTION query
  ACTION get
  ACTION set_style
  ACTION add_class
  ACTION remove_class
  ACTION get_style
  ACTION enable
  ACTION disable
  ARG action Any EXAMPLE "get"
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
  ARG ref ostr DEFAULT None
  ARG selector ostr DEFAULT None
  ARG name ostr DEFAULT None "VisualElement name used after ref and before selector in addressing priority"
  ARG value ostr DEFAULT None
  ARG property ostr DEFAULT None
  ARG class_name ostr DEFAULT None
  TAG reflect_noerror
END

TOOL uitk_file UITOOLKIT RW "Read or edit a UXML or USS asset file."
  WIRE not_batch
  FLAG direct_only
  FLAG unity_transport
  ACTION read
  ACTION revert
  ACTION write
  ACTION create_uxml
  ACTION create_uss
  ACTION set-attr
  ACTION add-class
  ACTION remove-class
  ACTION add-element
  ACTION remove-element
  ACTION set-rule
  ACTION remove-rule
  ARG path str "Assets/ path to a .uxml or .uss project file; Library/ and Packages/ are rejected"
  ARG action Any DEFAULT_TEXT "read"
  ARG content ostr DEFAULT None
  ARG selector ostr DEFAULT None
  ARG attr ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG cls ostr DEFAULT None WIRE "class"
  ARG parent ostr DEFAULT None
  ARG tag ostr DEFAULT None
  ARG attrs ostr DEFAULT None
  ARG prop ostr DEFAULT None
  READ read
  TAG reflect_noerror
END

PYTOOL uitk_intent UITOOLKIT RW "Generate a UXML + USS file pair from a natural-language UI description."
  BODY uitk_intent_tool
  DOC "Side effect: unless dry_run=True, writes both project assets; attach_to also adds a"
  DOC "UIDocument or PanelRenderer scene component. Completed steps are not rolled back if a later"
  DOC "step fails. Failure output distinguishes retained files, confirmed Unity"
  DOC "auto-reverts, and attempted files whose cleanup is uncertain. Without"
  DOC "template, invokes"
  DOC "configured Claude sampling and may"
  DOC "consume provider quota. For uGUI use ui_intent."
  DOC "template: hud|menu|dialog|settings|editor_window bypasses Haiku entirely."
  DOC "name: base filename (e.g. \"InventoryPanel\" → InventoryPanel.uxml + .uss)."
  DOC "path: output folder, default \"Assets/UI\"."
  DOC "attach_to: scene path to UIDocument or PanelRenderer GameObject to wire after creation."
  DOC "dry_run: return UXML+USS text without writing files."
  FLAG tier1
  TIMEOUT 60.0
  ARG intent str
  ARG name str "Base asset filename without extension (for <name>.uxml and <name>.uss)"
  ARG path str DEFAULT_TEXT "Assets/UI" "Project asset output folder for the generated UXML/USS pair (default Assets/UI)"
  ARG attach_to ostr DEFAULT None
  ARG template ostr DEFAULT None
  ARG dry_run bool DEFAULT False
  TAG reflect_silent
END

TOOL undo_last SYSTEM RW "Undo the last N AI turns in the Unity Undo stack. Default: 1."
  HANDLER register "CommandRouter.ExecUndoLast"
  FORWARD
  DOC "warn: file-system operations (asset creation/deletion via asset tool) are"
  DOC "not reversed by undo. Only scene-object and component mutations are undoable."
  ARG turns int DEFAULT 1 RAW
  EXPECT token "reverted|nothing"
END

TOOL unwire_event COMPONENTS DEL "Remove persistent listener(s) from UnityEvent. Mutates scene. No confirmation required."
  HANDLER register "CommandRouter.ExecUnwireEvent"
  NEXT "get_component"
  FORWARD
  DOC "index: remove specific entry (0-based). Omit to clear all."
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG component str
  ARG event str EXAMPLE "onClick"
  ARG index oint DEFAULT None RAW
  TAG atomic_scene
  EXPECT token "Cleared|Removed"
END

PYTOOL use_skill SYSTEM RW "Execute a previously saved skill. params: comma-separated key=value for substitution."
  BODY skills
  ARG name str "Saved learned-skill identifier from list_skills"
  ARG params ostr DEFAULT None
  TAG reflect_silent
END

TOOL validate_playtest_aliases TESTS RO "Compare alias .defs text file vs PlaytestConfig.asset. Reports missing/extra/changed."
  GUARD compile
  FORWARD
  DOC "defs: project-relative path to .defs file (default: Assets/PlaytestDefs/farm_core.defs)."
  DOC "asset: asset path to PlaytestConfig (default: Assets/Configs/PlaytestConfig.asset)."
  DOC "Returns 'ok: N aliases in sync' when identical, or a diff report."
  ARG defs str DEFAULT_TEXT "Assets/PlaytestDefs/farm_core.defs"
  ARG asset str DEFAULT_TEXT "Assets/Configs/PlaytestConfig.asset"
END

TOOL validate_references VERIFY RO "Validate all ObjectReference fields under path recursively."
  HANDLER register "CommandRouter.ExecValidateReferences"
  FORWARD
  FLAG tier1
  DOC "Returns [ERROR]/[MISSING] for broken refs. Summary: \"N ERROR, M OK\"."
  DOC "Use depth=1 for quick top-level scan, depth=3-5 for full subtree."
  DOC "verbose=True also shows [OK] lines (off by default to save tokens)."
  DOC "ignore_optional=True skips fields marked [Optional] (reduces noise)."
  VERB "Checking refs"
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG depth int DEFAULT 3 RAW
  ARG verbose bool DEFAULT False OMIT
  ARG ignore_optional bool DEFAULT False OMIT
END

TOOL validate_triggers SCENE RO "Check 3D trigger/collider overlaps. Warns if triggers closer than min_distance meters."
  HANDLER register "CommandRouter.ExecValidateTriggers"
  FORWARD
  ARG root str DEFAULT_TEXT "/"
  ARG min_distance float DEFAULT 3.0
END

# May run Unity tests/playtests and stop or restart Play Mode.
PYTOOL verify_after_change VERIFY RW "Single verification gate after code/scene changes."
  BODY verify
  DOC "Gates are additive — only enabled ones run:"
  DOC "1. await_compile (always)"
  DOC "2. get_compile_errors (always)"
  DOC "3. get_console_since mark_id (if mark_id provided)"
  DOC "4. run_tests_wait mode filter (if run_tests_mode provided)"
  DOC "5. run_playtest_suite paths (if playtests provided)"
  DOC "Returns PASS only when ALL enabled gates pass."
  DOC "Failure includes which gate failed and recommended next command."
  FLAG tier1
  TIMEOUT 600.0
  ARG changed_files str DEFAULT_TEXT ""
  ARG test_filter str DEFAULT_TEXT ""
  ARG run_tests_mode str DEFAULT_TEXT ""
  ARG playtests str DEFAULT_TEXT ""
  ARG mark_id str DEFAULT_TEXT ""
  ARG timeout float DEFAULT 300.0
  ARG auto_play bool DEFAULT False
  ARG restart_between bool DEFAULT False
  ARG suite_timeout float DEFAULT 300.0
  TAG reflect_silent
END

PYTOOL vfx_intent MEDIA RW "Convert NL intent to Unity VFX setup. Presets bypass Haiku entirely."
  BODY vfx_intent_tool
  DOC "kind: particle|auto (shader/material not yet implemented). dry_run=True skips execution."
  FLAG tier1
  ARG target str
  ARG intent str
  ARG kind str DEFAULT_TEXT "auto"
  ARG dry_run bool DEFAULT False
  TAG reflect_silent
END

TOOL wait_until RUNTIME RW_IDEM "[Play Mode] Poll field until it matches value (or timeout)."
  HANDLER register_async "CommandRouter.AsyncWaitUntil"
  BODY runtime
  DOC "Python timeout = Unity timeout + 5s buffer."
  DOC "abort_on_fail=True: stops Play Mode on timeout."
  FLAG direct_only
  FLAG unity_transport
  RUNTIME
  ARG path str
  ARG component str
  ARG field str
  ARG value str "Expected field value to compare against (this tool does not set the field)"
  ARG timeout float DEFAULT 5.0
  ARG negate bool DEFAULT False
  ARG abort_on_fail bool DEFAULT False "Stop Play Mode if the comparison times out (default False)"
  TAG reflect_silent
END

PYTOOL watch RUNTIME RW "[Play Mode] Manage watches. Registers or removes watches. No confirmation required. action: add|remove|clear|reset."
  ARG action str
  ARG watch_id str DEFAULT_TEXT ""
  ARG path str DEFAULT_TEXT ""
  ARG component str DEFAULT_TEXT ""
  ARG field str DEFAULT_TEXT ""
  ARG condition str DEFAULT_TEXT ""
  ARG trigger_action str DEFAULT_TEXT "log"
  ARG interval_ms int DEFAULT 500
  TAG reflect_noerror
END

TOOL wire_event COMPONENTS RW "Wire UnityEvent persistent listener. Mutates scene. No confirmation required."
  HANDLER register "CommandRouter.ExecWireEvent"
  CARD generic
  NEXT "validate_references"
  FORWARD
  DOC "path: object with the event. component: type owning the event field."
  DOC "event: serialized field name (e.g. 'onClick', '_onComplete')."
  DOC "target: scene path or asset path. Auto-resolves component owning the method."
  DOC "method: method name (e.g. 'SetActive', 'Play')."
  DOC "arg_type: void|bool|int|float|string|object."
  DOC "arg_value: required when arg_type != void. For object: scene path or asset path."
  DOC "target_component_type: narrow component search to this type (e.g. 'Animator')."
  DOC "parameter_types: comma-separated param types to resolve overloads (e.g. 'string')."
  VERB "Wiring"
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG component str
  ARG event str EXAMPLE "onClick"
  ARG target str EXAMPLE "/__seam_tgt"
  ARG method str EXAMPLE "SetActive"
  ARG arg_type str DEFAULT_TEXT "void"
  ARG arg_value ostr DEFAULT None
  ARG target_component_type ostr DEFAULT None
  ARG parameter_types ostr DEFAULT None
  TAG atomic_scene
  TAG distill_skip
  TAG do_allowed
  BLAST 2
  EXPECT token "wired|connected" STRICT
END
