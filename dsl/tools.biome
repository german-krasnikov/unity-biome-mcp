  ARG component str
  ARG event str
  ARG index oint DEFAULT None
END

PYTOOL use_skill SYSTEM RW "Execute a previously saved skill. params: comma-separated key=value for substitution."
  ARG name str "Saved learned-skill identifier from list_skills"
