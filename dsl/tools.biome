TOOL get_test_run TESTS RO "Return the durable JSON snapshot for one exact test run."
  BODY testing
  DOC "Fails closed on terminal-invalid evidence: a snapshot claiming"
  DOC "``state == \"terminal\"`` that doesn't pass ARC-1/ARC-3 validation (an"
  DOC "honest zero-match filter, a stalled/unresponsive terminal claim, a"
  DOC "corrupted count) comes back as"
  DOC "``PROTOCOL-ERROR|run_id=...|reason=...|snapshot=...`` instead of the raw"
  DOC "snapshot -- closes the direct-poll path around ``run_tests_wait``'s own"
  DOC "validation."
  DOC "compact=True trims leaf-detail arrays on a non-terminal snapshot (A27) --"
  DOC "use for a tight-cadence poll loop; a terminal snapshot is unaffected."
  GUARD compile
  TIMEOUT 10.0
  ARG run_id str EXAMPLE "__seam_nonexistent"
  ARG compact bool DEFAULT False "Return a shorter summary instead of the full per-test breakdown"
END

