SURFACE tools
# One block per tool, by name (dsl/README.md). TOOL: Unity handles it; PYTOOL: only the Python server implements it (direct_only).
# INTERNAL <name> <RO|RW> "<what it is>": a wire command that is no MCP tool; it has a ToolSpec (timeout, flags) and nothing else.
# TOOL <name> <CATEGORY> <effect> "<summary>": RO read-only | RW writes | RW_IDEM writes, safe to repeat | DEL destructive
# (ToolSpec.mutability, MCP annotation); the summary is the first line of the description. FORWARD: the MCP wrapper is generated, its
# description is the summary and the DOC lines, one per line. FLAG (core tier1 direct_only unity_transport), RUNTIME (runtime_only),
# TIMEOUT <s>: ToolSpec fields.
# MAXCHARS <n>: the response limit of the Unity registration (maxResponseChars), checked against it by test_catalog_vs_csharp.py.
# ARG <name> <type> [DEFAULT <v> [OMIT]] [DEFAULT_TEXT "<s>" [OMIT]] [RAW] ["<schema description>"]: in the order of the Python signature,
# required without a default; the type is str int float bool, o-prefixed when None is allowed, or Any (checked by name and default only:
# Context, Literal, ...); OMIT: a value equal to the default is not sent, Unity applies it; RAW: a FORWARD wrapper sends the value as it is.

TOOL analyze_lod_culling MEDIA RO "LOD group coverage + occlusion culling analysis."
  ARG focus ostr DEFAULT None
END

PYTOOL ask SYSTEM RO "Answer a read-only question about the Unity scene (AI-routed, not interactive — use `ask_user` to show a UI card and wait for user input)."
  ARG question str
END

TOOL auto_wire COMPONENTS RW "Fill null ObjectReference fields on a GameObject by matching field name or type to scene objects. Mutates scene when dry_run=False. No confirmation required."
  ARG path str
  ARG dry_run bool DEFAULT False
END

TOOL autofit_collider SCENE RW "Auto-fit collider to mesh/renderer bounds. type: box|sphere|capsule."
  ARG path str
  ARG type str DEFAULT_TEXT "box" "Collider shape to fit: box|sphere|capsule"
END

PYTOOL await_compile VERIFY RO "Block until Unity finishes compiling + reloading, then return compile errors."
  FLAG tier1
  ARG timeout float DEFAULT 60.0
  ARG expected_generation oint DEFAULT None
END

TOOL check_colliders SCENE RO "Check collider issues: triggers without Rigidbody, negative scale, micro colliders. Scans whole scene if no path given."
  ARG path ostr DEFAULT None
END

# timeout_s is a fallback ceiling only -- code_intel.py:25 always passes
# timeout=15.0 (fast-fail by design).
TOOL compile_preflight VERIFY RO "Validate C# WITHOUT writing/recompiling (Roslyn). Use before writing .cs — catches typos in ~200ms vs 30s recompile."
  FLAG core
  TIMEOUT 60.0
  ARG file_path str
  ARG new_content str
END

TOOL create_object CORE RW "Create new GameObject. components: comma-separated types to add on creation. primitive: Cube|Sphere|Cylinder|Capsule|Plane|Quad. prefab_path: instantiate from prefab asset. scene: create in named loaded scene (omit = active scene)."
  FLAG core
  ARG name str "Name for the new GameObject"
  ARG parent ostr DEFAULT None "Scene path of the parent (omit = scene root)"
  ARG components ostr DEFAULT None "Comma-separated component types to add on creation (e.g. 'Rigidbody,BoxCollider')"
  ARG primitive ostr DEFAULT None "Primitive mesh type: Cube|Sphere|Cylinder|Capsule|Plane|Quad"
  ARG prefab_path ostr DEFAULT None "Asset path to instantiate from prefab (e.g. Assets/Prefabs/Enemy.prefab)"
  ARG scene ostr DEFAULT None "Target scene name when multiple scenes are loaded (omit = active scene)"
END

TOOL debug_animator RUNTIME RO "[Play Mode] Read Animator state: layers, transitions, parameters (use `debug` for scene; `diagnose` for compile)."
  RUNTIME
  ARG path str
END

TOOL debug_physics RUNTIME RO "[Play Mode] Read Rigidbody state, colliders, contacts, and nearby objects (use `debug` for scene; `diagnose` for compile)."
  RUNTIME
  ARG path str
  ARG radius float DEFAULT 5.0
END

TOOL delete_object SCENE DEL "Delete GameObject by instance ID or scene path. Deletes scene objects. No confirmation required. Provide one. force=True to delete non-empty containers."
  FLAG tier1
  ARG id oint DEFAULT None "Instance ID of the GameObject to delete (from get_hierarchy)"
  ARG path ostr DEFAULT None "Scene path of the GameObject to delete"
  ARG force bool DEFAULT False "True to delete non-empty container objects without error"
END

TOOL diagnose VERIFY RO "Read Unity compile/reload fact-signals atomically; returns typed verdict. For scene symptom analysis, use `debug`. For runtime component state, use `debug_animator` or `debug_physics`."
  ARG prev_mvid str DEFAULT_TEXT ""
  ARG expected_compile bool DEFAULT True
END

INTERNAL export_package RW "Protocol name of the asset action export_package; only its timeout is used, Unity registers no command of this name."
  TIMEOUT 120.0
END

TOOL export_playtest_aliases_to_defs TESTS RW "Export PlaytestConfig.asset aliases to a readable .defs text file."
  ARG asset str DEFAULT_TEXT "Assets/Configs/PlaytestConfig.asset"
  ARG defs str DEFAULT_TEXT "Assets/PlaytestDefs/farm_core.defs"
END

TOOL find_objects SCENE RO "Find objects by criteria. Use search_scene for complex queries. Does NOT support: parent, path, active/inactive filtering, regex. Only: name (substring), tag, layer, component (full namespace)."
  ARG name ostr DEFAULT None
  ARG tag ostr DEFAULT None
  ARG layer ostr DEFAULT None
  ARG component ostr DEFAULT None
END

TOOL fingerprint SYSTEM RO "Scene state hash. Returns fp:XXXXXXXX. If unchanged, skip re-reading. ~5 tokens."
  TIMEOUT 10.0
  ARG path ostr DEFAULT None
  ARG depth int DEFAULT 3
END

INTERNAL get_aliases RO "The alias table as name=value lines; the server reads it when it connects."
END

TOOL get_changes SYSTEM RW "Get Unity editor changes since last call. Tracks: hierarchy changes, undo/redo,"
  ARG clear bool DEFAULT True
END

TOOL get_component CORE RO "Component properties as key-value. For MULTIPLE objects, use inspect(paths='a,b,c') instead — 1 call vs N."
  FLAG core
  ARG path str "Scene path to the GameObject (e.g. /Player or /World/Enemy)"
  ARG type str DEFAULT_TEXT "" "Component type name (e.g. 'Transform', 'Rigidbody', 'MeshRenderer')"
  ARG fields ostr DEFAULT None "Comma-separated fields to return (e.g. 'mass,localPosition') — skips all others, saves tokens"
  ARG full bool DEFAULT False "Return raw uncompressed response (bypass distillation)"
  ARG compress bool DEFAULT False "Strip fields at their default value before TCP transfer — reduces response size"
  ARG component ostr DEFAULT None
END

TOOL get_components_list SCENE RO "List all components on object by instance ID."
  ARG id int
END

TOOL get_hierarchy CORE RO "Scene hierarchy as text tree. For finding specific object by name/type use search_scene. Max 3000 nodes. Use filter/depth to narrow. Set components=true to see component types. Set compress=true to group repeated slots/points/meshes. Set summary=true for compact root-only counts (60-100 tokens). Set incremental=true to get NO_CHANGE if scene unchanged since last call. full=True: bypass distillation. scene: filter to a single scene by name (multi-scene only)."
  FLAG core
  TIMEOUT 15.0
  MAXCHARS 50000
  ARG depth int DEFAULT 2 "Traversal depth (default 2; increase for deeper trees)"
  ARG root ostr DEFAULT None "Scene path to scope the hierarchy (omit = whole scene)"
  ARG filter ostr DEFAULT None "Substring filter on GameObject name"
  ARG components bool DEFAULT False "Show component types next to each object (increases token cost)"
  ARG compress bool DEFAULT False "Group repeated slot/point/mesh siblings to save tokens on dense scenes"
  ARG summary bool DEFAULT False "Return compact root-only counts (~60-100 tokens) instead of the full tree"
  ARG incremental bool DEFAULT False "Return NO_CHANGE if scene is unchanged since last call (saves tokens)"
  ARG full bool DEFAULT False "Bypass distillation — return raw response"
  ARG scene ostr DEFAULT None "Filter to a single scene by name (multi-scene only)"
END

PYTOOL get_metrics RUNTIME RW "Returns telemetry snapshot. Clears counters when reset=True. No confirmation required. format: text|json."
  ARG format str DEFAULT_TEXT "text"
  ARG reset bool DEFAULT False
END

TOOL get_object_detail SCENE RO "Get ALL components with ALL values. Heavy. Use get_component for single component. full=True: bypass distillation."
  ARG id int
  ARG full bool DEFAULT False
END

# E03: Wave E async playtest poll — internal wire command, not @mcp.tool() until E04
# wires run_playtest(timeout>120) through the async start/poll pair. Same shape as
# source_patch_write below (RegisterAsync in C#, no Python-typed wrapper yet).
INTERNAL get_playtest_run RO "Polls the asynchronous playtest run that start_playtest began."
  FLAG direct_only
  FLAG unity_transport
END

TOOL get_spatial_context SCENE RO "Collider info + approach vectors + nearby objects within radius. Raycast in Play Mode only."
  ARG path str
  ARG radius float DEFAULT 5.0
END

TOOL get_unity_events SCENE RO "List all UnityEvent persistent listeners in the active scene."
  ARG path ostr DEFAULT None
END

INTERNAL get_version RO "Version and protocol handshake; the Unity server answers it before the command router."
  TIMEOUT 5.0
END

INTERNAL import_package RW "Protocol name of the asset action import_package; only its timeout is used, Unity registers no command of this name."
  TIMEOUT 120.0
END

TOOL inspect CORE RO "Get components for multiple objects at once. paths: comma-separated. components: comma-separated types (default: all)."
  FLAG core
  ARG paths ostr DEFAULT None "Comma-separated scene paths (e.g. '/Player,/Enemy,/Camera')"
  ARG components ostr DEFAULT None "Comma-separated component types to read (omit = all)"
  ARG fields ostr DEFAULT None "Comma-separated field names to project across all objects — reduces tokens"
  ARG full bool DEFAULT False "Return raw uncompressed response (bypass distillation)"
  ARG compress bool DEFAULT False "Strip fields at their default value before TCP transfer — reduces response size"
  ARG find_type ostr DEFAULT None "Component type — auto-populates paths from all scene objects with this component"
END

TOOL invoke_method RUNTIME RW "[Play Mode] Call public method on a component via reflection."
  RUNTIME
  ARG path str
  ARG component str
  ARG method str
  ARG args str DEFAULT_TEXT ""
END

PYTOOL lint_playtest_suite TESTS RO "Read-only preflight check across multiple .playtest files."
  TIMEOUT 120.0
  ARG pattern ostr DEFAULT None
  ARG suite_path ostr DEFAULT None
END

TOOL lint_scene_refs VERIFY RO "Read-only linter for scene references in DSL scripts or batch commands."
  FLAG tier1
  ARG path ostr DEFAULT None "Project-relative path to a .playtest DSL file"
  ARG snippet ostr DEFAULT None
END

PYTOOL list_connections SYSTEM RO "List Unity connection status."
END

TOOL list_events COMPONENTS RO "Read persistent listeners on a UnityEvent field. Use after wire_event to verify."
  ARG path str
  ARG component str
  ARG event str
END

INTERNAL list_playtest_files RO "Lists the files that match a glob pattern (default Playtests/*.playtest), one project-relative path per line."
  TIMEOUT 10.0
END

PYTOOL load_session SYSTEM RO "Load previous session context beside the current hierarchy."
END

TOOL manage_component CORE RW "Add or remove a component. Mutates scene. No confirmation required. action: 'add' or 'remove' ONLY (no 'enable'/'disable' — use set_property with prop='m_Enabled' for that). type: short name (e.g. 'Button') or full namespace (e.g. 'UnityEngine.UI.Button')."
  FLAG core
  ARG path str "Scene path to the GameObject"
  ARG type str "Component type (short: 'Button' or full namespace: 'UnityEngine.UI.Button')"
  ARG action str "'add' or 'remove' — not 'enable'/'disable' (use set_property m_Enabled for that)"
END

TOOL move_to RUNTIME RW "[Play Mode] Move character to position and wait for arrival."
  FLAG direct_only
  FLAG unity_transport
  RUNTIME
  ARG path str
  ARG position str
  ARG timeout float DEFAULT 15.0
END

PYTOOL navmesh_query SCENE RW "NavMesh queries and management. Bakes or clears NavMesh data for bake/clear actions. No confirmation required. action: sample|path|raycast|bake|status|clear|get_settings|set_settings."
  ARG action str
  ARG center ostr DEFAULT None
  ARG from_pos ostr DEFAULT None
  ARG to ostr DEFAULT None
  ARG max_distance float DEFAULT 5.0
  ARG area_mask int DEFAULT -1
  ARG agentRadius ofloat DEFAULT None
  ARG agentHeight ofloat DEFAULT None
  ARG agentClimb ofloat DEFAULT None
  ARG agentSlope ofloat DEFAULT None
END

TOOL object_diff SCENE RO "Diff two GameObjects (components, properties, children). Cross-scene: 'SceneA:/Alice'."
  ARG path_a str
  ARG path_b str
END

INTERNAL ping RO "Liveness probe: Unity answers pong."
  TIMEOUT 5.0
END

TOOL query_state RUNTIME RO "[Play Mode] Snapshot multiple game values in one call."
  RUNTIME
  ARG queries str
END

TOOL region_clear SCENE RW "Delete (or preview) all objects whose XZ pivot is inside the polygon region. Deletes scene objects when dry_run=False. No confirmation required."
  ARG vertices str
  ARG dry_run bool DEFAULT True
  ARG filter ostr DEFAULT None
  ARG cap int DEFAULT 50
END

TOOL rename_object SCENE RW_IDEM "Rename a GameObject. Returns new scene path after rename."
  FORWARD
  DOC "path: current scene path, &ref (e.g. &1) or $hexId (legacy), #instanceID (legacy). name: new name (non-empty)."
  DOC "Note: all subsequent MCP calls must use the new path."
  ARG path str
  ARG name str
END

TOOL resolve_scene_refs VERIFY RO "Read-only scene reference resolver."
  TIMEOUT 15.0
  ARG refs str
  ARG fields ostr DEFAULT None
END

# timeout_s is a fallback ceiling only -- tools/runtime.py always passes
# timeout+20.0 explicitly.
# B05/R-05: runtime_only intentionally NOT set here — C#'s CommandRouter.Registration.cs
# registration (runtime: false) is the sole authority now that the Play-mode gate moved
# past parsing into AsyncRunPlaytest's own `# @needs editmode` header check. A static
# True here would reintroduce a second, stale Python-only authority (see
# test_runtime_only_single_source).
TOOL run_playtest TESTS RW "[Play Mode] Execute a playtest DSL script. Returns structured report (for NUnit tests, use `run_tests`)."
  FLAG tier1
  FLAG direct_only
  FLAG unity_transport
  TIMEOUT 300.0
  ARG script ostr DEFAULT None "Inline DSL script (mutually exclusive with path)"
  ARG timeout float DEFAULT 120.0 "Max seconds to wait for the playtest to finish (default 120)"
  ARG abort_on_fail bool DEFAULT False "Stop after the first failed step or automatic console failure; remaining steps, including teardown, are skipped"
  ARG defs ostr DEFAULT None "Inline VAL definitions prepended to script (alias block)"
  ARG path ostr DEFAULT None "Path to .playtest DSL file on disk (mutually exclusive with script)"
  ARG snapshot_on_failure bool DEFAULT False "Auto-capture screenshot on first ASSERT failure"
  ARG fresh bool DEFAULT False "Stop and restart Play Mode before running the script"
  ARG before_hook ostr DEFAULT None "DSL commands to run before entering Play Mode"
  ARG after_hook ostr DEFAULT None "DSL commands to run after Play Mode exits"
  ARG format str DEFAULT_TEXT "text"
END

PYTOOL run_playtest_suite TESTS RW "Run multiple .playtest files sequentially and return a compact matrix."
  FLAG tier1
  TIMEOUT 3600.0
  ARG pattern ostr DEFAULT None
  ARG suite_path ostr DEFAULT None
  ARG timeout_per_test float DEFAULT 120.0
  ARG stop_on_fail bool DEFAULT False
  ARG stop_after bool DEFAULT True
  ARG auto_play bool DEFAULT False
  ARG restart_between bool DEFAULT False
  ARG suite_timeout float DEFAULT 300.0
  ARG tag ostr DEFAULT None
END

TOOL runtime_snapshot RUNTIME RO "Snapshot all runtime objects of a given component type. Returns per-object field dump."
  MAXCHARS 50000
  ARG type str
  ARG name ostr DEFAULT None
  ARG component ostr DEFAULT None
  ARG compress bool DEFAULT False
END

PYTOOL save_session SYSTEM RW "Save current scene state to .claude/session-context.json for cold-start recovery."
END

TOOL scan_scene VERIFY RO "Scene infrastructure scan: colliders, triggers, audio, lights, rigidbody, canvas, nav. Coverage stats."
END

TOOL scene SCENE DEL "Scene management. action: new|open|save|discard|open_additive|close|set_active|list|save_copy."
  FLAG tier1
  ARG action str "Operation: new|open|save|discard|open_additive|close|set_active|list"
  ARG path ostr DEFAULT None "Asset path — required for open/save/open_additive/close/set_active"
  ARG scene ostr DEFAULT None "Scene name for save/discard when multiple scenes are loaded"
  ARG include_unsaved bool DEFAULT True
END

TOOL scene_diff SCENE RO "Compare scene with last snapshot. First call saves snapshot. Returns diff: added/removed lines."
END

TOOL scene_environment SCENE RW "Read/write scene environment: ambient light, fog, skybox, reflections."
  ARG action str DEFAULT_TEXT "get"
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None
END

TOOL scene_health VERIFY RO "Scene hierarchy/health audit."
  ARG focus str DEFAULT_TEXT "all"
END

PYTOOL screenshot_baseline MEDIA RW "Save screenshot as baseline for visual regression. name: file-safe identifier."
  ARG name str DEFAULT_TEXT "default" "File-safe baseline identifier (not a GameObject name; no '/', '\\', or '..')"
  ARG width int DEFAULT 640
  ARG height int DEFAULT 480
  ARG camera ostr DEFAULT None
END

PYTOOL screenshot_compare MEDIA RW "Compare current screenshot with saved baseline."
  ARG name str DEFAULT_TEXT "default" "File-safe saved-baseline identifier (not a GameObject name; no '/', '\\', or '..')"
  ARG width int DEFAULT 640
  ARG height int DEFAULT 480
  ARG camera ostr DEFAULT None
  ARG mode str DEFAULT_TEXT "auto"
  ARG question ostr DEFAULT None
END

TOOL search_scene SCENE RO "Search scene objects. Syntax: name text, t:Component, tag=Tag, layer=N, active=bool. Combine with spaces."
  FORWARD
  FLAG tier1
  TIMEOUT 15.0
  MAXCHARS 30000
  DOC "root: scope search to subtree (path or None for whole scene)."
  DOC "limit: max results (default 50; 0=unlimited)."
  DOC "scene: filter to a single scene by name (multi-scene only)."
  ARG query str "Syntax: 'name text', 't:Component', 'tag=Tag', 'layer=N', 'active=bool' — combine with spaces"
  ARG root ostr DEFAULT None "Scene path to scope the search (omit = whole scene)"
  ARG limit int DEFAULT 50 OMIT "Max results (default 50; 0 = unlimited)"
  ARG scene ostr DEFAULT None "Filter to a single scene by name (multi-scene only)"
END

TOOL serialized_field_rename_audit VERIFY RO "Audit [SerializeField] rename safety."
  ARG type str
  ARG old_field str
  ARG new_field str
  ARG include str DEFAULT_TEXT "prefabs,scenes,scriptable_objects"
END

TOOL set_active SCENE RW_IDEM "Set GameObject active/inactive."
  FORWARD
  FLAG tier1
  ARG path str "Scene path to the GameObject"
  ARG active bool "True to activate, False to deactivate"
END

TOOL set_material SCENE RW_IDEM "Set scene object material color (for full asset management use `material`). color: hex (#FF0000). shader: URP/Standard auto."
  ARG path str
  ARG color str
  ARG shader ostr DEFAULT None
END

TOOL set_parent SCENE RW_IDEM "Reparent existing GameObject. parent=null → move to scene root. world_position_stays=True (default): preserves world transform. False: stays local to new parent."
  FLAG tier1
  ARG path str "Scene path of the GameObject to reparent"
  ARG parent ostr DEFAULT None "New parent scene path (omit or null = move to scene root)"
  ARG world_position_stays bool DEFAULT True "True (default) = preserve world transform; False = keep local transform relative to new parent"
END

TOOL set_property CORE RW_IDEM "Set component property (Edit Mode, SerializedObject — for Play Mode use `invoke_method` or `execute_code`)."
  FLAG core
  ARG path ostr DEFAULT None "Scene path to the GameObject (e.g. /Player/Body)"
  ARG component str DEFAULT_TEXT "" "Component type (empty string = Transform)"
  ARG prop str DEFAULT_TEXT "" "Property name as shown in Inspector (e.g. 'mass', 'localPosition.x')"
  ARG value Any DEFAULT None "New value. ObjectReference: scene path (/Player), asset path (Assets/X.mat), sub-asset (Assets/X.fbx::ClipName), &ref (e.g. &1) or $hexId (legacy), #instanceID (legacy), or 'null'"
  ARG dry_run bool DEFAULT False "Show what would change without applying (safe preview)"
  ARG find_type ostr DEFAULT None "Component type — bulk-sets prop on ALL scene objects with this component (no path needed)"
  ARG ref_component_type ostr DEFAULT None
END

TOOL set_property_delta SCENE RW "Apply delta to numeric property. delta: +5, -0.5, (+1,2,0). Returns: old → new."
  ARG path str
  ARG component str
  ARG prop str
  ARG delta str
END

TOOL set_sibling_index SCENE RW "Set sibling index of a GameObject within its parent. index=0 moves to first child."
  FORWARD
  ARG path str
  ARG index int
END

PYTOOL snapshot RUNTIME RO "Capture or compare object state."
  ARG path str
  ARG label str DEFAULT_TEXT "default"
  ARG compare str DEFAULT_TEXT ""
END

# P0-50: internal, direct-only, unity_transport — routed only by asset.py's
# own internal sender when Source Patch mutation is armed; never a public
# MCP tool, never batchable (see server/tests/test_source_patch_boundary.py).
INTERNAL source_patch_write RW "Writes a source patch; the internal sender of asset.py routes it when Source Patch mutation is armed."
  FLAG direct_only
  FLAG unity_transport
END

TOOL spatial_query SCENE RO "Spatial queries. action: nearest|in_front_of|objects_in_radius|bounds_info|raycast|spatial_map|objects_in_polygon."
  ARG action str
  ARG path ostr DEFAULT None
  ARG target ostr DEFAULT None
  ARG distance ofloat DEFAULT None
  ARG radius ofloat DEFAULT None
  ARG component ostr DEFAULT None
  ARG cell_size ofloat DEFAULT None
  ARG layer_mask ostr DEFAULT None
  ARG center ostr DEFAULT None
  ARG vertices ostr DEFAULT None
  ARG region_id ostr DEFAULT None
  ARG cap oint DEFAULT None
END

# E02: Wave E non-blocking playtest dispatch — internal wire command, no @mcp.tool()
# until E04. Same shape as source_patch_write above.
INTERNAL start_playtest RW "Starts a playtest without blocking; get_playtest_run polls it."
  FLAG direct_only
  FLAG unity_transport
END

TOOL sync_playtest_aliases_from_defs TESTS RW "Overwrite PlaytestConfig.asset aliases from a .defs text file."
  ARG defs str DEFAULT_TEXT "Assets/PlaytestDefs/farm_core.defs"
  ARG asset str DEFAULT_TEXT "Assets/Configs/PlaytestConfig.asset"
END

TOOL test_step TESTS RW "[Play Mode] Move character, snapshot state before/after, check console."
  FLAG direct_only
  FLAG unity_transport
  RUNTIME
  ARG path str
  ARG position str
  ARG checks_before str DEFAULT_TEXT ""
  ARG checks_after str DEFAULT_TEXT ""
  ARG wait_after float DEFAULT 0.5
  ARG timeout float DEFAULT 15.0
END

TOOL transfer_object SCENE RW "Move or copy a GameObject to another loaded scene. action: move|copy."
  ARG path str
  ARG action str
  ARG target_scene ostr DEFAULT None
  ARG parent ostr DEFAULT None
  ARG world_position_stays bool DEFAULT True
