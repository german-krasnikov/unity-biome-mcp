PYTOOL navmesh_query SCENE RW "NavMesh queries and management. Bakes or clears NavMesh data for bake/clear actions. No confirmation required. action: sample|path|raycast|bake|status|clear|get_settings|set_settings."
  BODY spatial
  DOC "sample: find nearest walkable point to center."
  DOC "path: calculate path from from_pos to to."
  DOC "raycast: NavMesh raycast from from_pos toward to."
  DOC "bake: build NavMesh (NavMeshSurface components or legacy NavMeshBuilder)."
  DOC "status: triangulation stats (triangles, vertices, areas)."
  DOC "clear: remove all baked NavMesh data."
  DOC "get_settings: list all NavMesh agent type settings."
  DOC "set_settings: update NavMeshSurface agent params (agentRadius/agentHeight/agentClimb/agentSlope)."
  ARG action str
  ARG center ostr DEFAULT None
  ARG from_pos ostr DEFAULT None
  ARG to ostr DEFAULT None
  ARG max_distance float DEFAULT 5.0
  ARG area_mask int DEFAULT -1
  ARG agentRadius ofloat DEFAULT None
  ARG agentHeight ofloat DEFAULT None
  ARG agentClimb ofloat DEFAULT None
  ARG agentSlope ofloat DEFAULT None
  READ get_settings
  READ path
  READ raycast
  READ sample
  READ status
  TAG reflect_noerror
END

