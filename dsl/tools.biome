  ARG type str EXAMPLE "Rigidbody" ROLE name "Component type (short: 'Button' or full namespace: 'UnityEngine.UI.Button')"
  ARG action str EXAMPLE "add" "'add' or 'remove' — not 'enable'/'disable' (use set_property m_Enabled for that)"
