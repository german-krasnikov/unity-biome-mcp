TOOL screenshot MEDIA RW "Capture screenshot (file path); describe= -> Haiku text (15-100x fewer tokens), raw=True forces path."
  BODY screenshot
  DOC "camera: scene_view|scene_view_frame|multi_view|single_view|overview|overview_game. angle (single_view): front|left|top|iso|ex,ey,ez."
  DOC "zoom: higher=closer. angles: per-view Euler \"ex,ey,ez|...\" (_=skip). supersample 1-4. offset/fixed_size: framing."
  DOC "highlight: paths[:#RRGGBB] for bbox. show_colliders: wireframes."
  DOC "annotation_id: frame + highlight annotation by id (auto sets camera=annotation_frame)."
  DOC "warn:ScreenSpaceOverlay canvas not captured in Edit Mode (bypasses camera pipeline)."
  DOC "Workarounds: switch to ScreenSpace-Camera, use Play Mode, or camera=scene_view."
  GUARD compile
  WIRE special
  FLAG tier1
  FLAG direct_only
  FLAG unity_transport
  VERB "Capturing screenshot"
  ARG width int DEFAULT 640 "Image width in pixels (default 640)"
  ARG height int DEFAULT 480 "Image height in pixels (default 480)"
  ARG camera ostr DEFAULT None "View type: scene_view|scene_view_frame|multi_view|single_view|overview|overview_game"
  ARG path ostr DEFAULT None "For single_view/multi_view: target GameObject scene path; for standard captures: legacy project-contained .png destination (prefer output_path)"
  ARG output_path ostr DEFAULT None "Unambiguous project-contained .png destination for every capture mode"
  ARG describe ostr DEFAULT None LOCAL "Haiku prompt for AI text description instead of returning file path (15-100x fewer tokens)"
  ARG raw bool DEFAULT False LOCAL "Force returning file path even when describe= is set"
  ARG zoom ofloat DEFAULT None "Zoom factor — higher = closer"
  ARG angles ostr DEFAULT None "Per-view Euler angles: 'ex,ey,ez|...' (underscore = skip this view)"
  ARG supersample oint DEFAULT None "Anti-alias quality 1-4 (higher = sharper, slower)"
  ARG offset ostr DEFAULT None "Framing offset vector"
  ARG fixed_size ofloat DEFAULT None "Fixed framing size override"
  ARG highlight ostr DEFAULT None "Comma-separated paths to highlight with bounding box (e.g. /Player:#FF0000)"
  ARG show_colliders obool DEFAULT None "Overlay collider wireframes on the screenshot"
  ARG angle ostr DEFAULT None "Euler angle for single_view: front|left|top|iso|ex,ey,ez"
  ARG annotation_id ostr DEFAULT None "Frame + highlight annotation by ID (auto-sets camera=annotation_frame)"
  TAG scene_state_neutral
  TAG reflect_silent
  BLAST 0
END

