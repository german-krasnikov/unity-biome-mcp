SURFACE tools
# One block per tool, by name (dsl/README.md). TOOL: Unity handles it; PYTOOL: only the Python server implements it (direct_only).
# INTERNAL <name> <RO|RW> "<what it is>": a wire command that is no MCP tool; it has a ToolSpec (timeout, flags) and nothing else.
# TOOL <name> <CATEGORY> <effect> "<summary>": RO read-only | RW writes | RW_IDEM writes, safe to repeat | DEL destructive
# (ToolSpec.mutability, MCP annotation); the summary is the first line of the description. FORWARD: the MCP wrapper is generated, its
# description is the summary and the DOC lines, one per line. FLAG (core tier1 direct_only unity_transport), RUNTIME (runtime_only),
# TIMEOUT <s>: ToolSpec fields.
# MAXCHARS <n>: the response limit of the Unity registration (maxResponseChars), checked against it by test_catalog_vs_csharp.py.
# ARG <name> <type> [DEFAULT <v> [OMIT]] [DEFAULT_TEXT "<s>" [OMIT]] [RAW] ["<schema description>"]: in the order of the Python signature,
# required without a default; the type is str int float bool, o-prefixed when None is allowed, or Any (checked by name and default only:
# Context, Literal, ...); OMIT: a value equal to the default is not sent, Unity applies it; RAW: a FORWARD wrapper sends the value as it is.
# READ <action>: an action of this tool that only reads (any other action, or none, is a write). isMutating asks it: the Python side's ACTION_READS
# (tools/generated/catalog_reads.py) and the C# side's ActionReads.IsRead (Editor/Generated/ActionReads.g.cs) are printed from these lines.

TOOL alias_status SYSTEM RO "Check alias table health: loaded/empty/stale, sources, and total alias count."
  HANDLER register "CommandRouter.ExecAliasStatus"
  GUARD compile
  FORWARD
END

TOOL analyze_lod_culling MEDIA RO "LOD group coverage + occlusion culling analysis."
  HANDLER register "CommandRouter.ExecAnalyzeLodCulling"
  FORWARD
  DOC "focus: lod|culling|occlusion|null=all."
  ARG focus ostr DEFAULT None
END

TOOL animation MEDIA RW "Animate GameObject properties via AnimationClip. Use when you need to read or author keyframe animation on a specific object (not an Animator state machine — use `animator` for that, not this)."
  FORWARD
  DOC "action: get (list clips/keys) | create (new AnimationClip on object) | edit (add/replace keyframes; add_key/remove_key/remove_curve/set_keys/set_loop are the same edit) | preview (scrub to time) | add_event | remove_event | get_events | set_wrap (keys='loop'|'once'|'pingpong'|'clamp') | set_framerate (keys='30') | get_clip_path (returns asset path)."
  DOC "clip=clip name, keys='t:0 v:(0,0,0); t:1 v:(0,2,0)', property=e.g. localPosition.x."
  DOC "component_type: Unity component to animate (default: Transform). Examples: Light, Camera, Rigidbody."
  DOC "binding_path: sub-object path for EditorCurveBinding (e.g. 'Head/Jaw'). Default '' = root."
  DOC "tangent: tangent mode for keyframes: auto (default) | smooth | linear | constant."
  DOC "function_name: method name for add_event. int_param/float_param/string_param: event parameters."
  ACTION get
  ACTION create
  ACTION edit
  ACTION add_key
  ACTION remove_key
  ACTION remove_curve
  ACTION set_keys
  ACTION set_loop
  ACTION set_wrap
  ACTION set_framerate
  ACTION preview
  ACTION get_clip_path
  ACTION get_events
  ACTION add_event
  ACTION remove_event
  ARG action str EXAMPLE "get"
  ARG path str EXAMPLE "/Main Camera"
  ARG clip ostr DEFAULT None
  ARG clip_name ostr DEFAULT None
  ARG property ostr DEFAULT None
  ARG keys ostr DEFAULT None
  ARG time ofloat DEFAULT None RAW
  ARG component_type ostr DEFAULT None
  ARG binding_path ostr DEFAULT None
  ARG tangent ostr DEFAULT None
  ARG function_name ostr DEFAULT None
  ARG int_param oint DEFAULT None RAW
  ARG float_param ofloat DEFAULT None RAW
  ARG string_param ostr DEFAULT None
  ARG compact bool DEFAULT False OMIT
  READ get
  READ get_clip_path
  READ get_events
  TAG reflect_noerror
  TAG schema_keep_full
END

TOOL animator MEDIA RW "Animator Controller — state machine. Modifies animator assets. No confirmation required. (use `animation` for keyframe clips, `timeline` for cinematics). action: get|add_param|add_state|add_transition|set_default|remove|add_blend_tree|edit_blend_tree|get_blend_tree|add_layer|remove_layer|rename_layer|set_layer_weight|set_layer_blending|set_state_speed|update_transition|set_avatar|rename_state|rename_param."
  HANDLER register "CommandRouter.ExecAnimatorConsolidated"
  BODY animation
  DOC "params='Speed:float:0; Jump:trigger'. states='Idle:Idle.anim; Walk'."
  DOC "conditions='Speed>0.1; IsGrounded'. source/target=state names (*=AnyState)."
  DOC "blend_type: 1d|2d_simple|2d_freeform|2d_cartesian|direct."
  DOC "param/param_y: blend parameters (auto-created as float if missing)."
  DOC "children: '(1D) Idle:0; Walk:0.5; Run:1' or '(2D) Idle:0,0; Walk:0,1'."
  DOC "edit_action: add_child|remove_child|set_thresholds|set_param|set_type."
  DOC "layer: layer index (int) for add_state/add_transition/set_default, or name/index string for CRUD ops."
  DOC "weight: defaultWeight for add_layer/set_layer_weight (0.0–1.0)."
  DOC "blending: Override|Additive for add_layer/set_layer_blending."
  DOC "value: speed multiplier for set_state_speed. avatar_path: asset path for set_avatar."
  ARG action str
  ARG path str EXAMPLE "/Main Camera"
  ARG state ostr DEFAULT None
  ARG states ostr DEFAULT None
  ARG params ostr DEFAULT None
  ARG source ostr DEFAULT None
  ARG target ostr DEFAULT None
  ARG conditions ostr DEFAULT None
  ARG duration ofloat DEFAULT None
  ARG exit_time ofloat DEFAULT None
  ARG has_exit_time obool DEFAULT None
  ARG type ostr DEFAULT None
  ARG name ostr DEFAULT None
  ARG blend_type ostr DEFAULT None
  ARG param ostr DEFAULT None
  ARG param_y ostr DEFAULT None
  ARG children ostr DEFAULT None
  ARG edit_action ostr DEFAULT None
  ARG layer Any DEFAULT None
  ARG weight ofloat DEFAULT None
  ARG blending ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG avatar_path ostr DEFAULT None
  READ get
  READ get_blend_tree
  TAG reflect_noerror
  TAG schema_keep_full
END

PYTOOL animator_intent SYSTEM RW "Convert NL intent to Unity Animator Controller setup via DSL."
  BODY animator_intent_tool
  DOC "dry_run=True returns the batch plan without executing it."
  ARG target str
  ARG intent str
  ARG dry_run bool DEFAULT False
  TAG reflect_silent
END

PYTOOL apply_scene_change SCENE RW "Execute scene mutations with atomic apply, post-verify, and optional save."
  CARD generic
  BODY transaction
  DOC "1. Validate plan_id exists and not expired (TTL 600s)"
  DOC "2. Reject empty input and commands outside the Unity-Undo-safe scene allowlist"
  DOC "3. Execute an atomic, stop-on-error batch"
  DOC "4. On batch failure/rollback: stop without verification or save"
  DOC "5. If verify: require clean references and console before save"
  DOC "6. If save: save only after a successful batch and verification"
  DOC "7. Return applied, verified, and saved states separately"
  DOC "Allowed commands: attach_uitk, auto_wire, autofit_collider, create_object,"
  DOC "create_ui, delete_object, manage_component, rename_object, set_active,"
  DOC "set_parent, set_property, set_property_delta, set_rect, set_sibling_index,"
  DOC "unwire_event, wire_event. Use batch for all other command types."
  FLAG tier1
  TIMEOUT 120.0
  ARG plan_id str
  ARG commands str
  ARG verify bool DEFAULT True
  ARG save bool DEFAULT True
  TAG reflect_noerror
END

PYTOOL apply_template SYSTEM RW "Apply a scene template (.cs file from .claude/templates/)."
  BODY skills
  DOC "params: comma-separated key=value pairs for ${key} replacement."
  DOC "Example: apply_template('level_setup', 'player_pos=(0,0,0),count=3')"
  ARG name str "Saved scene-template identifier from .claude/templates (without .cs)"
  ARG params ostr DEFAULT None
  TAG reflect_silent
END

PYTOOL ask SYSTEM RO "Answer a read-only question about the Unity scene (AI-routed, not interactive — use `ask_user` to show a UI card and wait for user input)."
  BODY ask_tool
  DOC "Routes to deterministic tool plans for common patterns,"
  DOC "uses Haiku summarization for complex multi-tool results."
  ARG question str
END

TOOL ask_user SYSTEM RO "Show a question card in Unity chat; wait for user answer (interactive UI — use `ask` for read-only AI scene questions instead)."
  GUARD always
  GUARD compile
  FORWARD
  FLAG direct_only
  FLAG unity_transport
  TIMEOUT 300.0
  DOC "questions: JSON array matching AskUserQuestion schema:"
  DOC "[{\"question\":\"...\",\"header\":\"...\",\"options\":[{\"label\":\"...\"}],\"multiSelect\":false}]"
  DOC "Returns JSON map of question→answer (or free text if Other field used)."
  DOC "Use this instead of AskUserQuestion for in-Unity interactive prompts."
  ARG questions str
END

TOOL asset ASSETS RW "Asset database. Creates, moves, or deletes assets. No confirmation required. action: find|get_info|create|move|validate_move|duplicate|delete|get_dependencies|find_dependents|import_settings|export_package|import_package|read_text|write_text|reimport. find: type+name+folder+labels. create: type=Folder|Material|PhysicMaterial|AnimatorController|ScriptableObject (class= required for SO). move/validate_move: source+dest (Assets/ paths). Moves .meta correctly. validate_move path_only=True: syntax check only, skips AssetDatabase folder existence check (preflight). get_dependencies: forward deps. find_dependents: reverse deps (who references this asset). export_package: path+output[+include_deps=false to skip deps]. import_package: path (filesystem). read_text: path. write_text: path+content. reimport: path."
  BODY asset
  ACTION find
  ACTION get_info
  ACTION create
  ACTION move
  ACTION validate_move
  ACTION duplicate
  ACTION delete
  ACTION get_dependencies
  ACTION find_dependents
  ACTION import_settings
  ACTION export_package
  ACTION import_package
  ACTION read_text
  ACTION write_text
  ACTION reimport
  ARG action str EXAMPLE "find"
  ARG path ostr DEFAULT None "Action-specific project asset/package path (usually Assets/...; import_package accepts a package file path)"
  ARG type ostr DEFAULT None "Unity asset type filter or create kind (for example Material or ScriptableObject)"
  ARG name ostr DEFAULT None "Asset-name search filter used by find (not a GameObject name)"
  ARG folder ostr DEFAULT None
  ARG source ostr DEFAULT None
  ARG dest ostr DEFAULT None
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None "Import-setting/property value for the selected asset action"
  ARG recursive bool DEFAULT False
  ARG labels ostr DEFAULT None
  ARG output ostr DEFAULT None
  ARG include_deps bool DEFAULT True
  ARG content ostr DEFAULT None
  ARG class_name ostr DEFAULT None WIRE "class"
  ARG path_only bool DEFAULT False
  READ find
  READ find_dependents
  READ get_dependencies
  READ get_info
  READ validate_move
  TAG reflect_noerror
END

TOOL attach_uitk UITOOLKIT RW "Attach UIDocument (or PanelRenderer on Unity 6.4+) to a GameObject (use for UI Toolkit runtime panels)."
  HANDLER register "CommandRouter.ExecAttachUITK"
  FORWARD
  DOC "Side effect: mutates the scene by adding one Undo-recorded UIDocument after validating"
  DOC "every supplied asset; it does not create UXML or PanelSettings assets."
  DOC "path: scene path to the target GameObject."
  DOC "uxml: Assets/ path to .uxml VisualTreeAsset (optional; component added without VTA if omitted)."
  DOC "panel_settings: optional Assets/ path to a PanelSettings asset; omitted leaves the field unset."
  DOC "sort_order: UIDocument.sortingOrder (default 0; ignored on Unity 6.4+ PanelRenderer)."
  DOC "err: if UIDocument or PanelRenderer already present — remove it first or use inspect_uitk/uitk_element."
  DOC ""
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG uxml ostr DEFAULT None
  ARG panel_settings ostr DEFAULT None
  ARG sort_order oint DEFAULT None RAW
  TAG atomic_scene
  TAG reflect_silent
END

PYTOOL auto_fix SYSTEM RO "Analyze recent Unity errors and ask MCP client sampling for a fix suggestion."
  ARG ctx Any
END

TOOL auto_wire COMPONENTS RW "Fill null ObjectReference fields on a GameObject by matching field name or type to scene objects. Mutates scene when dry_run=False. No confirmation required."
  HANDLER register "CommandRouter.ExecAutoWire"
  FORWARD
  DOC "dry_run=true previews without applying. Returns wired/ambiguous/no-match summary."
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG dry_run bool DEFAULT False OMIT
  TAG atomic_scene
  EXPECT token "Wired:"
END

TOOL autofit_collider SCENE RW "Auto-fit collider to mesh/renderer bounds. type: box|sphere|capsule."
  HANDLER register "ColliderFitHelper.Execute"
  FORWARD
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG type str DEFAULT_TEXT "box" "Collider shape to fit: box|sphere|capsule"
  TAG atomic_scene
  EXPECT token "fitted"
END

PYTOOL await_compile VERIFY RO "Block until Unity finishes compiling + reloading, then return compile errors."
  DENY
  BODY code_intel
  DOC "Use after writing .cs files instead of sleep. Returns errors or 'compile clean (Xs)'."
  DOC "Handles domain reload disconnects transparently. timeout=0 → immediate check, no loop."
  DOC "Epoch-aware via sync_status when available (+10 from MAJOR-1); falls back to compile_status."
  FLAG tier1
  ARG timeout float DEFAULT 60.0
  ARG expected_generation oint DEFAULT None
END

TOOL bake ASSETS RW "Bake operations."
  HANDLER register "CommandRouter.ExecBake"
  FORWARD
  DOC "target: lighting|occlusion."
  DOC "action (lighting): start(default)|status|cancel|clear|settings."
  DOC "action (occlusion): start(default)|status|clear."
  DOC "Poll status after start — lighting bake is async."
  ARG target str
  ARG action ostr DEFAULT None
  READ settings
  READ status
  TAG reflect_noerror
END

# timeout_s live for 9 internal _send("batch",...) callers w/o explicit timeout
# (animator_intent_tool.py:119, skills.py:61, autobatch.py:69/98/136,
# ui_intent_tool.py:152, debug_tool.py:78, do_intent/executor.py:38/67).
# Public batch() tool always overrides -- see tools/batch.py timeout param.
TOOL batch CORE RW "Execute multiple commands in one call. Use for 2+ ops — reads AND writes. commands: one per line (cmd key=value). on_error: continue|stop (default continue). timeout: seconds (default 75; inner soft-timeout capped at 60s). atomic: reverts prior Undo-recorded mutations on failure; external/file/asset/package/process effects may remain. PREFER over individual tool calls."
  CARD generic
  NEXT "get_console level=Error"
  DENY
  BODY batch
  GUARD compile
  FLAG core
  TIMEOUT 120.0
  VERB "Running batch"
  ARG commands str EXAMPLE "get_status" "One command per line (e.g. 'get_component path=/Player type=Transform')"
  ARG on_error str DEFAULT_TEXT "continue" "Error behavior: continue (default) | stop — stop aborts remaining commands"
  ARG timeout float DEFAULT 75.0 LOCAL "Total timeout in seconds (default 75)"
  ARG atomic bool DEFAULT False "On failure, revert prior Undo-recorded Unity mutations; external/file/asset/package/process effects may remain"
  ARG validate_aliases bool DEFAULT False "Dry-run alias validation before executing any mutations"
  TAG distill_skip
  TAG reflect_custom
  BLAST 3
END

PYTOOL brief_build SYSTEM RO "Use to get a snapshot of project state before starting work."
  BODY brief_tool
  DOC "Returns compact text block with requested context within token budget."
  DOC "kinds: comma-separated subset of: console, compile_errors, hierarchy, selection, profiler"
  DOC "budget: max token estimate (default 2000; 1 token ≈ 4 chars)"
  ARG kinds str DEFAULT_TEXT "console,compile_errors,hierarchy"
  ARG budget int DEFAULT 2000
END

PYTOOL budget_status SYSTEM RO "Returns Haiku cost: session/cap/day/skipped features. Text format."
  BODY budget_tool
END

TOOL build SYSTEM RW "Build player. action: build."
  HANDLER register_async "CommandRouter.AsyncBuild"
  DENY
  GUARD play_ok
  FORWARD
  FLAG direct_only
  FLAG unity_transport
  TIMEOUT 300.0
  DOC "target: StandaloneWindows64|StandaloneOSX|Android|iOS|WebGL (default: active)."
  DOC "scenes: comma-sep asset paths (default: Build Settings list)."
  DOC "path: output path (default: Builds/<target>)."
  DOC "dev: development build flag."
  ARG action str
  ARG target ostr DEFAULT None
  ARG scenes ostr DEFAULT None
  ARG path ostr DEFAULT None "Player build output file or directory (default Builds/<target>)"
  ARG dev bool DEFAULT False OMIT
  TAG reflect_silent
END

TOOL cancel_test_run TESTS RW_IDEM "Request cancellation of one exact test run; cancellation is asynchronous."
  HANDLER register "CommandRouter.ExecCancelTestRun"
  GUARD always
  GUARD compile
  GUARD play_ok
  WIRE no_undo
  FORWARD
  TIMEOUT 10.0
  ARG run_id str EXAMPLE "__seam_nonexistent"
  TAG reflect_silent
END

TOOL check_colliders SCENE RO "Check collider issues: triggers without Rigidbody, negative scale, micro colliders. Scans whole scene if no path given."
  HANDLER register "CommandRouter.ExecCheckColliders"
  FORWARD
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
END

TOOL checkpoint SYSTEM RW "Create a named Undo checkpoint. Use before major scene changes. Allows rollback via Ctrl+Z in Unity."
  HANDLER register "CommandRouter.ExecCheckpoint"
  GUARD play_ok
  WIRE no_undo
  FORWARD
  ARG label str DEFAULT_TEXT "checkpoint"
  TAG reflect_noerror
  TAG schema_keep_full
END

# T19: Python orchestrator, no C# handler
PYTOOL checkpoint_create SYSTEM RW "Create a durable checkpoint before an agent turn."
  BODY checkpoint_tool
  DOC "paths: comma-separated file paths to snapshot. Empty = open dirty scenes."
  ARG paths str DEFAULT_TEXT ""
  TAG reflect_silent
END

# T19: Python orchestrator, no C# handler
PYTOOL checkpoint_restore SYSTEM DEL "Restore files to their pre-turn state."
  BODY checkpoint_tool
  DOC "Tries Unity Undo first when domain stamp matches; falls back to file restore."
  DOC "MVP: after_refs always empty — no ChangeSet-based conflict detection yet."
  ARG checkpoint_id str
  ARG force bool DEFAULT False
  TAG reflect_silent
END

TOOL compile_preflight VERIFY RO "Validate C# WITHOUT writing/recompiling (Roslyn). Use before writing .cs — catches typos in ~200ms vs 30s recompile."
  HANDLER register "CommandRouter.ExecCompilePreflight"
  BODY code_intel
  DOC "file_path: Assets-relative. new_content: full file. Returns OK preflight (ms) / ERR preflight + diagnostics / [ROSLYN UNAVAILABLE]."
  GUARD compile
  FLAG core
  TIMEOUT 15.0
  ARG file_path str
  ARG new_content str
END

INTERNAL compile_status RO "Compile notifier state plus reload state string; await_compile (code_intel.py) polls it directly, allowedDuringCompile."
  HANDLER register "CommandRouter.ExecCompileStatus"
  GUARD compile
  TAG retry_safe_internal
END

PYTOOL configure_objects SCENE RW "Configure multiple objects at once."
  BODY autobatch
  DOC "Format: /Path component.prop=value [...] per line."
  DOC "Example:"
  DOC "/NPC1 Transform.m_LocalPosition=(1,0,0) Health.maxHp=100"
  DOC "/NPC2 Transform.m_LocalPosition=(3,0,0)"
  ARG config str
  TAG reflect_silent
END

PYTOOL console_mark RUNTIME RO "Create a console watermark. Returns mark_id encoding current timestamp."
  BODY console
  DOC "Pass to get_console_since() to retrieve only logs after this point."
  DOC "Pure Python — no TCP call."
  FLAG tier1
  ARG label str DEFAULT_TEXT ""
END

TOOL create_object CORE RW "Create new GameObject. components: comma-separated types to add on creation. primitive: Cube|Sphere|Cylinder|Capsule|Plane|Quad. prefab_path: instantiate from prefab asset. scene: create in named loaded scene (omit = active scene)."
  HANDLER register "CommandRouter.ExecCreateObject"
  CARD create
  NEXT "get_hierarchy depth=1"
  FORWARD
  FLAG core
  VERB "Creating"
  ARG name str EXAMPLE "__seam_surface_probe" ROLE name "Name for the new GameObject"
  ARG parent ostr DEFAULT None "Scene path of the parent (omit = scene root)"
  ARG components ostr DEFAULT None "Comma-separated component types to add on creation (e.g. 'Rigidbody,BoxCollider')"
  ARG primitive ostr DEFAULT None "Primitive mesh type: Cube|Sphere|Cylinder|Capsule|Plane|Quad"
  ARG prefab_path ostr DEFAULT None "Asset path to instantiate from prefab (e.g. Assets/Prefabs/Enemy.prefab)"
  ARG scene ostr DEFAULT None "Target scene name when multiple scenes are loaded (omit = active scene)"
  TAG atomic_scene
  TAG distill_skip
  TAG do_allowed
  TAG reflect_custom
  BLAST 2
END

TOOL create_ui UGUI RW "Create UI element with smart defaults. type: Canvas|Panel|Button|Text|Image|Toggle|Slider|InputField|ScrollView. Auto-creates Canvas if needed. render_mode: SSO (ScreenSpaceOverlay, default)|SSC (ScreenSpaceCamera)|WorldSpace. font_min/font_max: enable TMP autoSizing for Text type."
  HANDLER register "CommandRouter.ExecCreateUI"
  FORWARD
  ARG type str EXAMPLE "Button" "uGUI element type: Canvas|Panel|Button|Text|Image|Toggle|Slider|InputField|ScrollView"
  ARG name ostr DEFAULT None
  ARG parent ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
  ARG anchor ostr DEFAULT None
  ARG pos ostr DEFAULT None
  ARG size ostr DEFAULT None
  ARG pivot ostr DEFAULT None
  ARG color ostr DEFAULT None
  ARG text ostr DEFAULT None
  ARG font_size ostr DEFAULT None
  ARG render_mode ostr DEFAULT None
  ARG font_min ostr DEFAULT None
  ARG font_max ostr DEFAULT None
  TAG atomic_scene
  EXPECT token "Created"
END

PYTOOL debug RUNTIME RO "AI-assisted scene debug: gather diagnostic context based on symptom (not compile/reload — use `diagnose` for that; not runtime state — use `debug_animator` or `debug_physics`)."
  BODY debug_tool
  DOC "symptom: Natural language description (\"enemy doesn't move\", \"button not clickable\")"
  DOC "path: Optional target object path (\"/Enemy_01\")"
  DOC "gather: Override comma-separated batch-safe tool names (\"inspect,get_console\")"
  DOC "Returns structured diagnostic text for LLM analysis."
  ARG symptom str DEFAULT_TEXT ""
  ARG path str DEFAULT_TEXT ""
  ARG gather str DEFAULT_TEXT ""
END

TOOL debug_animator RUNTIME RO "[Play Mode] Read Animator state: layers, transitions, parameters (use `debug` for scene; `diagnose` for compile)."
  HANDLER register "CommandRouter.ExecDebugAnimator"
  FORWARD
  RUNTIME
  DOC "path: scene path to GameObject with Animator component."
  ARG path str
END

TOOL debug_physics RUNTIME RO "[Play Mode] Read Rigidbody state, colliders, contacts, and nearby objects (use `debug` for scene; `diagnose` for compile)."
  HANDLER register "CommandRouter.ExecDebugPhysics"
  FORWARD
