TOOL scene SCENE DEL "Scene management. action: new|open|save|discard|open_additive|close|set_active|list|save_copy."
  HANDLER register "CommandRouter.ExecScene"
  BODY scene
  DOC "path: required for open/open_additive/close/set_active/save_copy. For save,"
  DOC "omit it to save to the current path; an untitled scene requires a path."
  DOC "scene: save/discard/save_copy target when multiple scenes loaded (identifies by name)."
  DOC "save_copy: writes current dirty state to path as backup; active scene reference unchanged."
  DOC "include_unsaved: always True — save_copy always captures current in-memory state."
  GUARD play_ok
  WIRE no_undo
  FLAG tier1
  VERB "Managing scene"
  ACTION new
  ACTION open
  ACTION save
  ACTION discard
  ACTION open_additive
  ACTION close
  ACTION set_active
  ACTION list
  ACTION save_copy
  ARG action str EXAMPLE "list" "Operation: new|open|save|discard|open_additive|close|set_active|list|save_copy"
  ARG path ostr DEFAULT None "Asset path — required for open/save/open_additive/close/set_active"
  ARG scene ostr DEFAULT None "Scene name for save/discard when multiple scenes are loaded"
  ARG include_unsaved bool DEFAULT True
  READ list
  TAG reflect_noerror
  BLAST 3
END

