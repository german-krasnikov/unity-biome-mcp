  FORWARD
  DOC "edit: asset_path + component + prop + value (set property on prefab asset)."
  DOC "edit: asset_path + add_component or remove_component (manage components)."
  DOC "save: path (scene) + asset_path [+ mode: new|overwrite (default)]."
  DOC "revert: scope: object (default)|children."
  DOC "get_overrides: format: text (default)|structured."
  DOC "create_variant: base_path + variant_path."
  DOC "instantiate: asset_path (instantiate prefab into active scene)."
  ACTION save
  ACTION create_variant
  ACTION instantiate
  ACTION apply
  ACTION revert
  ACTION get_overrides
  ACTION unpack
  ACTION edit
  ARG action str EXAMPLE "save"
  ARG path ostr DEFAULT None
  ARG asset_path ostr DEFAULT None
  ARG base_path ostr DEFAULT None
  ARG variant_path ostr DEFAULT None
  ARG component ostr DEFAULT None
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG add_component ostr DEFAULT None
  ARG remove_component ostr DEFAULT None
  ARG recursive bool DEFAULT False OMIT
  ARG mode ostr DEFAULT None
  ARG scope ostr DEFAULT None
  ARG format ostr DEFAULT None
  ARG parent ostr DEFAULT None
  ARG child_path ostr DEFAULT None
  READ get_overrides
  TAG reflect_noerror
END

TOOL profile RUNTIME RW "Profile CPU/GPU/memory over time."
  BODY profiling
  DOC "action: start|stop|status|analyze|compare|list_sessions"
  DOC "mode: burst (auto-stop after duration) | manual (explicit stop) | triggered (on spike)"
  DOC "focus: narrow analyze output to gc|rendering|physics|cpu"
  RUNTIME
  ARG action str
  ARG duration float DEFAULT 5.0
  ARG session str DEFAULT_TEXT ""
  ARG compare_with str DEFAULT_TEXT ""
  ARG focus str DEFAULT_TEXT ""
  ARG mode str DEFAULT_TEXT "burst"
  ARG threshold_ms float DEFAULT 33.3
  READ analyze
  READ compare
  READ list_sessions
  READ status
  TAG reflect_silent
END

TOOL project_settings ASSETS RW_IDEM "Project settings. Modifies project settings when action=set. No confirmation required. action: get|set. target: tags|layers|sorting_layers|quality|physics|time|player|graphics|audio|input."
  HANDLER register_action "ProjectSettingsHelper.Execute"
  FORWARD
  DOC "tags set: prop=remove value=<tag> to remove; else adds."
  DOC "quality set prop=currentLevel: calls SetQualityLevel()."
  DOC "player set prop=ScriptingBackend: needs build_target (Standalone|iOS|Android|etc) + value (Mono2x|IL2CPP)."
  ARG action str EXAMPLE "get"
  ARG target str EXAMPLE "tags"
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG index oint DEFAULT None RAW
  ARG build_target ostr DEFAULT None
  READ get
  TAG reflect_noerror
END

TOOL query_state RUNTIME RO "[Play Mode] Snapshot multiple game values in one call."
  HANDLER register "CommandRouter.ExecQueryState"
  BODY runtime
  DOC "queries: comma-separated 'path|component|field_or_method' triplets."
  DOC "Example: query_state('/GridPlayer|GridPlayer|Score,/GridPlayer|GridPlayer|PosX')"
  RUNTIME
  TIMEOUT 10.0
  ARG queries str
  BLAST 0
END

# Every dispatch intentionally starts a fresh AssetDatabase.Refresh. The receiver-side dedup registry is lost
# across Domain Reload, so resending a lost ACK can start a second compile/reload cycle: RW, not RW_IDEM.
TOOL recompile SYSTEM RW "Trigger Unity to reimport C# scripts. Returns immediately; use await_compile to block until done."
  HANDLER register "CommandRouter.ExecRecompile"
  GUARD play_ok
  WIRE no_undo
  FORWARD
  TIMEOUT 60.0
  TAG distill_skip
  TAG do_forbidden
  EXPECT token "ok"
END

PYTOOL reconnect_unity SYSTEM RO "Reconnect to Unity. Port 0 or omitted = auto-discover from port files."
  FLAG tier1
  SESSION
  ARG port int DEFAULT 0
  ARG ctx Any DEFAULT None
  TAG meta_cmd
END

TOOL references COMPONENTS RW "References. action: get|find_to|remap. get: outgoing refs. find_to: reverse search. remap: remap refs."
  FORWARD
  ARG action str EXAMPLE "get"
  ARG path str EXAMPLE "/__seam_nonexistent"
  ARG children bool DEFAULT False OMIT
  ARG depth int DEFAULT 1 OMIT RAW
  ARG source ostr DEFAULT None
  ARG target ostr DEFAULT None
  ARG mappings ostr DEFAULT None
  TAG reflect_noerror
END

TOOL region_clear SCENE RW "Delete (or preview) all objects whose XZ pivot is inside the polygon region. Deletes scene objects when dry_run=False. No confirmation required."
  HANDLER register "CommandRouter.ExecRegionClear"
  BODY spatial
  DOC "vertices: CSV polygon 'x1,z1;x2,z2;...' (>=3 pairs)."
  DOC "dry_run: True = list objects that WOULD be deleted (safe default). False = delete them."
  DOC "filter: optional name-pattern substring; only matching objects are affected."
  DOC "cap: max objects processed (default 50, hard max 200)."
  ARG vertices str EXAMPLE "0,0 1,0 1,1 0,1"
  ARG dry_run bool DEFAULT True
  ARG filter ostr DEFAULT None
  ARG cap int DEFAULT 50
  EXPECT bool_arg "DRY|DELETED" ARG dry_run
END

PYTOOL release_smoke SYSTEM RO "Run release readiness checks: status, aliases, compile. Returns PASS/FAIL summary."
  BODY meta
END

TOOL rename_object SCENE RW_IDEM "Rename a GameObject. Returns new scene path after rename."
  HANDLER register "CommandRouter.ExecRenameObject"
  CARD rename
  FORWARD
  DOC "path: current scene path, &ref (e.g. &1) or $hexId (legacy), #instanceID (legacy). name: new name (non-empty)."
  DOC "Note: all subsequent MCP calls must use the new path."
  ARG path str EXAMPLE "/__seam_nonexistent" ROLE target
  ARG name str EXAMPLE "__seam_renamed" ROLE newname
  TAG atomic_scene
  TAG reflect_custom
END

TOOL render_analyze MEDIA RO "Rendering analysis."
  FORWARD
  ACTION stats
  ACTION materials
  ACTION shaders
  ACTION overdraw
  ACTION audit
  ACTION compare
  ACTION batching
  ACTION lights
  ACTION shadow_audit
  ACTION probe_audit
  ACTION light_optimize
  ACTION frame_debug
  DOC "action: stats|materials|shaders|lights|batching|overdraw|audit|compare"
  DOC "        |frame_debug|shadow_audit|probe_audit|light_optimize"
  DOC "stats: draw calls, batches, tris, verts, set-pass from UnityStats."
  DOC "batching: SRP Batcher / static / dynamic / GPU instancing analysis."
  DOC "audit: full rendering health check (all sections, brief)."
  DOC "compare: diff against last baseline snapshot."
  DOC "frame_debug: per-draw-call data via FrameDebugger reflection (pauses rendering briefly)."
  DOC "detail: brief (default) | full.  path: optional subtree root."
  ARG action str
