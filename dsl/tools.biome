TOOL material ASSETS RW "Material asset management (for quick color change use `set_material`). action: create|get|set|copy|list_properties|list_slots|get_errors|list_shaders|set_fields. create: path+shader. get/set: path (asset) or object_path (scene). copy: source+targets (comma-sep scene paths). slot: material slot index (default 0). list_slots: object_path. get_errors: path (shader asset). list_shaders: filter (optional name filter). set_fields: path+value (newline-separated prop=val). set target: shared|instance|asset (default shared)."
  HANDLER register_action "MaterialHelper.Execute"
  FORWARD
  ARG action str EXAMPLE "get"
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
  ARG object_path ostr DEFAULT None
  ARG shader ostr DEFAULT None
  ARG prop ostr DEFAULT None
  ARG value ostr DEFAULT None
  ARG source ostr DEFAULT None
  ARG targets ostr DEFAULT None
  ARG slot oint DEFAULT None RAW
  ARG filter ostr DEFAULT None
  ARG target ostr DEFAULT None
  READ get
  READ get_errors
  READ list_properties
  READ list_shaders
  READ list_slots
  TAG reflect_noerror
END

