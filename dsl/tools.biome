TOOL resolve_test_request TESTS RO "Resolve a possibly lost start ACK without dispatching another test run."
  HANDLER register "CommandRouter.ExecResolveTestRequest"
  BODY testing
  GUARD compile
  TIMEOUT 10.0
  ARG request_id str EXAMPLE "__seam_nonexistent"
END

PYTOOL resolve_tool_schema SYSTEM RO "Return full parameter schemas for deferred tools. tools=comma-separated names."
  BODY meta
  FLAG tier1
  ARG tools str
END

# timeout_s is a fallback ceiling only -- tools/runtime.py always passes
# timeout+20.0 explicitly.
# B05/R-05: runtime_only intentionally NOT set here — C#'s CommandRouter.Registration.cs
# registration (runtime: false) is the sole authority now that the Play-mode gate moved
# past parsing into AsyncRunPlaytest's own `# @needs editmode` header check. A static
# True here would reintroduce a second, stale Python-only authority (see
# test_runtime_only_single_source).
TOOL run_playtest TESTS RW "[Play Mode] Execute a playtest DSL script. Returns structured report (for NUnit tests, use `run_tests`)."
  DENY
  BODY runtime
  DOC "Commands: MOVE TO x,y,z | WAIT n | WAIT_UNTIL query op value | ASSERT query op value |"
  DOC "ASSERT_CONSOLE_CLEAN [IGNORE \"pat\"] | SNAPSHOT queries | INVOKE path comp method args |"
  DOC "SET path comp field value | LOG msg | TIMESCALE n | ASSERT_CONSERVED SUM a+b OVER t |"
  DOC "ASSERT_CTA VISIBLE|CLICKABLE | VAL name query | TELEPORT path x,y,z |"
  DOC "ASSERT_BATCH...END | ASSERT_NEAR pathA pathB dist | INVARIANT query op value |"
  DOC "SIMULATE name [DURATION n] [TIMESCALE n] | MONITOR name | TRACE_FLOW FROM a TO b FIELD f |"
  DOC "CAPTURE label query | ASSERT_CAPTURED label INCREASED|DECREASED."
  DOC "defs: inline VAL definitions prepended to script."
  DOC "abort_on_fail=True: stop after the first failed step or automatic console failure; skip all remaining steps including teardown."
  DOC "format=\"json\": return the canonical step-ledger receipt instead of the legacy text report; skips compression/summarization."
  DOC "Non-pass outcomes (fail/aborted/malformed/empty) raise ToolError with the full report text (both sync and async routes)."
  GUARD play_ok
  FLAG tier1
  FLAG direct_only
  FLAG unity_transport
  TIMEOUT 300.0
  VERB "Playtesting"
  ARG script ostr DEFAULT None "Inline DSL script (mutually exclusive with path)"
  ARG timeout float DEFAULT 120.0 "Max seconds to wait for the playtest to finish (default 120)"
  ARG abort_on_fail bool DEFAULT False "Stop after the first failed step or automatic console failure; remaining steps, including teardown, are skipped"
  ARG defs ostr DEFAULT None "Inline VAL definitions prepended to script (alias block)"
  ARG path ostr DEFAULT None "Path to .playtest DSL file on disk (mutually exclusive with script)"
  ARG snapshot_on_failure bool DEFAULT False "Auto-capture screenshot on first ASSERT failure"
  ARG fresh bool DEFAULT False "Stop and restart Play Mode before running the script"
  ARG before_hook ostr DEFAULT None "DSL commands to run before entering Play Mode"
  ARG after_hook ostr DEFAULT None "DSL commands to run after Play Mode exits"
  ARG format str DEFAULT_TEXT "text"
  TAG playtest_scenario
  TAG reflect_silent
  TAG scene_state_neutral
END

PYTOOL run_playtest_suite TESTS RW "Run multiple .playtest files sequentially and return a compact matrix."
  BODY runtime
  DOC "Side effects: auto_play/restart_between may enter or restart Play Mode;"
  DOC "stop_after exits Play Mode. No confirmation is requested."
  DOC "pattern: glob pattern (e.g. 'Playtests/*.playtest'), comma-separated list,"
  DOC "         or newline-separated list of project-relative paths."
  DOC "suite_path: absolute path to a .suite file (lines = project-relative .playtest paths, # = comment)."
  DOC "Exactly one of pattern or suite_path must be provided."
  DOC "stop_on_fail=True: abort suite after first failure."
  DOC "stop_after=True: exit Play Mode when suite completes."
  DOC "auto_play=True: enter Play Mode automatically if not already playing."
  DOC "restart_between=True: stop+play between each file to reset runtime state;"
  DOC "with auto_play=True, also resets an already-running editor before file one."
  DOC "suite_timeout: total suite wall-clock deadline in seconds (default 300s)."
  DOC "tag: only run files whose `# @tags` header (space-separated) includes this"
  DOC "tag; matches after pattern/suite_path resolution. A tag that matches zero"
  DOC "files fails closed (same shape as an empty pattern/suite match), it never"
  DOC "silently runs the unfiltered set."
  DOC "Lifecycle commands must return successfully and reach their observed state."
  DOC "A failed transition stops the suite and is reported as a failed row."
  DOC "Empty matches return a failing SUITE: 0/0 report."
  DOC "Output: SUITE: X/Y passed (Zs) terminal:true play_stopped:true/false + per-file lines."
  FLAG tier1
  TIMEOUT 3600.0
  ARG pattern ostr DEFAULT None
  ARG suite_path ostr DEFAULT None
  ARG timeout_per_test float DEFAULT 120.0
  ARG stop_on_fail bool DEFAULT False
  ARG stop_after bool DEFAULT True
  ARG auto_play bool DEFAULT False
  ARG restart_between bool DEFAULT False
  ARG suite_timeout float DEFAULT 300.0
  ARG tag ostr DEFAULT None
  TAG playtest_scenario
  TAG reflect_silent
  TAG scene_state_neutral
END

# The bridge may retry run_tests only because every retry carries the same durable request_id (RW_IDEM);
# run_tests_wait is a composite operation, not idempotent (RW).
TOOL run_tests TESTS RW_IDEM "Dispatch Unity tests and return their durable identity immediately."
  DENY
  BODY testing
  DOC "A successful response is"
  DOC "``tests-started|request_id=...|run_id=...|utf_guid=...|state=dispatched``."
  DOC "If transport fails after dispatch may have happened, the result is"
  DOC "``START-UNKNOWN`` with the same request_id; resolve it instead of retrying"
  DOC "with a new identity."
  DOC "assemblies/categories/tests: comma-separated selection lists narrowing"
  DOC "the run (assembly names, NUnit categories, fully-qualified test names)."
  DOC "group: a named test group to restrict the run to."
  GUARD play_ok
  FLAG tier1
  FLAG direct_only
  FLAG unity_transport
  VERB "Running tests"
  ARG mode str DEFAULT_TEXT "EditMode" "Test runner mode: EditMode or PlayMode"
  ARG filter ostr DEFAULT None "NUnit filter expression (e.g. 'MyNamespace.MyTest')"
  ARG request_id ostr DEFAULT None "Caller-supplied idempotency ID — reuse to retry a failed dispatch without double-running"
  ARG assemblies ostr DEFAULT None "Comma-separated assembly names to restrict the run to"
  ARG categories ostr DEFAULT None "Comma-separated NUnit category names to restrict the run to"
  ARG group ostr DEFAULT None "Named test group to restrict the run to"
  ARG tests ostr DEFAULT None "Comma-separated fully-qualified test names to restrict the run to"
  TAG reflect_silent
END

PYTOOL run_tests_wait TESTS RW "Dispatch tests and wait for the exact run to become terminal. Dispatches test run. No confirmation required."
  BODY testing
  DOC "Transport failures and domain reloads do not erase the last snapshot. A"
  DOC "caller timeout is observational only: it returns ``TIMEOUT`` with request,"
  DOC "run and snapshot data and never marks the Unity run complete."
  DOC "on_timeout: result starts with TIMEOUT|request_id=...|run_id=... — use run_id to resume polling via get_test_run without re-dispatching."
  FLAG tier1
  TIMEOUT 1200.0
  ARG mode str DEFAULT_TEXT "EditMode" "Test runner mode: EditMode or PlayMode"
  ARG filter str DEFAULT_TEXT "" "NUnit filter expression (e.g. 'MyNamespace.MyTest')"
  ARG timeout float DEFAULT 900.0 "Max seconds to wait for completion (default 900)"
  ARG poll_interval float DEFAULT 5.0 "Seconds between status polls (default 5)"
  ARG request_id ostr DEFAULT None "Caller-supplied idempotency ID"
  TAG reflect_silent
END

TOOL runtime_snapshot RUNTIME RO "Snapshot all runtime objects of a given component type. Returns per-object field dump."
  HANDLER register "CommandRouter.ExecRuntimeSnapshot"
