TOOL delete_object SCENE DEL "Delete GameObject by instance ID or scene path. Deletes scene objects. No confirmation required. Provide one. force=True to delete non-empty containers."
  HANDLER register "CommandRouter.ExecDeleteObject"
  CARD delete
  NEXT "get_hierarchy depth=1"
  BODY objects
  FLAG tier1
  VERB "Deleting"
  ARG id oint DEFAULT None "Instance ID of the GameObject to delete (from get_hierarchy)"
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent" ROLE target "Scene path of the GameObject to delete"
  ARG force bool DEFAULT False "True to delete non-empty container objects without error"
  TAG atomic_scene
  TAG distill_skip
  TAG do_forbidden
  BLAST 4
  EXPECT token "deleted" STRICT
END

TOOL diagnose VERIFY RO "Read Unity compile/reload fact-signals atomically; returns typed verdict. For scene symptom analysis, use `debug`. For runtime component state, use `debug_animator` or `debug_physics`."
  BODY diagnose
  DOC "prev_mvid: MVID from before a sync operation. When provided, enables STALE-DOMAIN"
  DOC "detection (unchanged MVID after intended recompile). Pass '' for standalone probing."
  DOC "expected_compile: True when a compile was explicitly triggered (default)."
  DOC "False for Bee cache-hit / will_compile=false / reverted-edit probes — prevents"
  DOC "false STALE-DOMAIN on legitimately-frozen MVID (A5/G27)."
  DOC "Returns: CLEAN-LIVE / FAIL:<CS> / STALE-DOMAIN / WEDGE-ENGINE / WEDGE-STATE /"
  DOC "         BUILD-FAILED-WEDGE / STALE-CACHE / TESTS-INVISIBLE / REBUILDING /"
  DOC "         NO-OP / UNKNOWN"
  GUARD always
  GUARD compile
  ARG prev_mvid str DEFAULT_TEXT "" LOCAL
  ARG expected_compile bool DEFAULT True LOCAL
END

PYTOOL discover_tools SYSTEM RO "Find and enable tools by category."
  FLAG tier1
  SESSION
  ARG category ostr DEFAULT None
  ARG enable bool DEFAULT True
  ARG include_legacy bool DEFAULT False
  ARG structured bool DEFAULT False
  ARG ctx Any DEFAULT None
  TAG meta_cmd
END

PYTOOL do SYSTEM RW "Convert natural language intent into Unity scene operations. Use when scene structure unknown or task is ambiguous. NOT for targeted mutations on known objects — use batch directly."
  BODY do_tool
  DOC "Haiku generates a batch DSL plan, which is validated then executed."
  DOC "dry_run=True returns the plan without executing it."
  ARG intent str
  ARG dry_run bool DEFAULT False
  TAG reflect_silent
END

# Conditional: default is observational; fix=True removes stale local files.
# middleware_types.is_write() handles the argument-aware classification.
# Conservative effect: fix=True may remove stale local files. Runtime read-only enforcement remains
# argument-aware in doctor() itself.
PYTOOL doctor SYSTEM RW "Run health diagnostics. fix=True removes safe stale port/lock files."
  BODY meta
  ARG fix bool DEFAULT False
  TAG reflect_silent
END

TOOL editor CORE RW "Editor state/control. action: state|play|pause|stop|select|project_path|mutation_mode."
  HANDLER register "CommandRouter.ExecEditor"
  BODY editor_control
  DOC "select: path (single) or paths (comma-sep multi, e.g. \"/Player,/Enemy,/NPC\")."
  DOC "mutation_mode: omit enable to query current intent; enable=True/False to set it."
  GUARD play_ok
  WIRE no_undo
  FLAG core
  ACTION state
  ACTION mutation_mode
  ACTION play
  ACTION pause
  ACTION stop
  ACTION select
  ACTION project_path
  ARG action str DEFAULT_TEXT "state" EXAMPLE "state"
  ARG path ostr DEFAULT None
  ARG paths ostr DEFAULT None
  ARG enable obool DEFAULT None
  READ project_path
  READ state
  TAG reflect_silent
END

TOOL execute_code SYSTEM RW "Execute C# code in Unity Editor via Roslyn. 10-40x faster than recompile."
  HANDLER register "CommandRouter.ExecExecuteCode"
  DENY
  GUARD compile
  FORWARD
  FLAG core
  TIMEOUT 60.0
  DOC "Security uses a configurable source-pattern scan; the default AllowAll level skips it. Execution is not sandboxed."
  DOC "Bare statements are auto-wrapped in a static class — no boilerplate needed."
  DOC "Example: \"var go = new GameObject(\\\"Test\\\"); return go.name;\""
  ARG code str "C# code to execute in the Unity Editor context"
  ARG undo_label str DEFAULT_TEXT "execute_code" "Label for the Undo group entry (default 'execute_code')"
  TAG distill_skip
  TAG do_forbidden
  TAG reflect_silent
  BLAST 5
END

INTERNAL export_package RW "Protocol name of the asset action export_package; only its timeout is used, Unity registers no command of this name."
  TIMEOUT 120.0
  TAG reflect_silent
END

TOOL export_playtest_aliases_to_defs TESTS RW "Export PlaytestConfig.asset aliases to a readable .defs text file."
  HANDLER register "CommandRouter.ExecExportToDefs"
  GUARD play_ok
  WIRE no_undo
  FORWARD
  DOC "asset: asset path to PlaytestConfig (default: Assets/Configs/PlaytestConfig.asset)."
  DOC "defs: project-relative output path (default: Assets/PlaytestDefs/farm_core.defs)."
  ARG asset str DEFAULT_TEXT "Assets/Configs/PlaytestConfig.asset"
  ARG defs str DEFAULT_TEXT "Assets/PlaytestDefs/farm_core.defs"
  TAG reflect_noerror
END

TOOL find_objects SCENE RO "Find objects by criteria. Use search_scene for complex queries. Does NOT support: parent, path, active/inactive filtering, regex. Only: name (substring), tag, layer, component (full namespace)."
