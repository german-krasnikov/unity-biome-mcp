TOOL inspect CORE RO "Get components for multiple objects at once. paths: comma-separated. components: comma-separated types (default: all)."
  BODY objects
  DOC "find_type: component type to find — populates paths automatically (replaces explicit paths)."
  DOC "fields: comma-separated field names to keep across all objects — projects the result to save tokens. full=True: bypass distillation. compress=True: strip default values before transfer."
  FLAG core
  VERB "Reading"
  ARG paths ostr DEFAULT None EXAMPLE "/Main Camera" "Comma-separated scene paths (e.g. '/Player,/Enemy,/Camera')"
  ARG components ostr DEFAULT None "Comma-separated component types to read (omit = all)"
  ARG fields ostr DEFAULT None "Comma-separated field names to project across all objects — reduces tokens"
  ARG full bool DEFAULT False LOCAL "Return raw uncompressed response (bypass distillation)"
  ARG compress bool DEFAULT False "Strip fields at their default value before TCP transfer — reduces response size"
  ARG find_type ostr DEFAULT None "Component type — auto-populates paths from all scene objects with this component"
  TAG async_full
  TAG read_cacheable
  TAG strip_defaults
  BLAST 0
END

TOOL inspect_uitk UITOOLKIT RO "Inspect the VisualElement tree of a UIDocument or PanelRenderer panel"
  BODY uitk
  DOC "(UI Toolkit only — use `get_component` for UIDocument component fields,"
  DOC "use `get_hierarchy` for the scene GameObject tree,"
  DOC "use `create_ui` for uGUI Canvas elements)."
  DOC "Returns compact text tree with ~N refids; pass ~N to uitk_element as selector."
  DOC "path: scene path to UIDocument or PanelRenderer GameObject (e.g. /HUD), or 'scene' to list all."
  DOC "depth: max traversal depth (default 4; use selector to focus a subtree)."
  DOC "selector: start tree from first matching element (name, .class, TypeName, ~refid)."
  DOC "filter: show only elements whose name or classes contain this substring."
  DOC "show_unity_private: show #unity-* prefixed elements normally hidden by default."
  DOC "show_style: include non-default computed style values per element."
  TIMEOUT 15.0
  ARG path ostr DEFAULT None EXAMPLE "/__seam_nonexistent"
  ARG depth oint DEFAULT None
  ARG selector ostr DEFAULT None
  ARG filter ostr DEFAULT None
  ARG show_unity_private obool DEFAULT None WIRE "include_internal"
  ARG show_style obool DEFAULT None
END

