# Wire seam: every non-LOCAL ARG of TOOL animation (dsl/tools.biome) is sent at least
# once, with a value that differs from the other case and from every other arg's values
# (server/tests/test_animation_plan_case_columns_distinct.py enforces the latter -- two
# columns with the same value sequence can silently bind to the wrong one, see
# Plans/Reviews/pilot-scratch/binder-repro/).
TEST "animation forwards every non-local arg with a distinguishing value" PROFILE editmode
    TESTCASE create action=create path="/A" clip=ClipA clip_name=ClipA2 property=localPosition keys="t:0 v:(1,2,3)" time=0 component_type=Transform binding_path=Root tangent=auto function_name=OnA int_param=1 float_param=0.5 string_param=sA
    TESTCASE edit action=edit path="/B" clip=ClipB clip_name=ClipB2 property=intensity keys="t:0 v:5" time=1 component_type=Light binding_path=ChildLight tangent=linear function_name=OnB int_param=2 float_param=1.5 string_param=sB

    FIXTURE tool
    call action=case.action path=case.path clip=case.clip clip_name=case.clip_name property=case.property keys=case.keys time=case.time component_type=case.component_type binding_path=case.binding_path tangent=case.tangent function_name=case.function_name int_param=case.int_param float_param=case.float_param string_param=case.string_param compact=true
    ASSERT tool.action == case.action
    ASSERT tool.path == case.path
    ASSERT tool.clip == case.clip
    ASSERT tool.clip_name == case.clip_name
    ASSERT tool.property == case.property
    ASSERT tool.keys == case.keys
    ASSERT tool.time == case.time
    ASSERT tool.component_type == case.component_type
    ASSERT tool.binding_path == case.binding_path
    ASSERT tool.tangent == case.tangent
    ASSERT tool.function_name == case.function_name
    ASSERT tool.int_param == case.int_param
    ASSERT tool.float_param == case.float_param
    ASSERT tool.string_param == case.string_param
    ASSERT tool.compact == "true"
END
