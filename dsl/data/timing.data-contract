  reloadBackoffS: number
  orphanCheckIntervalS: number
  busyTickS: number
  idleTickS: number
  probeGraceS: number
  hardDeadlineS: number
  reinstallTimeoutS: number
  updateCacheTtlS: number
  defaultCommandTimeoutS: number
  playModeCacheTtlS: number
  loginPathRetryTtlS: number
  focusHintAfterS: number
