INCLUDE common.defs
# Teleport stores method name as lastFirstArgument via state.Record(nameof(Teleport), ...)
INVOKE /Fixture/Actor FixtureMoveAdapter Teleport 1.0,2.0,3.0
ASSERT $last_first == Teleport
# MoveAsync stores method name as lastFirstArgument via success callback
INVOKE /Fixture/Actor FixtureMoveAdapter MoveAsync 5.0,0.0,0.0
ASSERT $last_first == MoveAsync
