.mcp-root {
    flex-direction: column;
    background-color: var(--unity-colors-window-background);
    padding: 18px;
    align-items: center;
    justify-content: flex-start;
}

.brand {
    font-size: 10px;
    color: var(--unity-colors-label-text);
    -unity-font-style: bold;
    margin-bottom: 14px;
    -unity-text-align: upper-center;
}

.orb-stage {
    width: 116px;
    height: 116px;
    position: relative;
    align-items: center;
    justify-content: center;
}

.orb-halo {
    position: absolute;
    width: 92px;
    height: 92px;
    border-radius: 46px;
    background-color: rgba(58, 210, 159, 0.04);
    border-width: 2px;
    opacity: 0.15;
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.orb {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    transition-property: background-color;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-out;
}

/* State fills — orb */
.orb--up      { background-color: #3ad29f; }
.orb--up.beat { background-color: #3ad29f; }

.orb--listen      { background-color: #e8a23a; }
.orb--listen.beat { background-color: #e8a23a; }

.orb--down { background-color: #e94560; }

/* Halo colors per state */
.halo--up {
    border-color: #54e8b5;
    background-color: rgba(84, 232, 181, 0.07);
}

.halo--listen {
    border-color: #e8a23a;
    background-color: rgba(232, 162, 58, 0.05);
}

.halo--down {
    border-color: #e94560;
    background-color: rgba(233, 69, 96, 0.04);
}

/* Beat classes */
.orb-halo.beat {
    border-width: 6px;
    opacity: 0.6;
}

.orb-halo.beat-soft {
    border-width: 3px;
    opacity: 0.35;
}

/* Status text */
.status-word {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 12px;
}

.status-word--up     { color: #3ad29f; }
.status-word--listen { color: #e8a23a; }
.status-word--down   { color: var(--unity-colors-error-text); }

.status-sub {
    font-size: 11px;
    -unity-font-style: italic;
    color: var(--unity-colors-label-text);
    margin-top: 2px;
}

/* Button row */
.btn-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

/* Strip custom paint — let native Unity button handle bg/border/color/hover */
.mcp-btn {
    margin: 3px;
}

.mcp-btn--primary {
    border-color: #3ad29f;
    background-color: rgba(58, 210, 159, 0.10);
}

.mcp-btn--danger {
    border-color: rgba(233, 69, 96, 0.65);
    color: #ff7187;
}

.mcp-maintenance {
    align-self: stretch;
    max-width: 360px;
    margin-top: 3px;
}

/* ── Ambient Overlay ── */
.status-ambient {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    overflow: hidden;
}

.status-scanline {
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background-color: rgba(58, 210, 159, 0.07);
    top: -2px;
}

.status-scanline--sweep {
    top: 100%;
}

.status-grid {
    position: absolute;
    top: 50%; left: 50%;
    translate: -50% -50%;
    width: 108px; height: 108px;
    flex-wrap: wrap;
    flex-direction: row;
    opacity: 0.06;
    transition-property: opacity;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}

.status-grid.conn-up     { opacity: 0.10; }
.status-grid.conn-listen { opacity: 0.06; }
.status-grid.conn-down   { opacity: 0.03; }

.status-grid-dot {
    width: 4px; height: 4px;
    margin: 11.5px;
    border-radius: 50%;
    background-color: #3ad29f;
}

.status-grid.conn-listen .status-grid-dot { background-color: #e8a23a; }
.status-grid.conn-down   .status-grid-dot { background-color: #6e2b3a; }

.status-sonar {
    position: absolute;
    top: 50%; left: 50%;
    translate: -50% -50%;
    width: 26px; height: 26px;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(58, 210, 159, 0.15);
    opacity: 0;
    scale: 1;
}

.status-sonar--ping {
    scale: 3;
    opacity: 0.4;
}

/* ── Connection list hierarchy (T7) ── */
.server-entry { margin-bottom: 4px; border-left-width: 2px;
    border-left-color: var(--unity-colors-default-border); padding-left: 4px; }
.server-header { flex-direction: row; align-items: center; min-height: 22px; }
.server-port { width: 52px; }
.server-port--this { -unity-font-style: bold; }
.server-status-badge { width: 56px; font-size: 10px; }
.server-pid { width: 90px; font-size: 10px; opacity: 0.75; }
.server-project { flex-grow: 1; font-size: 10px; -unity-font-style: italic; opacity: 0.65; }
.server-this-marker { font-size: 10px; -unity-font-style: bold-and-italic; margin-right: 4px; }
.connections-section { padding-left: 14px; margin-top: 2px; }
.connections-count { font-size: 10px; opacity: 0.65; margin-bottom: 2px; }
.connection-row { flex-direction: row; align-items: center; min-height: 20px; margin-bottom: 1px; }
.conn-kind { width: 88px; font-size: 11px; }
.conn-pid { width: 76px; font-size: 10px; opacity: 0.70; }
.conn-state { width: 52px; font-size: 10px; }
.conn-state--active { color: #3ad29f; }
.conn-state--idle { color: #e8a23a; }
.conn-state--dormant { color: #888888; }
.conn-idle { width: 60px; font-size: 10px; opacity: 0.70; }
.conn-duration { width: 90px; font-size: 10px; opacity: 0.60; }
.dormant-section { margin-top: 4px; }
.dormant-header { font-size: 10px; opacity: 0.55; margin-bottom: 2px; }
.batch-actions { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
