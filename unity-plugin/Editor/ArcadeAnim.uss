/* ── Fade ─────────────────────────────────────────────────────────────────── */

.arcade-fade-hidden {
    opacity: 0;
    translate: 0 8px;
}

.arcade-fade-visible {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* ── Slide ────────────────────────────────────────────────────────────────── */

.arcade-slide-hidden {
    translate: 20px 0;
    opacity: 0;
}

.arcade-slide-visible {
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* ── Pulse ────────────────────────────────────────────────────────────────── */

.arcade-pulse {
    scale: 1.02;
    transition-property: scale, border-color;
    transition-duration: 0.22s;
}

/* ── Neon Glow ────────────────────────────────────────────────────────────── */

.arcade-glow {
    border-width: 1px;
    transition-property: border-color, border-width;
    transition-duration: 0.3s;
}

.arcade-glow.conn-up     { border-color: #3ad29f; }
.arcade-glow.conn-listen { border-color: #e8a23a; }
.arcade-glow.conn-down   { border-color: #6e2b3a; }

.arcade-grid-bg {
    opacity: 0.08;
}

/* ── Score Flash ──────────────────────────────────────────────────────────── */

.arcade-score-flash {
    color: #3ad29f;
    transition-property: color;
    transition-duration: 0.2s;
}
