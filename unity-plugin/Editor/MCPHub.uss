.hub-root {
    flex-direction: column;
    padding: 12px;
    background-color: var(--unity-colors-window-background);
}

/* Shared Biome components. Unity theme variables remain the source of truth. */
.biome-button {
    min-height: 24px;
    min-width: 72px;
    padding: 3px 10px;
    font-size: 11px;
}

.biome-button--primary {
    border-color: #3ad29f;
    background-color: rgba(58, 210, 159, 0.10);
}

.biome-button--primary:hover,
.biome-button--primary:focus {
    border-color: #54e8b5;
    background-color: rgba(58, 210, 159, 0.18);
}

.biome-button--secondary {
    border-color: var(--unity-colors-default-border);
}

.biome-button--quiet {
    min-width: 44px;
    opacity: 0.85;
}

.biome-button:disabled {
    opacity: 0.45;
}

.biome-section {
    margin: 4px 0 8px 0;
}

.biome-section__title {
    font-size: 12px;
    -unity-font-style: bold;
    margin: 2px 4px 5px 4px;
}

.biome-section__body {
    flex-direction: column;
}

.biome-status {
    min-height: 20px;
    padding: 3px 6px;
    margin: 3px 0;
    border-left-width: 2px;
    border-left-color: var(--unity-colors-default-border);
    color: var(--unity-colors-label-text);
    font-size: 10px;
    white-space: normal;
}

.biome-status--success { border-left-color: #3ad29f; }
.biome-status--warning { border-left-color: #e8a23a; }
.biome-status--error   { border-left-color: #e94560; }

.biome-page-scroll {
    flex-grow: 1;
}

.biome-page {
    flex-grow: 1;
    min-width: 0;
}

.biome-page-content {
    padding: 0 4px 10px 4px;
}

.biome-form-row {
    margin: 3px 0;
}

.biome-form-row--inline {
    flex-direction: row;
    align-items: center;
}

/* Event-only arcade particle burst */
.biome-particle-host {
    position: relative;
}

.biome-particles {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.biome-particle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 1px;
    opacity: 0;
    transition-property: translate, rotate, scale, opacity;
    transition-duration: 0.48s;
    transition-timing-function: ease-out;
}

.biome-particle--reset {
    transition-duration: 0s;
}

.biome-particle--success { background-color: #3ad29f; }
.biome-particle--warning { background-color: #e8a23a; }
.biome-particle--accent  { background-color: #e94560; }

/* Pooled ambient "Biome spores". The owning header scheduler pauses on detach. */
.biome-ambient-host {
    position: relative;
    overflow: hidden;
}

.biome-ambient-particles {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.biome-ambient-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #3ad29f;
    transition-property: background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.biome-ambient-particle--secondary {
    width: 3px;
    height: 3px;
    background-color: #e8a23a;
}

.biome-ambient-particle--hot {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background-color: #54e8b5;
}

.biome-ambient--tools .biome-ambient-particle--hot,
.biome-ambient--updates .biome-ambient-particle--hot {
    background-color: #62f2bd;
}

.biome-ambient--chat .biome-ambient-particle--secondary,
.biome-ambient--shield .biome-ambient-particle--secondary {
    background-color: #54e8b5;
}

.biome-ambient-particles.conn-listen .biome-ambient-particle--primary {
    background-color: #e8a23a;
}

.biome-ambient-particles.conn-down .biome-ambient-particle {
    background-color: #e94560;
}

/* General settings section */
.hub-section {
    margin-bottom: 6px;
}

.hub-port-restart-warning {
    margin: 4px 0 2px 0;
}

.hub-port-restart-btn {
    margin: 4px 0 2px 0;
}

.hub-port-label {
    font-size: 10px;
    color: var(--unity-colors-label-text);
    margin-top: 2px;
    margin-bottom: 4px;
}

/* Card buttons */
.hub-card {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin: 4px 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
    cursor: link;
    min-height: 52px;
    white-space: normal;
}

.hub-card:hover,
.hub-card:focus {
    border-color: #3ad29f;
    background-color: rgba(58, 210, 159, 0.06);
}

.hub-card-icon {
    font-size: 20px;
    width: 32px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.hub-card-col {
    flex-direction: column;
    flex-grow: 1;
}

.hub-card-title {
    font-size: 12px;
    -unity-font-style: bold;
}

.hub-card-subtitle {
    font-size: 10px;
    opacity: 0.7;
    margin-top: 1px;
}

.hub-card-chevron {
    width: 20px;
    -unity-text-align: middle-center;
    opacity: 0.5;
    font-size: 14px;
}

/* Heartbeat divider */
.hub-divider {
    flex-direction: row;
    align-items: center;
    margin: 10px 0;
    height: 12px;
}

.hub-divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--unity-colors-default-border);
}

.hub-divider-spike {
    width: 10px;
    height: 10px;
    margin: 0 6px;
    background-color: var(--unity-colors-default-border);
    border-radius: 2px;
    opacity: 0.3;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.hub-divider-spike.beat {
    opacity: 0.9;
}

.hub-divider-spike.beat-up     { background-color: #3ad29f; }
.hub-divider-spike.beat-listen { background-color: #e8a23a; }
.hub-divider-spike.beat-down   { background-color: #6e2b3a; }

/* === Tools: toggle switch row === */
.anim-tools {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 58px;
    margin: 6px 0;
    position: relative;
}
.toggle-track {
    width: 28px; height: 14px; border-radius: 7px;
    border-width: 1px; border-color: var(--unity-colors-default-border);
    background-color: rgba(0,0,0,0.12);
    margin: 0 4px;
    flex-direction: row; align-items: center;
    transition-property: border-color, background-color;
    transition-duration: 0.28s;
}
.toggle-knob {
    width: 10px; height: 10px; border-radius: 5px;
    margin-left: 1px;
    background-color: var(--unity-colors-default-border);
    transition-property: translate, background-color;
    transition-duration: 0.32s;
}
.toggle-knob.on        { translate: 14px 0; }
.toggle-track--scan {
    scale: 1.12;
    border-color: #54e8b5;
    background-color: rgba(58,210,159,0.12);
}
.toggle-knob--pulse { scale: 1.28; }
.toggle-knob.conn-up   { background-color: #3ad29f; }
.toggle-knob.conn-listen { background-color: #e8a23a; }
.toggle-knob.conn-down { background-color: #e94560; }

/* === Permissions: shield + lock === */
.shield-root { flex-direction: row; align-items: center; margin: 10px 0; height: 64px; position: relative; }
.shield-line { flex-grow: 1; height: 1px; background-color: var(--unity-colors-default-border); }
.shield-hub  { width: 48px; height: 48px; position: relative; margin: 0 8px; }
.shield-body {
    width: 36px; height: 38px; position: absolute; left: 6px; top: 5px;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
    background-color: transparent; border-width: 2px;
    opacity: 0.5;
    transition-property: border-color; transition-duration: 0.34s;
}
.shield-body--pulse { opacity: 1.0; scale: 1.06; }
.shield--up     { border-color: #3ad29f; }
.shield--listen { border-color: #e8a23a; }
.shield--down   { border-color: #e94560; }
.lock-shackle {
    width: 10px; height: 7px; position: absolute; left: 19px; top: 12px;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-width: 2px; border-bottom-width: 0;
    background-color: transparent; opacity: 0.7;
    transition-property: opacity, top, border-color; transition-duration: 0.3s;
}
.lock-shackle--up { top: 9px; opacity: 1.0; }
.lock-bar {
    width: 14px; height: 10px; position: absolute; left: 17px; top: 18px;
    border-radius: 2px;
    transition-property: background-color; transition-duration: 0.5s;
}
.lock-bar--up     { background-color: #3ad29f; }
.lock-bar--listen { background-color: #e8a23a; }
.lock-bar--down   { background-color: #e94560; }
.lock-dot {
    width: 4px; height: 4px; position: absolute; left: 22px; top: 21px;
    border-radius: 50%;
    background-color: var(--unity-colors-window-background);
}

.shield-scan {
    width: 2px;
    height: 32px;
    position: absolute;
    left: 8px;
    top: 8px;
    opacity: 0.2;
    background-color: #3ad29f;
    transition-property: background-color;
    transition-duration: 0.34s;
    transition-timing-function: ease-in-out;
}

.shield-scan--bright { opacity: 0.9; }
.shield-scan.conn-listen { background-color: #e8a23a; }
.shield-scan.conn-down { background-color: #e94560; }

/* === Chat: WiFi arc pulse === */
.wave-root { flex-direction: row; align-items: center; margin: 8px 0; height: 68px; position: relative; }
.wave-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--unity-colors-default-border);
    opacity: 0.65;
    transition-property: background-color;
    transition-duration: 0.3s;
}
.wave-line.wave--up { background-color: #3ad29f; opacity: 0.65; }
.wave-line.wave--listen { background-color: #e8a23a; opacity: 0.7; }
.wave-line.wave--down { background-color: #e94560; opacity: 0.55; }
.wave-hub  { width: 54px; height: 54px; position: relative; margin: 0 10px; }
.wave-arc {
    border-radius: 50%; background-color: transparent;
    border-width: 2px; position: absolute;
    opacity: 0.28;
    scale: 0.94;
    transition-property: border-color;
    transition-duration: 0.28s;
    transition-timing-function: ease-in-out;
}
.wave-arc--echo { opacity: 0.58; scale: 1.02; }
.wave-arc--lit { opacity: 1; scale: 1.14; }
.wave-arc-1 { width: 22px; height: 22px; top: 16px; left: 16px; }
.wave-arc-2 { width: 36px; height: 36px; top: 9px; left: 9px; }
.wave-arc-3 { width: 50px; height: 50px; top: 2px; left: 2px; }
.wave--up     { border-color: #3ad29f; }
.wave--listen { border-color: #e8a23a; }
.wave--down   { border-color: #e94560; }
.wave-dot {
    width: 8px; height: 8px; border-radius: 50%;
    position: absolute; top: 23px; left: 23px;
    opacity: 0.9;
    transition-property: background-color;
    transition-duration: 0.28s;
}
.wave-dot--pulse { scale: 1.55; opacity: 1; }
.wave-dot--up     { background-color: #3ad29f; }
.wave-dot--listen { background-color: #e8a23a; }
.wave-dot--down   { background-color: #e94560; }

.wave-orbit {
    width: 54px;
    height: 54px;
    position: absolute;
    left: 0;
    top: 0;
}

.wave-orbit-dot {
    width: 5px;
    height: 5px;
    position: absolute;
    left: 24px;
    top: -1px;
    border-radius: 3px;
    background-color: #e8a23a;
    opacity: 0.85;
}

.wave-orbit.conn-up .wave-orbit-dot { background-color: #3ad29f; }
.wave-orbit.conn-down .wave-orbit-dot { background-color: #e94560; }

/* === Hub Header Animation (F25-alt) === */

.hub-anim-root {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 8px;
    position: relative;
}

.han-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--unity-colors-default-border);
    opacity: 0.5;
    transition-property: background-color, opacity;
    transition-duration: 0.4s;
}
.han-line.han--up     { background-color: #3ad29f; opacity: 0.4; }
.han-line.han--listen { background-color: #e8a23a; opacity: 0.4; }
.han-line.han--down   { background-color: #6e2b3a; opacity: 0.4; }

.han-node {
    border-radius: 50%;
    background-color: transparent;
    border-width: 1.5px;
    border-color: var(--unity-colors-default-border);
    opacity: 0.4;
    transition-property: border-color, opacity, background-color;
    transition-duration: 0.35s;
    flex-shrink: 0;
}
.han-node--sm { width: 8px;  height: 8px; }
.han-node--md { width: 12px; height: 12px; }

.han-node.han--up     { border-color: #3ad29f; opacity: 0.75; }
.han-node.han--listen { border-color: #e8a23a; opacity: 0.75; }
.han-node.han--down   { border-color: #e94560; opacity: 0.6; }
.han-node--hot {
    scale: 1.3;
    opacity: 1;
    background-color: rgba(232,162,58,0.20);
}

.han-hub {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--unity-colors-default-border);
    background-color: rgba(0,0,0,0.0);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.55;
    transition-property: border-color, background-color, opacity;
    transition-duration: 0.4s;
}
.han-hub--pulse { opacity: 1.0; }
.han-hub.han--up     { border-color: #3ad29f; background-color: rgba(58,210,159,0.08); }
.han-hub.han--listen { border-color: #e8a23a; background-color: rgba(232,162,58,0.08); }
.han-hub.han--down   { border-color: #e94560; background-color: rgba(233,69,96,0.08); }

.han-status {
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--unity-colors-label-text);
    transition-property: color;
    transition-duration: 0.4s;
    width: 40px;
}
.han-status.han--up     { color: #3ad29f; }
.han-status.han--listen { color: #e8a23a; }
.han-status.han--down   { color: #e94560; }

.han-packet {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    position: absolute;
    top: 25px;
    left: 0;
    background-color: var(--unity-colors-default-border);
    opacity: 0.3;
    transition-property: background-color;
    transition-duration: 0.3s;
}
.han-packet--bright { opacity: 1.0; }
.han-packet.han--up     { background-color: #3ad29f; }
.han-packet.han--listen { background-color: #e8a23a; }
.han-packet.han--down   { background-color: #e94560; }

/* === Settings Navigation === */
.nav-viewport {
    flex-grow: 1;
    overflow: hidden;
}

.nav-container {
    flex-direction: row;
    width: 200%;
    height: 100%;
    transition-property: translate;
    transition-duration: 280ms;
}

.nav-no-transition {
    transition-duration: 0ms;
}

.nav-slot {
    width: 50%;
    height: 100%;
}

.nav-page {
    flex-grow: 1;
    padding: 8px;
}

.nav-back-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.nav-back-btn {
    font-size: 11px;
    padding: 2px 8px;
    margin-right: 8px;
}

.nav-back-title {
    font-size: 14px;
    -unity-font-style: bold;
}

/* === Sampling form === */
.sampling-row {
    margin: 4px 0;
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.sampling-label {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

/* ── Sampling Frequency Analyzer ── */
.freq-root {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    height: 58px;
    padding: 4px 0;
    margin-bottom: 8px;
}

.freq-bar {
    width: 6px;
    height: 36px;
    border-radius: 2px;
    margin: 0 2px;
    background-color: #3ad29f;
    transform-origin: center bottom;
    transition-property: background-color;
    transition-duration: 0.3s;
    opacity: 0.68;
}

.freq-bar--peak { opacity: 1; }
.freq-bar.conn-up     { background-color: #3ad29f; }
.freq-bar.conn-listen { background-color: #e8a23a; }
.freq-bar.conn-down   { background-color: #e94560; }

/* ── Hub Card Press ── */
.hub-card:active {
    scale: 0.97;
    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

/* ── Updates: ascending bars (upload/rocket) ── */
.anim-updates {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    height: 58px;
    margin: 6px 0;
    position: relative;
}

.upload-bar {
    width: 8px;
    height: 36px;
    border-radius: 2px;
    margin: 0 3px;
    background-color: var(--unity-colors-default-border);
    transform-origin: center bottom;
    transition-property: background-color;
    transition-duration: 0.3s;
    opacity: 0.58;
}

.upload-bar--active { opacity: 1.0; scale: 1.08; }

.upload-bar.conn-up     { background-color: #3ad29f; }
.upload-bar.conn-listen { background-color: #e8a23a; }
.upload-bar.conn-down   { background-color: #e94560; }

.levelup-symbol {
    width: 48px;
    height: 58px;
    position: absolute;
    left: 50%;
    top: 0;
    margin-left: -24px;
}

.levelup-aura {
    position: absolute;
    border-radius: 50%;
    background-color: rgba(84, 232, 181, 0.18);
}

.levelup-aura--outer {
    width: 46px;
    height: 46px;
    left: 1px;
    top: 7px;
    background-color: rgba(58, 210, 159, 0.08);
}

.levelup-aura--inner {
    width: 32px;
    height: 32px;
    left: 8px;
    top: 14px;
}

.levelup-arrow {
    width: 48px;
    height: 44px;
    position: absolute;
    left: 0;
    top: 7px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #62f2bd;
}

.levelup-symbol.conn-listen .levelup-arrow { color: #e8a23a; }
.levelup-symbol.conn-listen .levelup-aura { background-color: rgba(232, 162, 58, 0.18); }
.levelup-symbol.conn-down .levelup-arrow { color: #e94560; }
.levelup-symbol.conn-down .levelup-aura { background-color: rgba(233, 69, 96, 0.16); }

/* ── Updates Changelog ── */
.updates-entry-newer {
    border-left-width: 2px;
    border-left-color: #3ad29f;
    padding-left: 6px;
    transition-property: border-left-color;
    transition-duration: 1s;
    transition-timing-function: ease-in-out;
}

.updates-banner-slot {
    margin: 2px 0 6px 0;
}

.updates-check-btn {
    min-height: 26px;
    margin: 4px 0 8px 0;
    border-color: #3ad29f;
}

.updates-changelog {
    margin-top: 4px;
}

.updates-entry-body {
    white-space: normal;
    opacity: 0.85;
    margin: 2px 0 7px 0;
}

.plugin-settings-card {
    margin: 4px 0;
    padding: 6px 8px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 4px;
}

.plugin-settings-description {
    font-size: 10px;
    opacity: 0.72;
    white-space: normal;
    margin: 2px 0 6px 0;
}

/* ── Ecosystem / release history header ── */
.eco-root {
    height: 58px;
    flex-direction: row;
    align-items: center;
    margin: 3px 0 7px 0;
}

.eco-line {
    height: 1px;
    flex-grow: 1;
    background-color: var(--unity-colors-default-border);
}

.eco-nodes {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
}

.eco-node {
    width: 10px;
    height: 10px;
    margin: 0 3px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
    transition-property: border-color, background-color, opacity;
    transition-duration: 0.22s;
    opacity: 0.45;
}

.eco-node--active {
    border-color: #3ad29f;
    background-color: rgba(58, 210, 159, 0.12);
    opacity: 0.9;
}

.eco-node--pulse,
.eco-node--selected {
    scale: 1.35;
    border-color: #e8a23a;
    background-color: rgba(232, 162, 58, 0.16);
    opacity: 1;
}

.eco-node--scan {
    scale: 1.18;
    border-color: #54e8b5;
    opacity: 1;
}

.eco-root--versions .eco-node {
    border-radius: 2px;
}
