/* CTA card — pulsing border */
.lvlup-cta {
    position: relative;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(58, 210, 159, 0.3);
    padding: 16px;
    margin: 6px 0;
    transition-property: border-color, background-color;
    transition-duration: 0.4s;
}

.lvlup-button-row {
    flex-direction: row;
}

.lvlup-button-row > * {
    margin-right: 6px;
}
.lvlup-cta-pulse {
    border-color: #3ad29f;
    background-color: rgba(58, 210, 159, 0.06);
}

/* Labels */
.lvlup-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    margin-bottom: 4px;
    padding-right: 54px;
}
.lvlup-subtitle {
    font-size: 12px;
    color: var(--unity-colors-label-text-secondary);
    margin-bottom: 12px;
}
.lvlup-badge {
    font-size: 13px;
    color: #3ad29f;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

/* Anim root — needs relative for spark container */
.lvlup-anim-root {
    position: relative;
    min-height: 74px;
}

/* Layered aura approximates a compact blur without a render texture. */
.lvlup-symbol {
    position: absolute;
    width: 52px;
    height: 56px;
}

.lvlup-idle-signal {
    right: 10px;
    top: 8px;
}

.lvlup-lift-symbol {
    right: 4px;
    top: 7px;
}

.lvlup-symbol-aura {
    position: absolute;
    border-radius: 50%;
    background-color: rgba(84, 232, 181, 0.20);
}

.lvlup-symbol-aura--outer {
    width: 50px;
    height: 50px;
    left: 1px;
    top: 3px;
    background-color: rgba(58, 210, 159, 0.08);
}

.lvlup-symbol-aura--inner {
    width: 34px;
    height: 34px;
    left: 9px;
    top: 11px;
}

.lvlup-symbol-arrow {
    position: absolute;
    width: 52px;
    height: 44px;
    left: 0;
    top: 7px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #62f2bd;
}

/* Version label */
.lvlup-version {
    font-size: 14px;
    color: var(--unity-colors-label-text);
    transition-property: color, font-size;
    transition-duration: 0.25s;
    margin-bottom: 8px;
}
.lvlup-version-flash {
    color: #3ad29f;
    font-size: 16px;
}

/* XP bar track */
.lvlup-xp-track {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin: 12px 0;
    overflow: hidden;
}
.lvlup-xp-fill {
    height: 8px;
    border-radius: 4px;
    background-color: #3ad29f;
    width: 100%;
    scale: 0 1;
    transform-origin: left center;
    transition-property: background-color;
    transition-duration: 0.3s;
}
.lvlup-xp-fill--done {
    background-color: #a8f0d8;
}

/* Sparkles */
.lvlup-spark-container {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.lvlup-spark {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #3ad29f;
    opacity: 0;
}

.lvlup-spark--visible {
    opacity: 0.9;
    scale: 1.35;
}

.lvlup-spark--pos-1 { left: 12%; top: 62%; }
.lvlup-spark--pos-2 { left: 31%; top: 20%; background-color: #a8f0d8; }
.lvlup-spark--pos-3 { left: 49%; top: 72%; }
.lvlup-spark--pos-4 { left: 70%; top: 28%; background-color: #a8f0d8; }
.lvlup-spark--pos-5 { left: 88%; top: 55%; }

/* Diff panel */
.lvlup-diff-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    margin-bottom: 6px;
}
.lvlup-diff-section-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text-secondary);
    margin-top: 10px;
    margin-bottom: 4px;
}
.lvlup-diff-bullet {
    font-size: 11px;
    padding-left: 8px;
    margin: 2px 0;
    white-space: normal;
}
