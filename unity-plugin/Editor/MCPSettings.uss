/* Unity MCP Settings — UIToolkit stylesheet */

/* ── Animated header banner ── */
.mcp-header {
    background-color: var(--unity-colors-window-background);
    border-radius: 6px;
    padding: 14px 16px;
    margin: 4px 4px 8px 4px;
    overflow: hidden;
    /* Accent bar via bottom-border animation */
    border-bottom-width: 3px;
    border-bottom-color: var(--unity-colors-default-border);
    transition-property: border-bottom-color;
    transition-duration: 1.2s;
}

.mcp-header:hover {
    /* Decorative hover accent — intentional brand colour, not a state */
    border-bottom-color: #e94560;
}

.mcp-header-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    -unity-text-align: upper-left;
    opacity: 1;
    /* transition for engines that support it (Unity 2022+), silently ignored in 2021 */
    transition-property: opacity;
    transition-duration: 0.4s;
}

/* ── Presets row ── */
.preset-row {
    flex-direction: row;
    margin: 4px 4px;
    justify-content: flex-start;
}

/* Strip custom paint — let native Unity button handle bg/border/color/hover */
.preset-btn {
    margin-right: 6px;
    padding: 3px 10px;
    font-size: 11px;
    min-height: 24px;
}

/* ── Info label ── */
.info-label {
    color: var(--unity-colors-label-text);
    font-size: 10px;
    margin: 2px 6px 4px 6px;
    -unity-font-style: italic;
    opacity: 0.7;
}

/* ── Search field ── */
.search-field {
    margin: 4px 4px 6px 4px;
}

/* ── Scroll area ── */
.tool-scroll {
    flex-grow: 1;
    margin: 0 2px;
}

.permission-content {
    flex-grow: 1;
}

/* ── Category foldout ── */
.category-foldout {
    margin: 2px 0;
    border-left-width: 2px;
    border-left-color: var(--unity-colors-default-border);
    padding-left: 4px;
}

.category-header {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.category-disclosure {
    flex-grow: 1;
    -unity-text-align: middle-left;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin: 0;
    padding: 3px 5px;
    font-size: 11px;
}

.category-disclosure:hover,
.category-disclosure:focus {
    background-color: rgba(128, 128, 128, 0.10);
}

.category-content {
    flex-direction: column;
}

/* ── Tool row ── */
.tool-row {
    flex-direction: row;
    padding: 1px 4px 1px 20px;
}

.tool-toggle {
    flex-grow: 1;
    font-size: 11px;
    color: var(--unity-colors-label-text);
}

/* ── Master toggle ── */
.master-toggle {
    margin-right: 6px;
    flex-shrink: 0;
}

/* Mixed/indeterminate state indicator — intentional accent colour */
.toggle-mixed > .unity-toggle__checkmark {
    background-color: #6666aa;
    opacity: 0.6;
}

/* ── Option row (auto-discard) ── */
.option-row {
    margin: 4px 4px;
    padding: 2px 4px;
}

/* ── Sampling cards ── */
.sampling-card {
    margin: 3px 4px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 4px;
    padding: 2px 6px;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.sampling-card:hover {
    border-color: #3a9a3a;
}

.sampling-card-body {
    padding: 4px 2px;
}

.sampling-inline-row {
    flex-direction: row;
    margin-bottom: 3px;
}

.sampling-inline-row > * {
    flex: 1;
    margin-right: 4px;
}


.sampling-backend-dd,
.sampling-model-dd {
    min-width: 100px;
    font-size: 11px;
}

.sampling-int-field,
.sampling-float-field {
    min-width: 70px;
    font-size: 11px;
}

/* 200ms orange flash when backend changes */
.model-changed-flash {
    border-color: #e07020;
    border-width: 1px;
    transition-property: border-color;
    transition-duration: 0.2s;
}

/* ── Plugins section ── */
.plugin-section {
    margin-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    padding-top: 6px;
    padding-left: 12px;
}

.plugin-section-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    margin-bottom: 4px;
}

/* ── Chat settings ── */
.chat-settings {
    padding: 2px 4px 10px 4px;
}

.chat-settings-foldout {
    margin: 4px 0;
    padding: 4px 6px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 4px;
}

.chat-form-field {
    margin: 3px 0;
    min-height: 20px;
}

.chat-hint,
.chat-warning {
    font-size: 10px;
    white-space: normal;
    margin: 2px 0 4px 0;
    opacity: 0.78;
}

.chat-hint--success { color: #3ad29f; }
.chat-hint--warning,
.chat-warning { color: #e8a23a; }
.chat-hint--error { color: #e94560; }

.settings-section-header {
    font-size: 11px;
    -unity-font-style: bold;
    margin: 5px 0 3px 0;
}

.chat-separator {
    height: 1px;
    margin: 5px 0;
    background-color: var(--unity-colors-default-border);
}

.chip-config-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    min-height: 25px;
    margin: 2px 0;
}

.chip-config-label {
    min-width: 86px;
    flex-grow: 1;
    font-size: 11px;
}

.chip-config-depth {
    min-width: 78px;
    flex-grow: 1;
}

.chip-config-color {
    width: 54px;
    margin-left: 4px;
}

.chip-config-reset {
    min-width: 50px;
    margin-left: 4px;
    font-size: 9px;
}

.model-preset-row {
    flex-direction: row;
    margin-bottom: 2px;
    padding: 2px 4px;
}

.model-preset-id {
    flex-grow: 1;
    margin-left: 4px;
}

.model-preset-ctx {
    width: 100px;
    margin-left: 4px;
}

.mcp-btn--inline {
    padding-left: 6px;
    padding-right: 6px;
    font-size: 10px;
    min-height: 16px;
    margin: 1px 0;
}
