<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure dotnet-test lane for the decisions that biome-dsl prints from dsl/decisions (step 7.2). No Unity install: the generated
    files under Editor/Generated depend on nothing but the BCL, and are compiled here at LangVersion 9 (the C# of Unity 6) with
    warnings as errors. The `Tests~` folder name is load-bearing: Unity's importer skips a path that ends in `~`.
    The rows are the machine rows of the examples (dsl/decisions/<module>.json, printed by `biome logic examples`, never authored);
    they are copied next to the test assembly under rows/.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>UnityMCP.Decisions.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Relative to this file's own directory (unity-plugin/Tests~/Decisions/). -->
    <Compile Include="../../Editor/Generated/*.g.cs" />
    <!-- ToolBindings.g.cs binds CommandRegistry.Register(name, CommandRouter.ExecXxx, ...): CommandRouter.cs and the
         helpers it calls (MaterialHelper, ColliderFitHelper, ...) need UnityEditor/UnityEngine, so it is the one
         generated file this pure (no-Unity) lane cannot compile; excluded rather than dragging those in. -->
    <Compile Remove="../../Editor/Generated/ToolBindings.g.cs" />
    <!-- ToolDispatch.g.cs prints a partial class per DISPATCH tool (e.g. PrefabHelper) calling its own arm
         methods, which need UnityEditor/UnityEngine (AssetDatabase, PrefabUtility, ...) like ToolBindings.g.cs
         above; excluded for the same reason (dsl-bottlenecks-2026-11 S3). -->
    <Compile Remove="../../Editor/Generated/ToolDispatch.g.cs" />
    <!-- the real files under test; the Unity-only symbols they touch are in UnityStubs.cs -->
    <Compile Include="../../Editor/CommandRegistry.cs" />
    <Compile Include="../../Editor/CommandOptions.cs" />
    <Compile Include="../../Editor/JsonHelper.cs" />
    <!-- Wire.cs: the pure wire-encoding helpers WireRecords.g.cs calls (w_int/w_float1/w_bool/...); no UnityEngine/UnityEditor dependency. -->
    <Compile Include="../../Editor/Wire.cs" />
    <Compile Include="../../Editor/Decisions/*.cs" />
    <None Include="../../../dsl/decisions/*.json" Link="rows/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- the tool catalog source (dsl/tools.biome): ToolArgsAccessorTests derives its expected (tool, arg) set from this, never a hand list -->
    <None Include="../../../dsl/tools.biome" Link="tools.biome" CopyToOutputDirectory="PreserveNewest" />
    <!-- the read actions of the commands as ACTION_READS stated them before the catalog printed them (the oracle of test_action_reads_golden.py) -->
    <None Include="../../../server/tests/golden/decisions/action_reads.txt" Link="rows/action_reads.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- the wire calls of the is_write golden of the hand-written Python function (test_is_write_golden.py), with the registry state they were answered under -->
    <None Include="../../../server/tests/golden/decisions/is_write_wire.txt" Link="rows/is_write_wire.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- the reports of the verdict golden of the hand-written playtest verdict (test_verdict_golden.py), as inputs of PlaytestOracleTests -->
    <None Include="../../../server/tests/golden/decisions/verdict_reports.txt" Link="rows/verdict_reports.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
