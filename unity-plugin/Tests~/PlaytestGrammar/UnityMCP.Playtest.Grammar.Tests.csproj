<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure dotnet-test lane for the table of the playtest grammar (step 7.5 D1), next to Tests~/Pure. No Unity install: the file that biome-dsl prints from
    dsl/constructs/playtest.construct (Runtime/Playtest/Core/Generated/PlaytestGrammar.g.cs) is compiled alone at LangVersion 9 (the C# of Unity 6) with
    warnings as errors and with no reference to Unity, as its assembly UnityMCP.Playtest.Core (noEngineReferences) is: a use of UnityEngine or of a later
    C# in the printer fails this build. The tests state what the table must hold, written from the requirements and not from the printer.
    The `Tests~` folder name is load-bearing: Unity's importer skips a path that ends in `~`.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>UnityMCP.Playtest.Core.GrammarTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Relative to this file's own directory (unity-plugin/Tests~/PlaytestGrammar/). -->
    <Compile Include="../../Runtime/Playtest/Core/Generated/*.cs" />
    <Compile Include="PlaytestGrammarTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
