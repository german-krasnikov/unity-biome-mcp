<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure dotnet-test lane for the table of the playtest grammar and the front of the reader that matches a line against it (step 7.5 D1, H0, H1, R7), next to
    Tests~/Pure. No Unity install: the one file that biome-dsl prints from dsl/constructs/playtest.construct (Runtime/Playtest/Core/Generated/PlaytestReader.g.cs:
    the table of forms, the tokens, the matcher, the diagnostic and the reader of a command) is compiled alone, nothing else of Core (PlaytestStep and
    PlaytestParser are not in this build, so a use of them fails it with CS0246), at LangVersion 9 (the C# of Unity 6) with warnings as errors and with no
    reference to Unity, as its assembly UnityMCP.Playtest.Core (noEngineReferences) is: a use of UnityEngine or of a later C# fails this build.
    The tests state what the table and the front must hold, written from the requirements and not from the code.
    The `Tests~` folder name is load-bearing: Unity's importer skips a path that ends in `~`.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>UnityMCP.Playtest.Core.GrammarTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Relative to this file's own directory (unity-plugin/Tests~/PlaytestGrammar/). -->
    <Compile Include="../../Runtime/Playtest/Core/Generated/*.cs" />
    <!-- RepoRoot and the reader of the examples files: the data that this lane and the reader in JavaScript are both held to. -->
    <Compile Include="../PlaytestShared/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
